{
  "name": "astro-cloudflare",
  "version": "1.0.0",
  "private": true,
  "description": "Multilingual marketing + blog + docs starter with Astro and Cloudflare Pages",
  "license": "MIT",
  "packageManager": "pnpm@8.15.0",
  "type": "module",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "8.15.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run type-check && pnpm run check:kpis && pnpm run check:geo && pnpm run check:procurement && pnpm run validate:registry && pnpm run check:imports && pnpm run check:unique && pnpm run check:mojibake && pnpm run sync:i18n && pnpm run validate:i18n && pnpm run check:content-density && pnpm run validate:secrets",
    "lint:js": "eslint . --ignore-pattern dist --ignore-pattern .astro --ignore-pattern .wrangler --ignore-pattern node_modules --ignore-pattern \"src/components/layout/Analytics.astro\"",
    "lint:css": "stylelint src/styles/",
    "check:kpis": "node scripts/check-kpis.mjs",
    "check:geo": "node scripts/check-geo.mjs",
    "check:render": "node scripts/render-gate.mjs",
    "check:procurement": "node scripts/check-procurement.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:unique": "node scripts/check-unique.mjs",
    "sync:i18n": "node scripts/sync-i18n-keys.mjs",
    "sync": "astro sync",
    "type-check": "astro sync && astro check",
    "typecheck": "astro sync && astro check && tsc --noEmit",
    "ci:typecheck": "astro sync && astro check",
    "format": "prettier --write 'src/**/*.{astro,ts,tsx,css}'",
    "format:check": "prettier --check 'src/**/*.{astro,ts,tsx,css}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:i18n": "node scripts/validate-i18n.js",
    "validate:secrets": "node scripts/validate-secrets.cjs",
    "postbuild": "node scripts/generate-media-manifest.cjs",
    "generate": "node knowledge-generator/run.mjs",
    "translate": "node scripts/translate.mjs",
    "audit:page": "node scripts/audit/index.mjs audit:page",
    "audit:site": "node scripts/audit/index.mjs audit:site",
    "audit:density-matrix": "node scripts/audit/density-matrix.mjs --write",
    "check:content-density": "node scripts/audit/density-matrix.mjs --write",
    "build:skip-pagefind": "node scripts/build-no-pagefind.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource-variable/outfit": "^5.2.0",
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/simple-icons": "^1.2.89",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.7",
    "astro-icon": "^1.1.5",
    "clsx": "^2.1.1",
    "cva": "1.0.0-beta.6",
    "react": "19",
    "react-dom": "19",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/starlight": "^0.41.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.53.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "astro-eslint-parser": "^3.0.0",
    "cheerio": "^1.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.0.0",
    "glob": "^13.0.6",
    "globals": "^16.0.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "stylelint": "^17.14.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
