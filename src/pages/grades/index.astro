---
import EntityPillar from "../_shared/_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildPillarGraph } from "../../lib/schema";
import { siteConfig } from "../../config/site.config";
const locale = "en";
const entries = (await getCollection("materials"))
  .filter((e: any) => e.data.locale === locale)
  .sort((a: any, b: any) => a.data.order - b.data.order);

const listUrl = siteConfig.url + "/grades/";
// Unified `@graph` document: WebSite + Organization + WebPage + CollectionPage
// + ItemList + DefinedTermSet all share stable @ids so this pillar page
// emits exactly ONE <script type="application/ld+json"> block.
const pageGraph = buildPillarGraph({
  name: "Titanium Materials Guide",
  description: "Comprehensive technical specifications and guides for all titanium grades and alloys. Compare properties, machinability, and applications.",
  url: listUrl,
  collectionKey: "materials",
  locale,
  items: entries.map((e: any) => ({
    name: e.data.title,
    description: e.data.description,
    url: siteConfig.url + "/grades/" + e.id + "/",
  })),
}, siteConfig);
---
<EntityPillar
  collectionName="materials"
  pageTitle="Titanium Materials Guide"
  pageDescription="Comprehensive technical specifications and guides for all titanium grades and alloys. Compare properties, machinability, and applications."
  locale={locale}
  path="/grades/"
  pageGraph={pageGraph}
/>
