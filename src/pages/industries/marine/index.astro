---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Hero from "../../../components/hero/Hero.astro";
import CTA from "../../../components/CTA.astro";
import { resolveRoute } from "../../../i18n/routes";
import { siteConfig } from "../../../config/site.config";
import type { Locale } from "../../../lib/site-config";
import JsonLd from "../../../components/seo/JsonLd.astro";
import { buildBreadcrumbSchema, buildCollectionPageSchema } from "../../../lib/schema";

const locale = (Astro.currentLocale || "en") as Locale;
const listUrl = siteConfig.url + resolveRoute(locale, "/industries/marine/");
const spokePages = [
  { title: "Marine Titanium Machining", description: "CNC machining of titanium components for marine applications. Propeller shafts, seawater piping, desalination components, and subsea housings.", href: "/services/titanium-cnc-machining/", cta: "View CNC Machining Service →" },
  { title: "Marine Applications & Materials", description: "Guide to titanium in marine: seawater corrosion resistance, material selection for permanent seawater service without coatings.", href: "/knowledge/industries/marine/", cta: "Read Marine Guide →" },
  { title: "Standards & Compliance", description: "ASTM B265, B348, NACE MR0175 compliant manufacturing for marine and subsea applications.", href: "/knowledge/standards/", cta: "View Standards →" },
];
const breadcrumbSchema = buildBreadcrumbSchema([{ label: "Home", href: siteConfig.url + "/" }, { label: "Industries", href: siteConfig.url + "/industries/" }, { label: "Marine", href: listUrl }]);
const collectionSchema = buildCollectionPageSchema({ name: "Marine Titanium Manufacturing", description: "Corrosion-resistant titanium components for marine and subsea applications.", url: listUrl, numberOfItems: spokePages.length });
---
<BaseLayout title="Marine Titanium Components & Machining Services" description="Marine-grade titanium machining for seawater applications. Propeller shafts, piping, desalination components with unlimited corrosion-free service life." locale={locale} path={"/industries/marine"}>
  <section class="expertise-section container"><header class="section-head"><p class="section-head__eyebrow">Marine Expertise</p><h2 class="section-head__title">Seawater-Corrosion Resistant Titanium</h2></header><div class="expertise-grid"><div class="expertise-item"><span class="expertise-icon">&#x26F5;</span><h3>Seawater Immune</h3><p>Virtually zero corrosion in seawater, no coatings or CP required</p></div><div class="expertise-item"><span class="expertise-icon">&#x1F6A2;</span><h3>Subsea Capability</h3><p>Components for deepsea ROVs, AUVs, and subsea infrastructure</p></div><div class="expertise-item"><span class="expertise-icon">&#x2699;&#xFE0F;</span><h3>Precision Machining</h3><p>High-tolerance machining of propulsion and seawater system parts</p></div><div class="expertise-item"><span class="expertise-icon">&#x1F4CA;</span><h3>Lifecycle Certified</h3><p>Material traceability and certification for permanent marine service</p></div></div></section>
  <section class="materials-section container"><header class="section-head"><p class="section-head__eyebrow">Marine Titanium Grades</p><h2 class="section-head__title">Approved Alloys for Marine Service</h2></header><div class="materials-table-wrap"><table class="materials-table"><thead><tr><th>Alloy</th><th>Applications</th></tr></thead><tbody>
    <tr><td>CP-Ti Grade 2</td><td>Seawater piping, heat exchangers, desalination, hull fittings</td></tr>
    <tr><td>Ti-6Al-4V (Grade 5)</td><td>Propeller shafts, subsea housings, structural components</td></tr>
    <tr><td>Ti-6Al-4V ELI (Grade 23)</td><td>Fracture-critical subsea components, deepsea ROV parts</td></tr>
    <tr><td>Ti-Grade 7</td><td>High-corrosion marine environments, chemical injection</td></tr>
    <tr><td>Ti-3Al-2.5V (Grade 9)</td><td>Yacht fittings, rigging, lightweight marine components</td></tr>
  </tbody></table></div><p class="materials-link">→ <a href={resolveRoute(locale, "/knowledge/materials/")}>Complete guide to all titanium materials</a></p></section>
  <section class="certs-section container"><header class="section-head"><p class="section-head__eyebrow">Quality Systems</p><h2 class="section-head__title">Certifications &amp; Compliance</h2></header><div class="certs-row"><span class="cert-badge">ASTM B265</span><span class="cert-badge">ASTM B348</span><span class="cert-badge">NACE MR0175</span><span class="cert-badge">ISO 9001</span><span class="cert-badge">DNV</span><span class="cert-badge">CMM</span></div></section>
  <CTA eyebrow="Start Your Marine Project" title="Ready to Manufacture Marine Titanium Parts?" content="Submit your drawings and specifications for a detailed quote within 48 hours." ctaText="Upload Drawings & Request RFQ →" ctaHref="/rfq/request-quote/" secondaryText="View Marine Guide" secondaryHref="/knowledge/industries/marine/" locale={locale} />
</BaseLayout>

  <JsonLd schema={[breadcrumbSchema, collectionSchema]} />
  <Hero variant="centered" size="md" eyebrow="Marine & Subsea" headline="Titanium Manufacturing for Marine Applications" subheadline="Titanium is virtually immune to seawater corrosion, offering unlimited service life in marine environments without coatings or cathodic protection. We machine marine-grade titanium components for commercial, defence, and leisure vessels." primaryCta={{ label: "Request RFQ →", href: "/rfq/request-quote/" }} secondaryCta={{ label: "View Applications →", href: "/knowledge/industries/marine/" }} locale={locale} />
  <section class="hub-cards container"><header class="section-head"><p class="section-head__eyebrow">Our Solutions for Marine</p><h2 class="section-head__title">Complete Marine Titanium Capabilities</h2></header><div class="hub-cards__grid">{spokePages.map((page) => (<a href={resolveRoute(locale, page.href)} class="hub-card"><h3 class="hub-card__title">{page.title}</h3><p class="hub-card__description">{page.description}</p><span class="hub-card__cta">{page.cta}</span></a>))}</div></section>
<style>
  .hub-cards { padding-block: var(--space-xl) var(--space-3xl); }
  .hub-cards__grid { display: grid; gap: var(--space-lg); grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); margin-top: var(--space-xl); }
  .hub-card { display: block; padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-primary); text-decoration: none; transition: all 0.2s ease; }
  .hub-card:hover { border-color: var(--color-brand-primary); transform: translateY(-2px); }
  .hub-card__title { margin: 0 0 var(--space-sm); font-size: 1.15rem; color: var(--color-text-primary); }
  .hub-card__description { margin: 0; color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.6; }
  .hub-card__cta { display: inline-block; margin-top: var(--space-md); color: var(--color-brand-primary); font-weight: 600; }
  .expertise-section { padding-block: var(--space-xl) var(--space-3xl); }
  .expertise-grid { display: grid; gap: var(--space-lg); grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); margin-top: var(--space-xl); }
  .expertise-item { padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-secondary); }
  .expertise-icon { font-size: 1.75rem; display: block; margin-bottom: var(--space-sm); }
  .expertise-item h3 { margin: 0 0 var(--space-xs); font-size: 1rem; color: var(--color-text-primary); }
  .expertise-item p { margin: 0; color: var(--color-text-secondary); font-size: 0.875rem; line-height: 1.6; }
  .materials-section { padding-block: var(--space-xl) var(--space-3xl); }
  .materials-table-wrap { overflow-x: auto; margin-top: var(--space-xl); }
  .materials-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .materials-table th { text-align: left; padding: var(--space-sm) var(--space-md); border-bottom: 2px solid var(--color-border); color: var(--color-text-primary); font-weight: 600; }
  .materials-table td { padding: var(--space-sm) var(--space-md); border-bottom: 1px solid var(--color-border); color: var(--color-text-secondary); line-height: 1.5; }
  .materials-table td:first-child { font-weight: 600; color: var(--color-text-primary); white-space: nowrap; }
  .materials-link { margin-top: var(--space-md); text-align: center; color: var(--color-text-secondary); }
  .materials-link a { color: var(--color-brand-primary); font-weight: 600; }
  .certs-section { padding-block: var(--space-xl) var(--space-3xl); }
  .certs-row { display: flex; flex-wrap: wrap; gap: var(--space-md); justify-content: center; margin-top: var(--space-xl); }
  .cert-badge { display: inline-flex; align-items: center; padding: 0.5rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-full); background: var(--color-bg-primary); font-weight: 600; font-size: 0.85rem; color: var(--color-text-primary); }
  .section-head { text-align: center; }
  .section-head__eyebrow { display: inline-flex; align-items: center; margin: 0 auto var(--space-sm); padding: 0.35rem 0.9rem; border-radius: var(--radius-full); border: 1px solid color-mix(in srgb, var(--primary) 15%, transparent); background: color-mix(in srgb, var(--primary) 6%, transparent); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.75rem; color: var(--primary); font-weight: 700; width: fit-content; }
  .section-head__title { margin: 0; font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text-primary); max-width: 36rem; margin-inline: auto; }
</style>

