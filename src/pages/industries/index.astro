---
import EntityPillar from "../_shared/_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildCollectionPageSchema, buildItemListSchema } from "../../lib/schema";
import { siteConfig } from "../../config/site.config";
const locale = "en";
const entries = (await getCollection("industries"))
  .filter((e: any) => e.data.locale === locale)
  .sort((a: any, b: any) => a.data.order - b.data.order);

const listUrl = siteConfig.url + "/industries/";
const collectionSchema = buildCollectionPageSchema({
  name: "Titanium Industry Applications",
  description: "Technical guides on titanium applications across aerospace, medical, semiconductor, energy, and other critical industries.",
  url: listUrl,
  numberOfItems: entries.length,
});
const itemListSchema = entries.length > 0 ? buildItemListSchema({
  itemType: "TechArticle",
  numberOfItems: entries.length,
  url: listUrl,
  itemListElement: entries.map((e: any) => ({
    name: e.data.title,
    description: e.data.description,
    url: siteConfig.url + "/industries/" + e.id + "/",
  })),
}) : null;
const schemas = [collectionSchema, itemListSchema].filter(
  (s): s is NonNullable<typeof s> => s !== null,
);
---
<EntityPillar
  collectionName="industries"
  pageTitle="Titanium Industry Applications"
  pageDescription="Technical guides on titanium applications across aerospace, medical, semiconductor, energy, and other critical industries."
  locale={locale}
  path="/industries/"
  jsonLd={schemas}
/>
