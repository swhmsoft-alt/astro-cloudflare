---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Hero from "../../../components/hero/Hero.astro";
import CTA from "../../../components/CTA.astro";
import { resolveRoute } from "../../../i18n/routes";
import { siteConfig } from "../../../config/site.config";
import type { Locale } from "../../../lib/site-config";
import JsonLd from "../../../components/seo/JsonLd.astro";
import { buildBreadcrumbSchema, buildCollectionPageSchema } from "../../../lib/schema";

const locale = (Astro.currentLocale || "en") as Locale;
const listUrl = siteConfig.url + resolveRoute(locale, "/industries/chemical-processing/");
const spokePages = [
  { title: "Chemical Processing Titanium", description: "ASME BPVC certified titanium components for chemical processing. Heat exchangers, reaction vessels, piping systems, and chlorine dioxide equipment.", href: "/services/titanium-cnc-machining/", cta: "View Machining Service →" },
  { title: "Chemical Processing Applications", description: "Guide to titanium in chemical processing: corrosion resistance in chlorides, oxidising acids, and wet chlorine environments.", href: "/industries/chemical-processing/", cta: "Read Chemical Processing Guide →" },
  { title: "Standards & Compliance", description: "ASME BPVC, ASTM B265, ASTM B348 compliant manufacturing for chemical processing equipment.", href: "/standards/", cta: "View Standards →" },
];
const breadcrumbSchema = buildBreadcrumbSchema([{ label: "Home", href: siteConfig.url + "/" }, { label: "Industries", href: siteConfig.url + "/industries/" }, { label: "Chemical Processing", href: listUrl }]);
const collectionSchema = buildCollectionPageSchema({ name: "Chemical Processing Titanium Manufacturing", description: "Corrosion-resistant titanium components for chemical processing.", url: listUrl, numberOfItems: spokePages.length });
---
<BaseLayout title="Chemical Processing Titanium Components & Equipment" description="ASME BPVC certified titanium manufacturing for chemical processing. Heat exchangers, reactors, piping for corrosive chemical environments." locale={locale} path={"/industries/chemical-processing"}>
  <section class="expertise-section container"><header class="section-head"><p class="section-head__eyebrow">Chemical Processing Expertise</p><h2 class="section-head__title">Corrosion-Resistant Titanium Solutions</h2></header><div class="expertise-grid"><div class="expertise-item"><span class="expertise-icon">&#x2697;&#xFE0F;</span><h3>Corrosion Resistance</h3><p>Exceptional performance in chlorides, oxidising acids, wet chlorine</p></div><div class="expertise-item"><span class="expertise-icon">&#x1F30D;</span><h3>ASME BPVC Certified</h3><p>Certified pressure vessel fabrication for chemical processing</p></div><div class="expertise-item"><span class="expertise-icon">&#x1F3ED;</span><h3>Custom Fabrication</h3><p>Complex vessels, exchangers, and piping tailored to process requirements</p></div><div class="expertise-item"><span class="expertise-icon">&#x1F4CB;</span><h3>Material Certification</h3><p>Full MTRs and material traceability for every chemical component</p></div></div></section>
  <section class="materials-section container"><header class="section-head"><p class="section-head__eyebrow">Chemical Processing Titanium Grades</p><h2 class="section-head__title">Approved Alloys for Chemical Service</h2></header><div class="materials-table-wrap"><table class="materials-table"><thead><tr><th>Alloy</th><th>Applications</th></tr></thead><tbody>
    <tr><td>CP-Ti Grade 2</td><td>Heat exchangers, piping, reaction vessels for chloride service</td></tr>
    <tr><td>Ti-Grade 7</td><td>Extreme corrosion resistance, oxidising acid environments</td></tr>
    <tr><td>Ti-Grade 12</td><td>High-temperature chemical processing, heat exchanger tubing</td></tr>
    <tr><td>Ti-6Al-4V (Grade 5)</td><td>High-strength structural components, agitator shafts</td></tr>
    <tr><td>Ti-Grade 11</td><td>Enhanced corrosion resistance for reducing acid environments</td></tr>
  </tbody></table></div><p class="materials-link">→ <a href={resolveRoute(locale, "/grades/")}>Complete guide to all titanium materials</a></p></section>
  <section class="certs-section container"><header class="section-head"><p class="section-head__eyebrow">Quality Systems</p><h2 class="section-head__title">Certifications &amp; Compliance</h2></header><div class="certs-row"><span class="cert-badge">ASME BPVC</span><span class="cert-badge">ASTM B265</span><span class="cert-badge">ASTM B348</span><span class="cert-badge">ISO 9001</span><span class="cert-badge">NACE</span><span class="cert-badge">CMM</span><span class="cert-badge">NDT</span></div></section>
  <CTA
  eyebrow="Neutral engineering reference"
  title="Explore Titanium Engineering Knowledge"
  content="Neutral, vendor-independent technical guidance on titanium applications, grades, and standards to support your engineering decisions."
  ctaText="Browse Titanium Grades"
  ctaHref="/grades/"
  secondaryText="Compare Materials"
  secondaryHref="/compare/"
  locale={locale}
/>
</BaseLayout>

  <JsonLd schema={[breadcrumbSchema, collectionSchema]} />
  <Hero variant="centered" size="md" eyebrow="Chemical Processing" headline="Titanium Manufacturing for Chemical Processing" subheadline="Titanium offers exceptional corrosion resistance in chlorides, oxidising acids, and wet chlorine. We fabricate certified titanium vessels, heat exchangers, and piping systems for the most demanding chemical environments." primaryCta={{ label: "Browse Titanium Grades", href: "/grades/" }} secondaryCta={{ label: "View Applications →", href: "/industries/chemical-processing/" }} locale={locale} />
<style>
  .hub-cards { padding-block: var(--space-xl) var(--space-3xl); }
  .hub-cards__grid { display: grid; gap: var(--space-lg); grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); margin-top: var(--space-xl); }
  .hub-card { display: block; padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-primary); text-decoration: none; transition: all 0.2s ease; }
  .hub-card:hover { border-color: var(--color-brand-primary); transform: translateY(-2px); }
  .hub-card__title { margin: 0 0 var(--space-sm); font-size: 1.15rem; color: var(--color-text-primary); }
  .hub-card__description { margin: 0; color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.6; }
  .hub-card__cta { display: inline-block; margin-top: var(--space-md); color: var(--color-brand-primary); font-weight: 600; }
  .expertise-section { padding-block: var(--space-xl) var(--space-3xl); }
  .expertise-grid { display: grid; gap: var(--space-lg); grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); margin-top: var(--space-xl); }
  .expertise-item { padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-secondary); }
  .expertise-icon { font-size: 1.75rem; display: block; margin-bottom: var(--space-sm); }
  .expertise-item h3 { margin: 0 0 var(--space-xs); font-size: 1rem; color: var(--color-text-primary); }
  .expertise-item p { margin: 0; color: var(--color-text-secondary); font-size: 0.875rem; line-height: 1.6; }
  .materials-section { padding-block: var(--space-xl) var(--space-3xl); }
  .materials-table-wrap { overflow-x: auto; margin-top: var(--space-xl); }
  .materials-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .materials-table th { text-align: left; padding: var(--space-sm) var(--space-md); border-bottom: 2px solid var(--color-border); color: var(--color-text-primary); font-weight: 600; }
  .materials-table td { padding: var(--space-sm) var(--space-md); border-bottom: 1px solid var(--color-border); color: var(--color-text-secondary); line-height: 1.5; }
  .materials-table td:first-child { font-weight: 600; color: var(--color-text-primary); white-space: nowrap; }
  .materials-link { margin-top: var(--space-md); text-align: center; color: var(--color-text-secondary); }
  .materials-link a { color: var(--color-brand-primary); font-weight: 600; }
  .certs-section { padding-block: var(--space-xl) var(--space-3xl); }
  .certs-row { display: flex; flex-wrap: wrap; gap: var(--space-md); justify-content: center; margin-top: var(--space-xl); }
  .cert-badge { display: inline-flex; align-items: center; padding: 0.5rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-full); background: var(--color-bg-primary); font-weight: 600; font-size: 0.85rem; color: var(--color-text-primary); }
  .section-head { text-align: center; }
  .section-head__eyebrow { display: inline-flex; align-items: center; margin: 0 auto var(--space-sm); padding: 0.35rem 0.9rem; border-radius: var(--radius-full); border: 1px solid color-mix(in srgb, var(--primary) 15%, transparent); background: color-mix(in srgb, var(--primary) 6%, transparent); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.75rem; color: var(--primary); font-weight: 700; width: fit-content; }
  .section-head__title { margin: 0; font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text-primary); max-width: 36rem; margin-inline: auto; }
</style>

  <section class="hub-cards container"><header class="section-head"><p class="section-head__eyebrow">Our Solutions for Chemical Processing</p><h2 class="section-head__title">Complete Chemical Processing Titanium Capabilities</h2></header><div class="hub-cards__grid">{spokePages.map((page) => (<a href={resolveRoute(locale, page.href)} class="hub-card"><h3 class="hub-card__title">{page.title}</h3><p class="hub-card__description">{page.description}</p><span class="hub-card__cta">{page.cta}</span></a>))}</div></section>
