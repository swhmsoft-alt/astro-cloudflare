---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Hero from "../../../components/hero/Hero.astro";
import CTA from "../../../components/CTA.astro";
import { resolveRoute } from "../../../i18n/routes";
import { siteConfig } from "../../../config/site.config";
import type { Locale } from "../../../config/site.config";
import JsonLd from "../../../components/seo/JsonLd.astro";
import { buildBreadcrumbSchema, buildCollectionPageSchema } from "../../../lib/schema";

const locale = (Astro.currentLocale || "en") as Locale;
const listUrl = siteConfig.url + resolveRoute(locale, "/industries/medical/");
const spokePages = [
  { title: "Custom Medical Titanium Components", description: "ISO 13485 certified CNC machining of titanium medical components. Orthopedic implants, surgical instruments, dental implants, and custom medical devices.", href: "/services/medical-titanium-components/", cta: "View Medical Machining Service →" },
  { title: "Medical Device Applications & Materials", description: "Detailed guide to titanium grades and applications in medical device manufacturing. Ti-6Al-4V ELI, Grade 23, and commercially pure titanium.", href: "/industries/medical-device/", cta: "Read Medical Device Guide →" },
  { title: "Quality & Regulatory Compliance", description: "ISO 13485 quality management system, FDA QSR compliance, EU MDR, and full material traceability for medical device manufacturing.", href: "/standards/iso-13485/", cta: "View Medical Certifications →" },
];
const breadcrumbSchema = buildBreadcrumbSchema([{ label: "Home", href: siteConfig.url + "/" }, { label: "Industries", href: siteConfig.url + "/industries/" }, { label: "Medical", href: listUrl }]);
const collectionSchema = buildCollectionPageSchema({ name: "Medical Device Titanium Manufacturing", description: "ISO 13485 certified titanium manufacturing for medical devices.", url: listUrl, numberOfItems: spokePages.length });
---
<BaseLayout title="Medical Device Titanium Manufacturing & Machining Services" description="ISO 13485 certified titanium machining for medical devices. CNC milling and turning of orthopedic implants, surgical instruments, and custom medical components." locale={locale} path={"/industries/medical"}>
  <JsonLd schema={[breadcrumbSchema, collectionSchema]} />
  <Hero variant="centered" size="md" eyebrow="Medical Device Manufacturing" headline="Medical Titanium Manufacturing &amp; Machining" subheadline="Titanium is the preferred material for implantable and non-implantable medical devices due to its biocompatibility, corrosion resistance, and osseointegration properties. We provide ISO 13485 certified manufacturing for orthopedic, dental, and surgical applications." primaryCta={{ label: "Browse Titanium Grades", href: "/grades/" }} secondaryCta={{ label: "View Medical Applications →", href: "/industries/medical-device/" }} locale={locale} />
  <section class="hub-cards container">
    <header class="section-head">
      <p class="section-head__eyebrow">Medical Device Manufacturing Solutions</p>
      <h2 class="section-head__title">Complete Medical Titanium Capabilities</h2>
    </header>
    <div class="hub-cards__grid">
      {spokePages.map((page) => (
        <a href={resolveRoute(locale, page.href)} class="hub-card">
          <h3 class="hub-card__title">{page.title}</h3>
          <p class="hub-card__description">{page.description}</p>
          <span class="hub-card__cta">{page.cta}</span>
        </a>
      ))}
    </div>
  </section>
  <section class="expertise-section container">
    <header class="section-head"><p class="section-head__eyebrow">Medical Expertise</p><h2 class="section-head__title">Trusted by Medical Device OEMs</h2></header>
    <div class="expertise-grid">
      <div class="expertise-item"><span class="expertise-icon">&#x1F489;</span><h3>ISO 13485 Certified</h3><p>Quality management system for medical device manufacturing</p></div>
      <div class="expertise-item"><span class="expertise-icon">&#x1F3ED;</span><h3>Cleanroom Manufacturing</h3><p>Controlled environment for implantable device production</p></div>
      <div class="expertise-item"><span class="expertise-icon">&#x1F4CB;</span><h3>Full Traceability</h3><p>Material MTRs, process records, inspection reports for every part</p></div>
      <div class="expertise-item"><span class="expertise-icon">&#x2699;&#xFE0F;</span><h3>DFM for Medical</h3><p>Design feedback tailored to regulatory and quality requirements</p></div>
    </div>
  </section>
  <section class="materials-section container">
    <header class="section-head"><p class="section-head__eyebrow">Medical Titanium Grades</p><h2 class="section-head__title">Medical-Approved Titanium Alloys</h2></header>
    <div class="materials-table-wrap"><table class="materials-table"><thead><tr><th>Alloy</th><th>Standards</th><th>Applications</th></tr></thead><tbody>
      <tr><td>Ti-6Al-4V ELI (Grade 23)</td><td>ASTM F136, ISO 5832-3</td><td>Orthopedic implants, hip/knee replacements, spinal fixation</td></tr>
      <tr><td>Ti-6Al-4V (Grade 5)</td><td>ASTM F1472, ISO 5832-3</td><td>Surgical instruments, non-implantable devices</td></tr>
      <tr><td>CP-Ti Grade 4</td><td>ASTM F67, ISO 5832-2</td><td>Dental implants, abutments, bone plates</td></tr>
      <tr><td>CP-Ti Grade 2</td><td>ASTM F67, ISO 5832-2</td><td>Surgical instruments, trays, non-load-bearing implants</td></tr>
      <tr><td>CP-Ti Grade 1</td><td>ASTM F67, ISO 5832-2</td><td>Custom patient-specific implants, craniofacial plates</td></tr>
    </tbody></table></div>
    <p class="materials-link">→ <a href={resolveRoute(locale, "/grades/")}>Complete guide to all titanium materials</a></p>
  </section>
  <section class="certs-section container">
    <header class="section-head"><p class="section-head__eyebrow">Quality Systems</p><h2 class="section-head__title">Medical Device Certifications &amp; Compliance</h2></header>
    <div class="certs-row"><span class="cert-badge">ISO 13485</span><span class="cert-badge">FDA QSR</span><span class="cert-badge">EU MDR</span><span class="cert-badge">ASTM F136</span><span class="cert-badge">ASTM F67</span><span class="cert-badge">ISO 5832</span><span class="cert-badge">CMM</span></div>
  </section>
  <CTA
  eyebrow="Neutral engineering reference"
  title="Explore Titanium Engineering Knowledge"
  content="Neutral, vendor-independent technical guidance on titanium applications, grades, and standards to support your engineering decisions."
  ctaText="Browse Titanium Grades"
  ctaHref="/grades/"
  secondaryText="Compare Materials"
  secondaryHref="/compare/"
  locale={locale}
/>
</BaseLayout>

<style>

  .hub-cards { padding-block: var(--space-xl) var(--space-3xl); }
  .hub-cards__grid { display: grid; gap: var(--space-lg); grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); margin-top: var(--space-xl); }
  .hub-card { display: block; padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-primary); text-decoration: none; transition: all 0.2s ease; }
  .hub-card:hover { border-color: var(--color-brand-primary); transform: translateY(-2px); }
  .hub-card__title { margin: 0 0 var(--space-sm); font-size: 1.15rem; color: var(--color-text-primary); }
  .hub-card__description { margin: 0; color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.6; }
  .hub-card__cta { display: inline-block; margin-top: var(--space-md); color: var(--color-brand-primary); font-weight: 600; }
  .expertise-section { padding-block: var(--space-xl) var(--space-3xl); }
  .expertise-grid { display: grid; gap: var(--space-lg); grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); margin-top: var(--space-xl); }
  .expertise-item { padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-secondary); }
  .expertise-icon { font-size: 1.75rem; display: block; margin-bottom: var(--space-sm); }
  .expertise-item h3 { margin: 0 0 var(--space-xs); font-size: 1rem; color: var(--color-text-primary); }
  .expertise-item p { margin: 0; color: var(--color-text-secondary); font-size: 0.875rem; line-height: 1.6; }
  .materials-section { padding-block: var(--space-xl) var(--space-3xl); }
  .materials-table-wrap { overflow-x: auto; margin-top: var(--space-xl); }
  .materials-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .materials-table th { text-align: left; padding: var(--space-sm) var(--space-md); border-bottom: 2px solid var(--color-border); color: var(--color-text-primary); font-weight: 600; }
  .materials-table td { padding: var(--space-sm) var(--space-md); border-bottom: 1px solid var(--color-border); color: var(--color-text-secondary); line-height: 1.5; }
  .materials-table td:first-child { font-weight: 600; color: var(--color-text-primary); white-space: nowrap; }
  .materials-link { margin-top: var(--space-md); text-align: center; color: var(--color-text-secondary); }
  .materials-link a { color: var(--color-brand-primary); font-weight: 600; }
  .certs-section { padding-block: var(--space-xl) var(--space-3xl); }
  .certs-row { display: flex; flex-wrap: wrap; gap: var(--space-md); justify-content: center; margin-top: var(--space-xl); }
  .cert-badge { display: inline-flex; align-items: center; padding: 0.5rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-full); background: var(--color-bg-primary); font-weight: 600; font-size: 0.85rem; color: var(--color-text-primary); }
  .section-head { text-align: center; }
  .section-head__eyebrow { display: inline-flex; align-items: center; margin: 0 auto var(--space-sm); padding: 0.35rem 0.9rem; border-radius: var(--radius-full); border: 1px solid color-mix(in srgb, var(--primary) 15%, transparent); background: color-mix(in srgb, var(--primary) 6%, transparent); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.75rem; color: var(--primary); font-weight: 700; width: fit-content; }
  .section-head__title { margin: 0; font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text-primary); max-width: 36rem; margin-inline: auto; }
</style>
