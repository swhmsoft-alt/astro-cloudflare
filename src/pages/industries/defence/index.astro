---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Hero from "../../../components/hero/Hero.astro";
import CTA from "../../../components/CTA.astro";
import { resolveRoute } from "../../../i18n/routes";
import { siteConfig } from "../../../config/site.config";
import type { Locale } from "../../../lib/site-config";
import JsonLd from "../../../components/seo/JsonLd.astro";
import { buildBreadcrumbSchema, buildCollectionPageSchema } from "../../../lib/schema";

const locale = (Astro.currentLocale || "en") as Locale;
const listUrl = siteConfig.url + resolveRoute(locale, "/industries/defence/");
const spokePages = [
  { title: "Defence Titanium Machining", description: "ITAR compliant, MIL-SPEC titanium machining for defence applications. Armour systems, aerospace structural components, naval systems, and ordnance parts.", href: "/services/aerospace-titanium-components/", cta: "View Defence Machining Service →" },
  { title: "Defence Applications & Materials", description: "Guide to titanium in defence: lightweight ballistic protection, military aircraft structures, naval systems, and soldier equipment.", href: "/knowledge/industries/defence/", cta: "Read Defence Guide →" },
  { title: "Standards & Compliance", description: "MIL-T-9046, AS9100D, NADCAP, ITAR, DFARS compliant for defence and military programs.", href: "/knowledge/standards/", cta: "View Standards →" },
];
const breadcrumbSchema = buildBreadcrumbSchema([{ label: "Home", href: siteConfig.url + "/" }, { label: "Industries", href: siteConfig.url + "/industries/" }, { label: "Defence", href: listUrl }]);
const collectionSchema = buildCollectionPageSchema({ name: "Defence Titanium Manufacturing", description: "ITAR compliant titanium manufacturing for defence and military applications.", url: listUrl, numberOfItems: spokePages.length });
---
<BaseLayout title="Defence & Military Titanium Components & Machining" description="MIL-SPEC titanium machining for defence. Armour systems, aerospace structural components, naval propeller systems with full traceability." locale={locale} path={"/industries/defence"}>
  <section class="expertise-section container"><header class="section-head"><p class="section-head__eyebrow">Defence Expertise</p><h2 class="section-head__title">MIL-SPEC Compliant Titanium Manufacturing</h2></header><div class="expertise-grid"><div class="expertise-item"><span class="expertise-icon">&#x1F6E1;&#xFE0F;</span><h3>ITAR Registered</h3><p>Compliant with International Traffic in Arms Regulations</p></div><div class="expertise-item"><span class="expertise-icon">&#x2708;&#xFE0F;</span><h3>MIL-SPEC Expertise</h3><p>Manufacturing to military specifications with full traceability</p></div><div class="expertise-item"><span class="expertise-icon">&#x1F3C6;</span><h3>AS9100D + NADCAP</h3><p>Aerospace and defence quality certifications</p></div><div class="expertise-item"><span class="expertise-icon">&#x1F50D;</span><h3>DFARS Compliant</h3><p>Defense Federal Acquisition Regulation compliant supply chain</p></div></div></section>
  <section class="materials-section container"><header class="section-head"><p class="section-head__eyebrow">Defence Titanium Grades</p><h2 class="section-head__title">MIL-SPEC Approved Titanium Alloys</h2></header><div class="materials-table-wrap"><table class="materials-table"><thead><tr><th>Alloy</th><th>Applications</th></tr></thead><tbody>
    <tr><td>Ti-6Al-4V (Grade 5)</td><td>Armour plating, aircraft structures, naval propeller systems</td></tr>
    <tr><td>Ti-6Al-4V ELI (Grade 23)</td><td>Fracture-critical defence components, ordnance parts</td></tr>
    <tr><td>Ti-5553</td><td>High-strength structural components, landing gear, armour</td></tr>
    <tr><td>Ti-6242</td><td>High-temperature engine components for military aircraft</td></tr>
    <tr><td>Ti-3Al-2.5V (Grade 9)</td><td>Hydraulic tubing, ducting for military platforms</td></tr>
  </tbody></table></div><p class="materials-link">→ <a href={resolveRoute(locale, "/knowledge/materials/")}>Complete guide to all titanium materials</a></p></section>
  <section class="certs-section container"><header class="section-head"><p class="section-head__eyebrow">Quality Systems</p><h2 class="section-head__title">Certifications &amp; Compliance</h2></header><div class="certs-row"><span class="cert-badge">AS9100D</span><span class="cert-badge">NADCAP</span><span class="cert-badge">ITAR</span><span class="cert-badge">DFARS</span><span class="cert-badge">MIL-T-9046</span><span class="cert-badge">CMM</span><span class="cert-badge">NDT</span></div></section>
  <CTA eyebrow="Start Your Defence Project" title="Ready to Manufacture Defence Titanium Parts?" content="Submit your drawings and specifications for a detailed quote within 48 hours." ctaText="Upload Drawings & Request RFQ →" ctaHref="/rfq/request-quote/" secondaryText="View Defence Guide" secondaryHref="/knowledge/industries/defence/" locale={locale} />
</BaseLayout>

  <JsonLd schema={[breadcrumbSchema, collectionSchema]} />
  <Hero variant="centered" size="md" eyebrow="Defence & Military" headline="Titanium Manufacturing for Defence Applications" subheadline="Titanium provides lightweight ballistic protection, high-strength structural components for military aircraft, and corrosion-resistant naval systems. We manufacture to MIL-SPEC requirements with ITAR compliance and full traceability." primaryCta={{ label: "Request Defence RFQ →", href: "/rfq/request-quote/" }} secondaryCta={{ label: "View Applications →", href: "/knowledge/industries/defence/" }} locale={locale} />
  <section class="hub-cards container"><header class="section-head"><p class="section-head__eyebrow">Our Solutions for Defence</p><h2 class="section-head__title">Complete Defence Titanium Capabilities</h2></header><div class="hub-cards__grid">{spokePages.map((page) => (<a href={resolveRoute(locale, page.href)} class="hub-card"><h3 class="hub-card__title">{page.title}</h3><p class="hub-card__description">{page.description}</p><span class="hub-card__cta">{page.cta}</span></a>))}</div></section>
<style>
  .hub-cards { padding-block: var(--space-xl) var(--space-3xl); }
  .hub-cards__grid { display: grid; gap: var(--space-lg); grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); margin-top: var(--space-xl); }
  .hub-card { display: block; padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-primary); text-decoration: none; transition: all 0.2s ease; }
  .hub-card:hover { border-color: var(--color-brand-primary); transform: translateY(-2px); }
  .hub-card__title { margin: 0 0 var(--space-sm); font-size: 1.15rem; color: var(--color-text-primary); }
  .hub-card__description { margin: 0; color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.6; }
  .hub-card__cta { display: inline-block; margin-top: var(--space-md); color: var(--color-brand-primary); font-weight: 600; }
  .expertise-section { padding-block: var(--space-xl) var(--space-3xl); }
  .expertise-grid { display: grid; gap: var(--space-lg); grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); margin-top: var(--space-xl); }
  .expertise-item { padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-secondary); }
  .expertise-icon { font-size: 1.75rem; display: block; margin-bottom: var(--space-sm); }
  .expertise-item h3 { margin: 0 0 var(--space-xs); font-size: 1rem; color: var(--color-text-primary); }
  .expertise-item p { margin: 0; color: var(--color-text-secondary); font-size: 0.875rem; line-height: 1.6; }
  .materials-section { padding-block: var(--space-xl) var(--space-3xl); }
  .materials-table-wrap { overflow-x: auto; margin-top: var(--space-xl); }
  .materials-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .materials-table th { text-align: left; padding: var(--space-sm) var(--space-md); border-bottom: 2px solid var(--color-border); color: var(--color-text-primary); font-weight: 600; }
  .materials-table td { padding: var(--space-sm) var(--space-md); border-bottom: 1px solid var(--color-border); color: var(--color-text-secondary); line-height: 1.5; }
  .materials-table td:first-child { font-weight: 600; color: var(--color-text-primary); white-space: nowrap; }
  .materials-link { margin-top: var(--space-md); text-align: center; color: var(--color-text-secondary); }
  .materials-link a { color: var(--color-brand-primary); font-weight: 600; }
  .certs-section { padding-block: var(--space-xl) var(--space-3xl); }
  .certs-row { display: flex; flex-wrap: wrap; gap: var(--space-md); justify-content: center; margin-top: var(--space-xl); }
  .cert-badge { display: inline-flex; align-items: center; padding: 0.5rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-full); background: var(--color-bg-primary); font-weight: 600; font-size: 0.85rem; color: var(--color-text-primary); }
  .section-head { text-align: center; }
  .section-head__eyebrow { display: inline-flex; align-items: center; margin: 0 auto var(--space-sm); padding: 0.35rem 0.9rem; border-radius: var(--radius-full); border: 1px solid color-mix(in srgb, var(--primary) 15%, transparent); background: color-mix(in srgb, var(--primary) 6%, transparent); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.75rem; color: var(--primary); font-weight: 700; width: fit-content; }
  .section-head__title { margin: 0; font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text-primary); max-width: 36rem; margin-inline: auto; }
</style>

