---
import EntityPillar from "../_shared/_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildCollectionPageSchema, buildItemListSchema } from "../../lib/schema";
import { siteConfig } from "../../config/site.config";
const locale = "en";
const entries = (await getCollection("failureAnalysis"))
  .filter((e: any) => e.data.locale === locale)
  .sort((a: any, b: any) => a.data.order - b.data.order);

const listUrl = siteConfig.url + "/failures/";
const collectionSchema = buildCollectionPageSchema({
  name: "Titanium Failure Analysis",
  description: "Technical guides on titanium failure modes: hydrogen embrittlement, stress corrosion cracking, fatigue, and prevention.",
  url: listUrl,
  numberOfItems: entries.length,
});
const itemListSchema = entries.length > 0 ? buildItemListSchema({
  itemType: "TechArticle",
  numberOfItems: entries.length,
  url: listUrl,
  itemListElement: entries.map((e: any) => ({
    name: e.data.title,
    description: e.data.description,
    url: siteConfig.url + "/failures/" + e.id + "/",
  })),
}) : null;
const schemas = [collectionSchema, itemListSchema].filter(
  (s): s is NonNullable<typeof s> => s !== null,
);
---
<EntityPillar
  collectionName="failureAnalysis"
  pageTitle="Titanium Failure Analysis"
  pageDescription="Technical guides on titanium failure modes: hydrogen embrittlement, stress corrosion cracking, fatigue, and prevention."
  locale={locale}
  path="/failures/"
  jsonLd={schemas}
/>
