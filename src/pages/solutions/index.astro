---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { t } from "../../i18n/ui";
import { resolveRoute } from "../../i18n/routes";
import Hero from "../../components/Hero.astro";
import CTA from "../../components/CTA.astro";

const locale = (Astro.currentLocale || "en") as "en";

const allPages: CollectionEntry<"pages">[] = await getCollection("pages");
const page = allPages.find(
  (p) => p.data.slug === "solutions" && p.data.locale === locale,
);

interface PageSection {
  type: string;
  title?: string;
  content?: string;
  ctaText?: string;
  ctaHref?: string;
  items?: { title?: string; description?: string; icon?: string; slug?: string }[];
}

const sections: PageSection[] = page?.data.sections || [];
const heroSection = sections.find((s) => s.type === "hero");
const featuresSection = sections.find((s) => s.type === "features");
const systemsSection = sections.find((s) => s.type === "systems");
const ctaSection = sections.find((s) => s.type === "cta");
const featureItems = featuresSection?.items || [];
const systemItems = systemsSection?.items || [];

// Emoji map for solution category icons (used at build time)
const emojiMap: Record<string, string> = {
  "rocket": "🚀",
  "cpu": "💻",
  "heart-pulse": "❤️",
  "bike": "🚲",
  "ship": "🚢",
  "car": "🏎️",
  "sparkles": "✨",
  "flask-conical": "🧪",
  "zap": "⚡",
  "smartwatch": "⌚",
  "cog": "⚙️",
  "leaf": "🌿",
  "printer": "🖨️",
  "drill": "🔧",
};

// Map feature items to their slug identifiers
const solutionSlugs = [
  "aerospace-defense",
  "semiconductor",
  "medical-device",
  "cycling-bicycle",
  "marine-offshore",
  "automotive-motorsports",
  "electroplating-surface-finishing",
  "chemical-processing",
  "energy",
  "consumer-electronics",
  "general-industrial",
  "environmental-engineering",
];
---

<BaseLayout
  title={page?.data.title || t(locale, "nav.solutions")}
  description={page?.data.description || ""}
  locale={locale}
  path={"/solutions"}
>
  {
    heroSection && (
      <Hero
        variant="centered"
        size="md"
        eyebrow="Solutions"
        title={heroSection.title || page?.data.title || ""}
        content={heroSection.content}
        locale={locale}
      />
    )
  }
  {
    featuresSection && (
      <section class="c py-16">
        <header class="section-head">
          <p class="section-head__eyebrow">By Industry</p>
          <h2 class="section-head__title">{featuresSection.title}</h2>
        </header>
        <div class="solutions-grid">
          {
            solutionSlugs.map((slug, i) => {
              const item = featureItems[i];
              if (!item) return null;
              return (
                <a
                  href={resolveRoute(locale, `/solutions/${slug}/`)}
                  class="solution-card"
                >
                  <div class="solution-card__icon">
                    {item.icon && <span class="solution-card__emoji">{emojiMap[item.icon] || ""}</span>}
                  </div>
                  <h3 class="solution-card__title">{item.title}</h3>
                  <p class="solution-card__desc">{item.description}</p>
                  <span class="solution-card__cta">Learn more &rarr;</span>
                </a>
              );
            })
          }
        </div>
      </section>
    )
  }
  {
    systemsSection && (
      <section class="c py-16">
        <header class="section-head">
          <p class="section-head__eyebrow">Manufacturing Systems</p>
          <h2 class="section-head__title">{systemsSection.title}</h2>
        </header>
        <div class="solutions-grid">
          {
            systemItems.map((item) => {
              const slug = item.slug;
              if (!slug) return null;
              return (
                <a
                  href={resolveRoute(locale, `/solutions/systems/${slug}/`)}
                  class="solution-card"
                >
                  <div class="solution-card__icon">
                    {item.icon && <span class="solution-card__emoji">{emojiMap[item.icon] || "⚙️"}</span>}
                  </div>
                  <h3 class="solution-card__title">{item.title}</h3>
                  <p class="solution-card__desc">{item.description}</p>
                  <span class="solution-card__cta">Learn more &rarr;</span>
                </a>
              );
            })
          }
        </div>
      </section>
    )
  }
  {
    ctaSection && (
      <CTA
        title={ctaSection.title || ""}
        content={ctaSection.content || ""}
        ctaText={ctaSection.ctaText}
        ctaHref={ctaSection.ctaHref || "/contact/"}
        locale={locale}
      />
    )
  }
</BaseLayout>

<style>
  .solutions-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    margin-top: var(--space-xl);
  }
  .solution-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-primary);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .solution-card:hover {
    border-color: var(--color-brand-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .solution-card__icon {
    margin-bottom: var(--space-xs);
  }
  .solution-card__emoji {
    font-size: 1.75rem;
    line-height: 1;
  }
  .solution-card__title {
    margin: 0;
    font-size: 1.1rem;
    color: var(--color-text-primary);
    font-weight: 700;
  }
  .solution-card__desc {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    flex: 1;
  }
  .solution-card__cta {
    display: inline-block;
    margin-top: var(--space-sm);
    color: var(--color-brand-primary);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
