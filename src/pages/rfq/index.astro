---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import Hero from "../../components/Hero.astro";
import CTA from "../../components/CTA.astro";
import CapabilityShowcase from "../../components/CapabilityShowcase.astro";
import { Grid, Section } from "../../components/ui/layout";
import { Card } from "../../components/ui/data-display";
import { resolveRoute } from "../../i18n/routes";
import type { Locale } from "../../lib/site-config";

const locale = (Astro.currentLocale || "en") as Locale;
---

<MarketingLayout
  title="Request for Quote — Titanium Manufacturing"
  description="Submit your titanium component requirements. Upload drawings, specify materials and tolerances, and receive a competitive quote within 24 hours."
  locale={locale}
  path="/rfq/"
>
  <Hero
    variant="centered"
    size="md"
    eyebrow="Request for Quote"
    title="Start Your Titanium Manufacturing Project"
    content="Upload your drawings, specify your requirements, and get a competitive quote within 24 hours."
    locale={locale}
  />

  <Section spacing="xl">
    <div class="container">
      <Grid cols={2} gap="lg">
        <a href={resolveRoute(locale, "/rfq/upload-drawing/")} class="card-link">
          <Card hover>
            <div class="card-icon" aria-hidden="true">📄</div>
            <h3 class="card-title">Upload Drawing</h3>
            <p class="card-desc">Upload STEP, IGES, STL, DXF, or PDF files. Our team will review and quote within 24 hours.</p>
            <span class="card-cta">Upload Now →</span>
          </Card>
        </a>

        <a href={resolveRoute(locale, "/rfq/request-quote/")} class="card-link">
          <Card hover>
            <div class="card-icon" aria-hidden="true">💰</div>
            <h3 class="card-title">Request a Quote</h3>
            <p class="card-desc">Describe your project requirements and get a detailed quote for your titanium components.</p>
            <span class="card-cta">Request Now →</span>
          </Card>
        </a>

        <a href={resolveRoute(locale, "/rfq/dfm-review/")} class="card-link">
          <Card hover>
            <div class="card-icon" aria-hidden="true">🔧</div>
            <h3 class="card-title">Free DFM Review</h3>
            <p class="card-desc">Get Design for Manufacturing feedback on your design before committing to production.</p>
            <span class="card-cta">Get DFM Feedback →</span>
          </Card>
        </a>

        <a href={resolveRoute(locale, "/rfq/prototype-request/")} class="card-link">
          <Card hover>
            <div class="card-icon" aria-hidden="true">⚡</div>
            <h3 class="card-title">Prototype Request</h3>
            <p class="card-desc">Rapid prototyping for titanium parts — as fast as 5 business days for low-volume runs.</p>
            <span class="card-cta">Start Prototype →</span>
          </Card>
        </a>
      </Grid>
    </div>
  </Section>

  <CapabilityShowcase />

  <CTA
    eyebrow="Ready to Start?"
    title="Upload Your Drawing Today"
    content="Get DFM feedback and a competitive quote within 24 hours."
    ctaText="Upload Drawing →"
    ctaHref="/rfq/upload-drawing/"
    locale={locale}
  />
</MarketingLayout>

<style>
  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .card-link:hover {
    color: inherit;
  }
  .card-icon {
    font-size: 2rem;
    margin-bottom: var(--space-sm);
  }
  .card-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    margin: 0 0 var(--space-xs);
    color: var(--foreground);
  }
  .card-desc {
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }
  .card-cta {
    display: inline-block;
    margin-top: var(--space-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--primary);
  }
</style>