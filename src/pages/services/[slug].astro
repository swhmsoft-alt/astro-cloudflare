---

import ServiceLayout from "../../layouts/ServiceLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import CTA from "../../components/CTA.astro";
import CapabilityShowcase from "../../components/CapabilityShowcase.astro";

export async function getStaticPaths() {
  const allServices: CollectionEntry<"services">[] =
    await getCollection("services");
  const supportedLocales = ["en", "de", "ja", "fr", "es", "pt", "it", "ko", "nl", "pl", "ru", "ar", "pt-br", "tr", "cs", "sv"];
  const paths = [];
  for (const locale of supportedLocales) {
    const servicesForLocale = allServices.filter((s) => s.data.locale === locale);
    for (const service of servicesForLocale) {
      paths.push({
        params: { slug: service.data.slug },
        props: { service, locale: service.data.locale },
      });
    }
  }
  // Fallback: if no locale-specific content, use English
  if (paths.length === 0) {
    const englishServices = allServices.filter((s) => s.data.locale === "en");
    for (const service of englishServices) {
      paths.push({
        params: { slug: service.data.slug },
        props: { service, locale: "en" as const },
      });
    }
  }
  return paths;
}

const { service, locale } = Astro.props as {
  service: CollectionEntry<"services">;
  locale: "en";
};
const { Content, headings } = await render(service);
---

<ServiceLayout service={service} locale={locale} headings={headings}>
  <Content />
</ServiceLayout>

<CapabilityShowcase />

<CTA
  title="Start Your Titanium Project Today"
  content="Upload your drawing or describe your requirements. Our engineering team will provide DFM feedback and a competitive quote within 24 hours."
  ctaText="Upload Drawing →"
  ctaHref="/rfq/upload-drawing/"
  secondaryText="Request a Quote"
  secondaryHref="/rfq/request-quote/"
  locale={locale}
/>
