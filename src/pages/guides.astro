---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { t } from "../i18n/ui";
import { resolveRoute } from "../i18n/routes";
import { siteConfig } from "../config/site.config";
import { buildCollectionPageSchema, buildItemListSchema } from "../lib/schema";
import type { Locale } from "../lib/site-config";

const locale = (Astro.currentLocale || "en") as Locale;

const guideTypes = ["material-selection", "machining", "design", "procurement", "industry"];
const listUrl = siteConfig.url + resolveRoute(locale, "/guides/");
const collectionSchema = buildCollectionPageSchema({
  name: "Titanium Manufacturing Guides",
  description: "Step-by-step guides for titanium material selection, machining, design, procurement, and industry applications.",
  url: listUrl,
  numberOfItems: guideTypes.length,
});
const itemListSchema = buildItemListSchema({
  itemType: "HowTo",
  numberOfItems: guideTypes.length,
  url: listUrl,
  itemListElement: guideTypes.map((g) => ({
    name: g.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()),
    description: `Step-by-step guide for titanium ${g.replace(/-/g, " ")}.`,
    url: siteConfig.url + resolveRoute(locale, `/guides/#${g}`),
  })),
});
const schemas = [collectionSchema, itemListSchema].filter(
  (s): s is Record<string, unknown> => s !== null,
);

interface GuideStep {
  label: string;
  href: string;
}

interface GuideCategory {
  key: string;
  titleKey: string;
  goal: string;
  steps: GuideStep[];
  cta: { label: string; href: string };
}

const guideCategories: GuideCategory[] = [
  {
    key: "material-selection",
    titleKey: "guides.category.materialSelection",
    goal: "I need to choose the right titanium grade for my part.",
    steps: [
      { label: "Compare material properties by grade", href: "/knowledge/materials/" },
      { label: "Run a side-by-side grade comparison", href: "/compare/" },
      { label: "Check applicable standards & certifications", href: "/knowledge/standards/" },
    ],
    cta: { label: "Get a quote for your grade \u2192", href: "/rfq/request-quote/" },
  },
  {
    key: "machining",
    titleKey: "guides.category.machining",
    goal: "I need to decide how to machine my titanium part.",
    steps: [
      { label: "Explore available manufacturing processes", href: "/knowledge/processes/" },
      { label: "Compare precision, cost & lead time", href: "/compare/" },
      { label: "See real production case studies", href: "/knowledge/cases/" },
    ],
    cta: { label: "Request a machining quote \u2192", href: "/rfq/request-quote/" },
  },
  {
    key: "design",
    titleKey: "guides.category.design",
    goal: "I need to design my part for titanium manufacturing.",
    steps: [
      { label: "Review technical parameters (tolerances, radii, wall thickness)", href: "/knowledge/evidence/" },
      { label: "Choose a surface finish", href: "/knowledge/surface-finishes/" },
      { label: "Confirm design standards compliance", href: "/knowledge/standards/" },
    ],
    cta: { label: "Submit for DFM review \u2192", href: "/rfq/dfm-review/" },
  },
  {
    key: "procurement",
    titleKey: "guides.category.procurement",
    goal: "I need to send an RFQ and get production started.",
    steps: [
      { label: "Prepare your drawing and specifications", href: "/knowledge/procurement/" },
      { label: "Upload your part file (STEP, IGES, PDF)", href: "/rfq/upload-drawing/" },
      { label: "Understand lead times and quality certs", href: "/knowledge/standards/" },
    ],
    cta: { label: "Submit your RFQ now \u2192", href: "/rfq/request-quote/" },
  },
  {
    key: "industry",
    titleKey: "guides.category.industry",
    goal: "I need to know what applies to my industry.",
    steps: [
      { label: "Browse industry-specific requirements", href: "/knowledge/industries/" },
      { label: "Review relevant materials and processes", href: "/knowledge/materials/" },
      { label: "Read application case studies", href: "/knowledge/cases/" },
    ],
    cta: { label: "Get an industry-compliant quote \u2192", href: "/rfq/request-quote/" },
  },
];
---



<MarketingLayout
  title={t(locale, "guides.pageTitle")}
  description={t(locale, "guides.pageDescription")}
  locale={locale}
  path="/guides/"
  jsonLd={schemas}
>
  <section class="guides-hub container">
    <header class="section-head">
      <p class="section-head__eyebrow">{t(locale, "guides.eyebrow")}</p>
      <h1 class="section-head__title">{t(locale, "guides.pageTitle")}</h1>
      <p class="section-head__lead">
        {t(locale, "guides.pageDescription")}
      </p>
    </header>

    <div class="guides-grid">
      {
        guideCategories.map((cat) => (
          <article class="guide-card">
            <div class="guide-card__header">
              <span class="guide-card__badge">{cat.steps.length} steps</span>
              <h2 class="guide-card__title">{t(locale, cat.titleKey)}</h2>
            </div>
            <p class="guide-card__goal">{cat.goal}</p>
            <ol class="guide-card__steps">
              {cat.steps.map((step, i) => (
                <li class="guide-card__step">
                  <span class="guide-card__step-num">{i + 1}</span>
                  <a href={resolveRoute(locale, step.href)} class="guide-card__step-link">
                    {step.label}
                  </a>
                </li>
              ))}
            </ol>
            <a href={resolveRoute(locale, cat.cta.href)} class="guide-card__cta">
              {cat.cta.label}
            </a>
          </article>
        ))
      }
    </div>
  </section>
</MarketingLayout>

<style>
  .guides-hub {
    padding-block: var(--space-2xl);
  }

  .guides-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
    margin-top: var(--space-xl);
  }

  @media (min-width: 768px) {
    .guides-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .guides-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-primary);
    transition: border-color 0.2s ease;
  }

  .guide-card:hover {
    border-color: var(--color-brand-primary);
  }

  .guide-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .guide-card__badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    background: var(--color-bg-tertiary);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .guide-card__title {
    margin: 0;
    font-size: 1.15rem;
    color: var(--color-text-primary);
  }

  .guide-card__goal {
    margin: var(--space-sm) 0 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
    font-style: italic;
  }

  .guide-card__steps {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    flex: 1;
  }

  .guide-card__step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-xs) 0;
  }

  .guide-card__step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--color-brand-primary);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
  }

  .guide-card__step-link {
    color: var(--color-text-primary);
    font-size: 0.88rem;
    text-decoration: none;
    line-height: 1.5;
    padding-top: 0.1rem;
  }

  .guide-card__step-link:hover {
    color: var(--color-brand-primary);
    text-decoration: underline;
  }

  .guide-card__cta {
    display: block;
    margin-top: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-brand-primary);
    border-radius: var(--radius-md);
    color: var(--color-brand-primary);
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
    text-align: center;
    transition: all 0.2s ease;
  }

  .guide-card__cta:hover {
    background: var(--color-brand-primary);
    color: #fff;
  }
</style>
