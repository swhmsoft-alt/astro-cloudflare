---
import EntityPillar from "../_shared/_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildCollectionPageSchema, buildItemListSchema } from "../../lib/schema";
import { resolveRoute } from "../../i18n/routes";
import { siteConfig } from "../../config/site.config";
import type { Locale } from "../../config/site.config";
const locale = (Astro.currentLocale || "en") as Locale;
const entries = (await getCollection("cases")).filter((e: any) => e.data.locale === locale).sort((a: any, b: any) => (a.data.order || 0) - (b.data.order || 0));
const listUrl = siteConfig.url + resolveRoute(locale, "/cases/");
const collectionSchema = buildCollectionPageSchema({ name: "Titanium Manufacturing Case Studies", description: "Engineering case studies covering titanium machining, fabrication, and application challenges with measurable outcomes.", url: listUrl, numberOfItems: entries.length });
const itemListSchema = entries.length > 0 ? buildItemListSchema({ itemType: "CreativeWork", numberOfItems: entries.length, url: listUrl, itemListElement: entries.map((e: any) => ({ name: e.data.title, description: e.data.description, url: siteConfig.url + resolveRoute(locale, "/cases/" + e.id + "/") })) }) : null;
const schemas = [collectionSchema, itemListSchema].filter((s): s is NonNullable<typeof s> => s !== null);
---
<EntityPillar collectionName="cases" pageTitle="Titanium Manufacturing Case Studies" pageDescription="Engineering case studies covering titanium machining, fabrication, and application challenges with measurable outcomes." locale={locale} path="/cases/" jsonLd={schemas} />
