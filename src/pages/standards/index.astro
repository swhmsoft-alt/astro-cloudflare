---
import EntityPillar from "../_shared/_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildPillarGraph, SITE_ABOUT_TOPICS } from "../../lib/schema";
import { siteConfig } from "../../config/site.config";
const locale = "en";
const entries = (await getCollection("standards"))
  .filter((e: any) => e.data.locale === locale)
  .sort((a: any, b: any) => a.data.order - b.data.order);

const listUrl = siteConfig.url + "/standards/";
// Unified `@graph` document: WebSite + Organization + WebPage + CollectionPage
// + ItemList + DefinedTermSet all share stable @ids so this pillar page
// emits exactly ONE <script type="application/ld+json"> block. Matches the
// /grades/ hub pattern so AIO engines treat both peer hubs symmetrically
// (same KG node structure, same dedupe behavior).
const pageGraph = buildPillarGraph({
  name: "Titanium Standards & Certifications",
  description: "Industry standards and certifications for titanium materials, manufacturing, and quality assurance.",
  url: listUrl,
  collectionKey: "standards",
  locale,
  about: SITE_ABOUT_TOPICS,
  items: entries.map((e: any) => ({
    name: e.data.title,
    description: e.data.description,
    url: siteConfig.url + "/standards/" + e.id + "/",
  })),
}, siteConfig);
---
<EntityPillar
  collectionName="standards"
  pageTitle="Titanium Standards & Certifications"
  pageDescription="Industry standards and certifications for titanium materials, manufacturing, and quality assurance."
  locale={locale}
  path="/standards/"
  groupBy="issuingBody"
  pageGraph={pageGraph}
/>
