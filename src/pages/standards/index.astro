---
import EntityPillar from "../_shared/_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildCollectionPageSchema, buildItemListSchema } from "../../lib/schema";
import { resolveRoute } from "../../i18n/routes";
import { siteConfig } from "../../config/site.config";
import type { Locale } from "../../lib/site-config";
const locale = (Astro.currentLocale || "en") as Locale;

const entries = (await getCollection("standards"))
  .filter((e: any) => e.data.locale === locale)
  .sort((a: any, b: any) => a.data.order - b.data.order);

const listUrl = siteConfig.url + resolveRoute(locale, "/standards/");
const collectionSchema = buildCollectionPageSchema({
  name: "Titanium Standards & Certifications",
  description: "Industry standards and certifications for titanium materials, manufacturing, and quality assurance.",
  url: listUrl,
  numberOfItems: entries.length,
});
const itemListSchema = entries.length > 0 ? buildItemListSchema({
  itemType: "DefinedTerm",
  numberOfItems: entries.length,
  url: listUrl,
  itemListElement: entries.map((e: any) => ({
    name: e.data.title,
    description: e.data.description,
    url: siteConfig.url + resolveRoute(locale, "/standards/" + e.id + "/"),
  })),
}) : null;
const schemas = [collectionSchema, itemListSchema].filter(
  (s): s is NonNullable<typeof s> => s !== null,
);
---
<EntityPillar
  collectionName="standards"
  pageTitle="Titanium Standards & Certifications"
  pageDescription="Industry standards and certifications for titanium materials, manufacturing, and quality assurance."
  locale={locale}
  path="/standards/"
  jsonLd={schemas}
/>
