---
import MarketingLayout from "../../../layouts/MarketingLayout.astro";
import { getCollection, render } from "astro:content";
import { t } from "../../../i18n/ui";
import { resolveRoute } from "../../../i18n/routes";
import { siteConfig } from "../../../config/site.config";
import { buildTechArticleSchema } from "../../../lib/schema";

export async function getStaticPaths() {
  const entries = await getCollection("cases");
  return entries.filter((e: any) => e.data.locale === "en").map((e: any) => ({
    params: { slug: e.id.replace(/\.md$/, "") },
    props: { entry: e, locale: "en" as const },
  }));
}

const { entry, locale } = Astro.props as { entry: any; locale: "en" };
const data = entry.data;
const pageUrl = siteConfig.url + resolveRoute(locale, `/knowledge/cases/${entry.id}/`);
const ts = buildTechArticleSchema({
  headline: data.title,
  description: data.description,
  datePublished: new Date().toISOString(),
  keywords: ["case-study", data.industry, data.material, ...data.processes],
  url: pageUrl,
  inLanguage: locale,
});
const { Content } = await render(entry);

const industryLabels: Record<string, string> = {
  aerospace: "Aerospace",
  medical: "Medical",
  semiconductor: "Semiconductor",
  industrial: "Industrial",
};
const industryColors: Record<string, string> = {
  aerospace: "var(--color-brand-primary)",
  medical: "#2d6a9f",
  semiconductor: "#4a4a6a",
  industrial: "#6a4a4a",
};
---

<MarketingLayout title={data.title} description={data.description} locale={locale} path={`/knowledge/cases/${entry.id}/`} jsonLd={ts}>
<article class="case-detail container py-16">
<header class="case-hdr">
<span class="case-badge" style={`background: ${industryColors[data.industry] || 'var(--color-bg-tertiary)'}`}>
{industryLabels[data.industry] || data.industry}
</span>
<h1 class="case-title">{data.title}</h1>
<p class="case-app">{data.application}</p>
<p class="case-desc">{data.description}</p>
<div class="case-tags">
{data.material && <span class="case-tag">{data.material}</span>}
{data.processes?.map((p: string) => <span class="case-tag">{p.replace(/-/g," ")}</span>)}
{data.surfaceFinish && <span class="case-tag">{data.surfaceFinish}</span>}
{data.standards?.map((s: string) => <span class="case-tag">{s.toUpperCase()}</span>)}
</div>
</header>

<section class="case-narrative">
<div class="case-narrative__block case-challenge">
<h2>Challenge</h2>
<p>{data.challenge}</p>
</div>
<div class="case-narrative__block case-solution">
<h2>Solution</h2>
<p>{data.solution}</p>
</div>
<div class="case-narrative__block case-result">
<h2>Result</h2>
<p>{data.result}</p>
</div>
</section>

{data.keyMetrics?.length > 0 && (
<section class="case-metrics">
<h2>Key Metrics</h2>
<div class="case-metrics__grid">
{data.keyMetrics.map((m: any) => (
<div class="case-metric">
<span class="case-metric__label">{m.label}</span>
<div class="case-metric__values">
{m.before && <span class="case-metric__before">{m.before} →</span>}
<span class="case-metric__after">{m.after}</span>
{m.unit && <span class="case-metric__unit">{m.unit}</span>}
</div>
</div>
))}
</div>
</section>
)}

{data.lessonsLearned?.length > 0 && (
<section class="case-lessons">
<h2>Lessons Learned</h2>
<ul>
{data.lessonsLearned.map((l: string) => (
<li>{l}</li>
))}
</ul>
</section>
)}

<div class="case-content prose prose-gray dark:prose-invert max-w-none"><Content /></div>

{(data.relatedEvidence?.length > 0 || data.relatedComparisons?.length > 0 || data.relatedMaterials?.length > 0 || data.relatedStandards?.length > 0 || data.relatedServices?.length > 0 || data.processes?.length > 0) && (
<footer class="case-ftr">
{data.relatedEvidence?.length > 0 && (
<div class="case-rel">
<h3>Related Evidence & Technical Data</h3>
<ul>{data.relatedEvidence.map((s: string) => (<li><a href={resolveRoute(locale,"/knowledge/evidence/"+s+"/")}>{s.replace(/-/g," ").replace(/\b\w/g,(c:string)=>c.toUpperCase())}</a></li>))}</ul>
</div>
)}
{data.processes?.length > 0 && (
<div class="case-rel">
<h3>Related Processes</h3>
<ul>{data.processes.map((p: string) => (<li><a href={resolveRoute(locale,"/knowledge/processes/"+p+"/")}>{p.replace(/-/g," ").replace(/\b\w/g,(c:string)=>c.toUpperCase())}</a></li>))}</ul>
</div>
)}
{data.relatedComparisons?.length > 0 && (
<div class="case-rel">
<h3>Related Comparisons</h3>
<ul>{data.relatedComparisons.map((s: string) => (<li><a href={resolveRoute(locale,"/compare/"+s+"/")}>{s.replace(/-/g," ").replace(/\b\w/g,(c:string)=>c.toUpperCase())}</a></li>))}</ul>
</div>
)}
{data.relatedMaterials?.length > 0 && (
<div class="case-rel">
<h3>Materials</h3>
<ul>{data.relatedMaterials.map((s: string) => (<li><a href={resolveRoute(locale,"/knowledge/materials/"+s+"/")}>{s.replace(/-/g," ").replace(/\b\w/g,(c:string)=>c.toUpperCase())}</a></li>))}</ul>
</div>
)}
{data.relatedStandards?.length > 0 && (
<div class="case-rel">
<h3>Standards</h3>
<ul>{data.relatedStandards.map((s: string) => (<li><a href={resolveRoute(locale,"/knowledge/standards/"+s+"/")}>{s.replace(/-/g," ").toUpperCase()}</a></li>))}</ul>
</div>
)}
{data.relatedServices?.length > 0 && (
<div class="case-rel">
<h3>Related Services</h3>
<ul>{data.relatedServices.map((s: string) => (<li><a href={resolveRoute(locale,"/services/"+s+"/")}>{s.replace(/-/g," ").replace(/\b\w/g,(c:string)=>c.toUpperCase())}</a></li>))}</ul>
</div>
)}
</footer>
)}
</article></MarketingLayout>
<style>
.case-badge{display:inline-block;font-size:.75rem;padding:.25rem .75rem;border-radius:var(--radius-full);color:#fff;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:var(--space-md)}.case-title{margin:0 0 var(--space-sm);font-size:clamp(1.75rem,3vw,2.5rem);color:var(--color-text-primary)}.case-app{margin:0 0 var(--space-xs);font-size:.85rem;color:var(--color-text-secondary);font-style:italic}.case-desc{margin:0 0 var(--space-md);color:var(--color-text-secondary);font-size:1.05rem;line-height:1.6}.case-tags{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:var(--space-md)}.case-tag{display:inline-block;padding:.2rem .6rem;border:1px solid var(--color-border);border-radius:var(--radius-full);font-size:.78rem;color:var(--color-text-secondary);background:var(--color-bg-tertiary)}.case-narrative{display:grid;gap:var(--space-lg);margin-top:var(--space-xl)}.case-narrative__block{padding:var(--space-lg);border:1px solid var(--color-border);border-radius:var(--radius-lg)}.case-narrative__block h2{margin:0 0 var(--space-sm);font-size:1.15rem;color:var(--color-text-primary)}.case-narrative__block p{margin:0;color:var(--color-text-secondary);line-height:1.7;font-size:.95rem}.case-challenge{border-left:4px solid #c0392b}.case-solution{border-left:4px solid var(--color-brand-primary)}.case-result{border-left:4px solid #27ae60}.case-metrics{margin-top:var(--space-xl)}.case-metrics h2{font-size:1.25rem;margin-bottom:var(--space-md);color:var(--color-text-primary)}.case-metrics__grid{display:grid;gap:var(--space-md);grid-template-columns:repeat(auto-fill,minmax(260px,1fr))}.case-metric{padding:var(--space-md);border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-bg-secondary)}.case-metric__label{display:block;font-size:.75rem;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:.03em;margin-bottom:var(--space-xs)}.case-metric__values{display:flex;align-items:baseline;gap:.4rem;flex-wrap:wrap}.case-metric__before{font-size:.8rem;color:var(--color-text-secondary);text-decoration:line-through}.case-metric__after{font-size:1.25rem;font-weight:700;color:var(--color-brand-primary);font-family:var(--font-mono,monospace)}.case-metric__unit{font-size:.85rem;color:var(--color-text-secondary)}.case-lessons{margin-top:var(--space-xl);padding:var(--space-lg);border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-bg-secondary)}.case-lessons h2{font-size:1.25rem;margin:0 0 var(--space-md);color:var(--color-text-primary)}.case-lessons ul{margin:0;padding:0;list-style:none;display:grid;gap:var(--space-sm)}.case-lessons li{padding:var(--space-sm) var(--space-sm) var(--space-sm) var(--space-lg);position:relative;color:var(--color-text-secondary);font-size:.9rem;line-height:1.5;border-bottom:1px solid var(--color-border)}.case-lessons li:last-child{border-bottom:none}.case-lessons li::before{content:"\u2713";position:absolute;left:0;color:var(--color-brand-primary);font-weight:700}.case-content{margin-top:var(--space-xl)}.case-ftr{margin-top:var(--space-2xl);padding-top:var(--space-xl);border-top:1px solid var(--color-border)}.case-rel{margin-bottom:var(--space-lg)}.case-rel h3{margin:0 0 var(--space-sm);font-size:1rem;color:var(--color-text-primary)}.case-rel ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.5rem}.case-rel li a{display:inline-block;padding:.2rem .6rem;border:1px solid var(--color-border);border-radius:var(--radius-full);font-size:.8rem;color:var(--color-text-secondary);text-decoration:none}.case-rel li a:hover{border-color:var(--color-brand-primary);color:var(--color-brand-primary)}</style>

