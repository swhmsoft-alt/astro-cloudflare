---
import EntityPillar from "../_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildCollectionPageSchema, buildItemListSchema } from "../../../lib/schema";
import { resolveRoute } from "../../../i18n/routes";
import { siteConfig } from "../../../config/site.config";
import type { Locale } from "../../../lib/site-config";
const locale = (Astro.currentLocale || "en") as Locale;

const entries = (await getCollection("materials"))
  .filter((e: any) => e.data.locale === locale)
  .sort((a: any, b: any) => a.data.order - b.data.order);

const listUrl = siteConfig.url + resolveRoute(locale, "/knowledge/materials/");
const collectionSchema = buildCollectionPageSchema({
  name: "Titanium Materials Guide",
  description: "Comprehensive technical specifications and guides for all titanium grades and alloys.",
  url: listUrl,
  numberOfItems: entries.length,
});
const itemListSchema = entries.length > 0 ? buildItemListSchema({
  itemType: "DefinedTerm",
  numberOfItems: entries.length,
  url: listUrl,
  itemListElement: entries.map((e: any) => ({
    name: e.data.title,
    description: e.data.description,
    url: siteConfig.url + resolveRoute(locale, `/knowledge/materials/${e.id}/`),
  })),
}) : null;
const schemas = [collectionSchema, itemListSchema].filter(Boolean);
---
<EntityPillar
  collectionName="materials"
  pageTitle="Titanium Materials Guide"
  pageDescription="Comprehensive technical specifications and guides for all titanium grades and alloys. Compare properties, machinability, and applications."
  locale={locale}
  path="/knowledge/materials/"
  jsonLd={schemas}
/>
