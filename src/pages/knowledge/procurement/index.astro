---
import MarketingLayout from "../../../layouts/MarketingLayout.astro";
import { getCollection } from "astro:content";
import { resolveRoute } from "../../../i18n/routes";
import { siteConfig } from "../../../config/site.config";
import { buildCollectionPageSchema, buildItemListSchema } from "../../../lib/schema";
import type { Locale } from "../../../lib/site-config";

const locale = (Astro.currentLocale || "en") as Locale;

const entries = (await getCollection("procurement"))
  .filter((entry: any) => entry.data.locale === locale)
  .sort((a: any, b: any) => a.data.order - b.data.order);

const listUrl = siteConfig.url + resolveRoute(locale, "/knowledge/procurement/");
const collectionSchema = buildCollectionPageSchema({
  name: "Titanium Procurement Guides",
  description: "Procurement and purchasing guides for titanium components.",
  url: listUrl, numberOfItems: entries.length,
});
const itemListSchema = entries.length > 0 ? buildItemListSchema({
  itemType: "TechArticle", numberOfItems: entries.length, url: listUrl,
  itemListElement: entries.map((e: any) => ({
    name: e.data.title, description: e.data.description,
    url: siteConfig.url + resolveRoute(locale, `/knowledge/procurement/${e.id}/`),
  })),
}) : null;
const schemas = [collectionSchema, itemListSchema].filter((s): s is NonNullable<typeof s> => s !== null);
---
<MarketingLayout
  title="Titanium Procurement Guides"
  description="Procurement and purchasing guides for titanium components — RFQ best practices, supplier qualification, material certification, lead times, and commercial terms."
  locale={locale} path="/knowledge/procurement/" jsonLd={schemas}
>
  <section class="container py-16">
    <header class="section-head">
      <p class="section-head__eyebrow">Procurement</p>
      <h1 class="section-head__title">Titanium Component Procurement</h1>
      <p class="section-head__lead">
        Practical procurement guides for titanium machined components — from RFQ preparation and supplier qualification to material certification, lead time planning, and commercial terms.
      </p>
    </header>
    <div class="procurement-grid">
      {entries.length === 0 && (<p>Procurement guides coming soon.</p>)}
      {entries.map((entry: any) => {
        const slug = entry.id;
        return (
          <a href={resolveRoute(locale, `/knowledge/procurement/${slug}/`)} class="procurement-card">
            {entry.data.procurementCategory && <div class="procurement-card__badge">{entry.data.procurementCategory}</div>}
            <h2 class="procurement-card__title">{entry.data.title}</h2>
            <p class="procurement-card__description">{entry.data.description}</p>
            {entry.data.quickAnswer && <p class="procurement-card__qa">{entry.data.quickAnswer}</p>}
            <span class="procurement-card__cta">Read guide &rarr;</span>
          </a>
        );
      })}
    </div>
  </section>
</MarketingLayout>
<style>
.procurement-grid{display:grid;gap:var(--space-lg);grid-template-columns:1fr;margin-top:var(--space-xl);max-width:56rem}
.procurement-card{display:block;padding:var(--space-lg);border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-bg-primary);text-decoration:none;transition:all .2s ease}
.procurement-card:hover{border-color:var(--color-brand-primary);transform:translateY(-2px)}
.procurement-card__badge{display:inline-block;font-size:.7rem;padding:.2rem .6rem;border-radius:var(--radius-full);background:var(--color-bg-tertiary);color:var(--color-text-secondary);font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:var(--space-sm)}
.procurement-card__title{margin:0 0 var(--space-sm);font-size:1.2rem;color:var(--color-text-primary)}
.procurement-card__description{margin:0;color:var(--color-text-secondary);font-size:.9rem;line-height:1.6}
.procurement-card__qa{margin:var(--space-sm) 0 0;padding:var(--space-sm);border-left:3px solid var(--color-brand-primary);background:var(--color-bg-secondary);font-size:.85rem;color:var(--color-text-secondary);line-height:1.5}
.procurement-card__cta{display:inline-block;margin-top:var(--space-md);color:var(--color-brand-primary);font-weight:600;font-size:.9rem}
</style>
