---
import EntityPillar from "../_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildCollectionPageSchema, buildItemListSchema } from "../../../lib/schema";
import { resolveRoute } from "../../../i18n/routes";
import { siteConfig } from "../../../config/site.config";
import type { Locale } from "../../../lib/site-config";
const locale = (Astro.currentLocale || "en") as Locale;

const entries = (await getCollection("equipment"))
  .filter((e: any) => e.data.locale === locale)
  .sort((a: any, b: any) => a.data.order - b.data.order);

const listUrl = siteConfig.url + resolveRoute(locale, "/knowledge/equipment/");
const collectionSchema = buildCollectionPageSchema({
  name: "Titanium Manufacturing Equipment",
  description: "Comprehensive technical specs for titanium manufacturing equipment.",
  url: listUrl, numberOfItems: entries.length,
});
const itemListSchema = entries.length > 0 ? buildItemListSchema({
  itemType: "Product", numberOfItems: entries.length, url: listUrl,
  itemListElement: entries.map((e: any) => ({
    name: e.data.title, description: e.data.description,
    url: siteConfig.url + resolveRoute(locale, `/knowledge/equipment/${e.id}/`),
  })),
}) : null;
const schemas = [collectionSchema, itemListSchema].filter((s): s is NonNullable<typeof s> => s !== null);
---
<EntityPillar
  collectionName="equipment"
  pageTitle="Titanium Manufacturing Equipment"
  pageDescription="Technical specifications and capabilities of equipment used for precision titanium manufacturing: 5-axis machining centres, Swiss-type lathes, wire EDM machines, DMLS systems, CMM inspection, and vacuum furnaces."
  locale={locale} path="/knowledge/equipment/" jsonLd={schemas}
/>
