---
import EntityPillar from "../_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildCollectionPageSchema, buildItemListSchema } from "../../../lib/schema";
import { resolveRoute } from "../../../i18n/routes";
import { siteConfig } from "../../../config/site.config";
import type { Locale } from "../../../lib/site-config";
const locale = (Astro.currentLocale || "en") as Locale;

const entries = (await getCollection("surfaceFinishes"))
  .filter((e: any) => e.data.locale === locale)
  .sort((a: any, b: any) => a.data.order - b.data.order);

const listUrl = siteConfig.url + resolveRoute(locale, "/knowledge/surface-finishes/");
const collectionSchema = buildCollectionPageSchema({
  name: "Titanium Surface Finishes",
  description: "Surface treatment options for titanium components.",
  url: listUrl, numberOfItems: entries.length,
});
const itemListSchema = entries.length > 0 ? buildItemListSchema({
  itemType: "TechArticle", numberOfItems: entries.length, url: listUrl,
  itemListElement: entries.map((e: any) => ({
    name: e.data.title, description: e.data.description,
    url: siteConfig.url + resolveRoute(locale, `/knowledge/surface-finishes/${e.id}/`),
  })),
}) : null;
const schemas = [collectionSchema, itemListSchema].filter((s): s is NonNullable<typeof s> => s !== null);
---
<EntityPillar
  collectionName="surfaceFinishes"
  pageTitle="Titanium Surface Finishes"
  pageDescription="Surface treatment options for titanium components: anodizing, bead blasting, passivation, electropolishing, mechanical polishing, chemical etching, and PVD coating."
  locale={locale} path="/knowledge/surface-finishes/" jsonLd={schemas}
/>
