---
import EntityPillar from "../_shared/_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildCollectionPageSchema, buildItemListSchema } from "../../lib/schema";
import { resolveRoute } from "../../i18n/routes";
import { siteConfig } from "../../config/site.config";
import type { Locale } from "../../config/site.config";
const locale = (Astro.currentLocale || "en") as Locale;

const entries = (await getCollection("surfaceFinishes"))
  .filter((e: any) => e.data.locale === locale)
  .sort((a: any, b: any) => a.data.order - b.data.order);

const listUrl = siteConfig.url + resolveRoute(locale, "/finishes/");
const collectionSchema = buildCollectionPageSchema({
  name: "Titanium Surface Finishes Guide",
  description: "Complete guide to titanium surface treatments: anodizing, passivation, polishing, bead blasting, and PVD coating.",
  url: listUrl,
  numberOfItems: entries.length,
});
const itemListSchema = entries.length > 0 ? buildItemListSchema({
  itemType: "TechArticle",
  numberOfItems: entries.length,
  url: listUrl,
  itemListElement: entries.map((e: any) => ({
    name: e.data.title,
    description: e.data.description,
    url: siteConfig.url + resolveRoute(locale, "/finishes/" + e.id + "/"),
  })),
}) : null;
const schemas = [collectionSchema, itemListSchema].filter(
  (s): s is NonNullable<typeof s> => s !== null,
);
---
<EntityPillar
  collectionName="surfaceFinishes"
  pageTitle="Titanium Surface Finishes Guide"
  pageDescription="Complete guide to titanium surface treatments: anodizing, passivation, polishing, bead blasting, and PVD coating."
  locale={locale}
  path="/finishes/"
  jsonLd={schemas}
/>
