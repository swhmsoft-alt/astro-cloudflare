---
import EntityPillar from "../_shared/_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildCollectionPageSchema, buildItemListSchema } from "../../lib/schema";
import { resolveRoute } from "../../i18n/routes";
import { siteConfig } from "../../config/site.config";
import type { Locale } from "../../config/site.config";
const locale = (Astro.currentLocale || "en") as Locale;
const entries = (await getCollection("procurement")).filter((e: any) => e.data.locale === locale).sort((a: any, b: any) => (a.data.order || 0) - (b.data.order || 0));
const listUrl = siteConfig.url + resolveRoute(locale, "/procurement/");
const collectionSchema = buildCollectionPageSchema({ name: "Titanium Procurement Guides", description: "RFQ preparation, certifications, lead times, inspection, and supplier decisions for titanium component procurement.", url: listUrl, numberOfItems: entries.length });
const itemListSchema = entries.length > 0 ? buildItemListSchema({ itemType: "DefinedTerm", numberOfItems: entries.length, url: listUrl, itemListElement: entries.map((e: any) => ({ name: e.data.title, description: e.data.description, url: siteConfig.url + resolveRoute(locale, "/procurement/" + e.id + "/") })) }) : null;
const schemas = [collectionSchema, itemListSchema].filter((s): s is NonNullable<typeof s> => s !== null);
---
<EntityPillar collectionName="procurement" pageTitle="Titanium Procurement Guides" pageDescription="RFQ preparation, certifications, lead times, inspection, and supplier decisions for titanium component procurement." locale={locale} path="/procurement/" jsonLd={schemas} />
