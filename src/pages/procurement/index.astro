---
import EntityPillar from "../_shared/_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildPillarGraph } from "../../lib/schema";
import { siteConfig } from "../../config/site.config";
const locale = "en";
const entries = (await getCollection("procurement")).filter((e: any) => e.data.locale === locale).sort((a: any, b: any) => (a.data.order || 0) - (b.data.order || 0));
const listUrl = siteConfig.url + "/procurement/";
const pageGraph = buildPillarGraph({
  name: "Titanium Procurement Guides",
  description: "RFQ preparation, certifications, lead times, inspection, and supplier decisions for titanium component procurement.",
  url: listUrl,
  collectionKey: "procurement",
  locale,
  items: entries.map((e: any) => ({
    name: e.data.title,
    description: e.data.description,
    url: siteConfig.url + "/procurement/" + e.id + "/",
  })),
}, siteConfig);
---
<EntityPillar collectionName="procurement" pageTitle="Titanium Procurement Guides" pageDescription="RFQ preparation, certifications, lead times, inspection, and supplier decisions for titanium component procurement." locale={locale} path="/procurement/" pageGraph={pageGraph}>
  <nav slot="hubIntro" class="hub-featured" aria-label="Featured procurement reference">
    <h2>Featured Procurement Reference</h2>
    <ul>
      <li><a href="/procurement/coa-vs-coc/">COA vs COC</a> — when to request a Certificate of Analysis (composition data) vs a Certificate of Compliance (conformance statement) for titanium mill shipments, and how to recognise when an MTR is the right document instead.</li>
    </ul>
  </nav>
</EntityPillar>
