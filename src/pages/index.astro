---
import M from"../layouts/MarketingLayout.astro";
import H from"../components/Hero.astro";
import Q from"../components/FAQ.astro";
import C from"../components/CTA.astro";
import K from"../components/CapabilityShowcase.astro";

import{t}from"../i18n/ui";
import{resolveRoute}from"../i18n/routes";
import{siteConfig as s}from"../config/site.config";
import type{Locale as L}from"../lib/site-config";
import J from"../components/seo/JsonLd.astro";
import{buildWebSiteSchema as ws,buildOrganizationSchema as o,buildFAQSchema as q,buildBreadcrumbSchema as b}from"../lib/schema";
const lc=(Astro.currentLocale||'en')as L;
const k=[{t:'Materials',d:'Complete specs for all grades.',h:'/knowledge/materials/',c:'6+'},{t:'Processes',d:'CNC,5-axis,turning,EDM,additive.',h:'/knowledge/processes/',c:'7'},{t:'Industries',d:'Aerospace,medical,semi,robotics,energy.',h:'/knowledge/industries/',c:'5'},{t:'Standards',d:'ASTM,AS9100D,NADCAP,ISO.',h:'/knowledge/standards/',c:'6'},{t:'Finishes',d:'Anodizing,passivation,polishing.',h:'/knowledge/surface-finishes/',c:'4'},{t:'Equipment',d:'Mazak,DMG Mori,wire EDM.',h:'/knowledge/equipment/',c:'3+'}];
const x=[{t:'Titanium CNC Machining',d:'Precision CNC to 0.001mm.',h:'/services/titanium-cnc-machining/'},{t:'5-Axis Machining',d:'Complex geometries.',h:'/services/5-axis-titanium-machining/'},{t:'Milling & Turning',d:'High-precision parts.',h:'/services/titanium-milling/'}];
const qq=[{q:'What grades?',a:'Grade 1,2,5,23.'},{q:'Lead time?',a:'2-4 weeks,prototypes 5-10 days.'},{q:'Formats?',a:'STEP,IGES,STL,DXF,PDF.'},{q:'DFM?',a:'Yes,every RFQ includes free DFM.'},{q:'Certs?',a:'AS9100D,ISO 13485,NADCAP.'}];
const formattedQq=qq.map(i=>({question:i.q,answer:i.a}));
const br=[{label:'Home',href:s.url+'/'}];
const w=ws(s);const or=o(s);const fq=q(formattedQq);const bc=b(br);
---
<M title={t(lc,"hero.title")} description={s.description} locale={lc} path="/">
<J schema={[w,or,fq,bc]}/>
<H variant="centered" eyebrow="Titanium Manufacturing Knowledge Hub" headline={t(lc,"hero.title")} subheadline={t(lc,"hero.subtitle")} primaryCta={{label:"Explore Knowledge Base",href:"/knowledge/"}} secondaryCta={{label:"Request a Quote",href:"/rfq/request-quote/"}} locale={lc}/>
<K/>

<section class="c py-16"><header class="section-head"><p class="section-head__eyebrow">Knowledge Base</p><h2 class="section-head__title">Your Complete Titanium Manufacturing Reference</h2></header><div class="hg">{k.map(i=><a href={resolveRoute(lc,i.h)} class="hc"><div class="hch"><h3 class="hct">{i.t}</h3><span class="hcc">{i.c}</span></div><p class="hcd">{i.d}</p><span class="hcta">Browse &rarr;</span></a>)}</div></section>
<section class="c py-16"><header class="section-head"><p class="section-head__eyebrow">Services</p><h2 class="section-head__title">From Prototype to Production</h2></header><div class="sg">{x.map(i=><a href={resolveRoute(lc,i.h)} class="sc"><h3 class="sct">{i.t}</h3><p class="scd">{i.d}</p><span class="scta">Get quote &rarr;</span></a>)}</div><div class="ca"><a href={resolveRoute(lc,"/rfq/upload-drawing/")} class="cc ccp"><span>&#x1F4C4;</span><span class="cct">Upload Drawing</span><span class="ccd">STEP,IGES,STL,DXF,PDF</span></a><a href={resolveRoute(lc,"/rfq/dfm-review/")} class="cc"><span>&#x1F527;</span><span class="cct">Free DFM Review</span><span class="ccd">Design for Manufacturing feedback</span></a><a href={resolveRoute(lc,"/rfq/prototype-request/")} class="cc"><span>&#x26A1;</span><span class="cct">Prototype Request</span><span class="ccd">As fast as 5 business days</span></a></div></section>
<section class="c py-16"><header class="section-head"><p class="section-head__eyebrow">Industries</p><h2 class="section-head__title">Titanium Components for Critical Applications</h2></header><div class="ig"><div class="ic"><h3>Aerospace</h3><p>Airframe,engine,landing gear</p></div><div class="ic"><h3>Medical</h3><p>Implants,instruments</p></div><div class="ic"><h3>Semiconductor</h3><p>Vacuum chambers,wafer handling</p></div><div class="ic"><h3>Robotics</h3><p>Lightweight parts</p></div><div class="ic"><h3>Energy</h3><p>Oil & gas,renewable</p></div></div></section>
<Q title="Titanium Manufacturing FAQ" items={formattedQq}/>
<C eyebrow="Start Your Project" title="Ready to Manufacture?" content="Upload your drawing. DFM + quote within 24h." ctaText="Upload Drawing &rarr;" ctaHref="/rfq/upload-drawing/" secondaryText="Request a Quote" secondaryHref="/rfq/request-quote/" locale={lc}/>
</M>
<style>.hg{display:grid;gap:var(--space-lg);grid-template-columns:repeat(auto-fill,minmax(320px,1fr));margin-top:var(--space-xl)}.hc{display:block;padding:var(--space-lg);border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-bg-primary);text-decoration:none;transition:all .2s ease}.hc:hover{border-color:var(--color-brand-primary);transform:translateY(-2px)}.hch{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-sm)}.hct{margin:0 0 var(--space-sm);font-size:1.15rem;color:var(--color-text-primary)}.hcc{font-size:.75rem;padding:.2rem .6rem;border-radius:var(--radius-full);background:var(--color-bg-tertiary);color:var(--color-text-secondary);font-weight:600}.hcd{margin:0;color:var(--color-text-secondary);font-size:.9rem;line-height:1.6}.hcta{display:inline-block;margin-top:var(--space-md);color:var(--color-brand-primary);font-weight:600}.sg{display:grid;gap:var(--space-lg);grid-template-columns:repeat(auto-fill,minmax(300px,1fr));margin-top:var(--space-xl);max-width:60rem;margin-inline:auto}.sc{display:block;padding:var(--space-lg);border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-bg-primary);text-decoration:none}.sc:hover{border-color:var(--color-brand-primary);transform:translateY(-2px)}.sct{margin:0 0 var(--space-sm);font-size:1.1rem;color:var(--color-text-primary)}.scd{margin:0;color:var(--color-text-secondary);font-size:.9rem;line-height:1.6}.scta{display:inline-block;margin-top:var(--space-md);color:var(--color-brand-primary);font-weight:600}.ca{display:grid;gap:var(--space-lg);grid-template-columns:repeat(auto-fill,minmax(280px,1fr));margin-top:var(--space-2xl);max-width:56rem;margin-inline:auto}.cc{display:grid;gap:var(--space-sm);padding:var(--space-lg);border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-bg-primary);text-decoration:none}.cc:hover{border-color:var(--color-brand-primary);transform:translateY(-2px)}.ccp{border-color:var(--color-brand-primary);background:var(--color-bg-secondary)}.cct{font-size:1.1rem;font-weight:700;color:var(--color-text-primary)}.ccd{font-size:.875rem;color:var(--color-text-secondary);line-height:1.5;margin:0}.ig{display:grid;gap:var(--space-lg);grid-template-columns:repeat(auto-fill,minmax(280px,1fr));margin-top:var(--space-xl)}.ic{padding:var(--space-lg);border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-bg-primary)}.ic h3{margin:0 0 var(--space-sm);font-size:1.1rem;color:var(--color-text-primary)}.ic p{margin:0;color:var(--color-text-secondary);font-size:.9rem;line-height:1.6}</style>