---
import MarketingLayout from "../../../layouts/MarketingLayout.astro";
import { getCollection, render } from "astro:content";
import { resolveRoute } from "../../../i18n/routes";
import { siteConfig } from "../../../config/site.config";
import JsonLd from "../../../components/seo/JsonLd.astro";
import { buildBreadcrumbSchema, buildTechArticleSchema, buildFAQSchema } from "../../../lib/schema";

export async function getStaticPaths() {
  const entries = await getCollection("comparisons");
  return entries.filter((e: any) => e.data.locale).map((e: any) => ({
    params: { slug: e.id, locale: e.data.locale },
    props: { entry: e, locale: e.data.locale },
  }));
}

const { entry, locale } = Astro.props as { entry: any; locale: "en" };
const data = entry.data;
const pageUrl = siteConfig.url + resolveRoute(locale, `/compare/${entry.id}/`);
const breadcrumbs = [
  { label: "Home", href: siteConfig.url + "/" },
  { label: "Comparisons", href: siteConfig.url + "/compare/" },
  { label: data.title, href: pageUrl },
];
const ts = buildTechArticleSchema({
  headline: data.title,
  description: data.description,
  datePublished: new Date().toISOString(),
  keywords: ["comparison", data.comparisonType, data.entityA, data.entityB],
  url: pageUrl,
  inLanguage: locale,
});
const bc = buildBreadcrumbSchema(breadcrumbs);
const fq = data.faqs?.length > 0 ? buildFAQSchema(data.faqs) : null;
const schemas = [bc, ts, ...(fq ? [fq] : [])];
const { Content } = await render(entry);
---

<MarketingLayout title={data.title} description={data.description} locale={locale} path={`/compare/${entry.id}/`}>
<JsonLd schema={schemas} />
<article class="cmp-detail container py-16">
<nav class="cmp-bc"><a href={resolveRoute(locale,"/")}>Home</a> / <a href={resolveRoute(locale,"/compare/")}>Comparisons</a> / <span>{data.title}</span></nav>
<header class="cmp-hdr">
<h1 class="cmp-title">{data.title}</h1>
<p class="cmp-desc">{data.description}</p>
<div class="cmp-ent"><span class="cmp-ea">{data.entityA}</span><span class="cmp-vs">vs</span><span class="cmp-eb">{data.entityB}</span></div>
</header>
<section class="cmp-qa"><h2>Quick Answer</h2><p>{data.quickAnswer}</p></section>
<div class="cmp-content prose prose-gray dark:prose-invert max-w-none"><Content /></div>
{data.relatedMaterials?.length>0||data.relatedProcesses?.length>0||data.relatedStandards?.length>0?<footer class="cmp-ftr">
{data.relatedStandards?.length>0&&<div><h3>Related Standards</h3><ul>{data.relatedStandards.map((s:string)=>(<li><a href={resolveRoute(locale,"/knowledge/standards/"+s+"/")}>{s.replace(/-/g," ").toUpperCase()}</a></li>))}</ul></div>}
</footer>:null}
</article></MarketingLayout>
<style>
.cmp-bc{font-size:.85rem;color:var(--color-text-secondary);margin-bottom:var(--space-md)}.cmp-bc a{color:var(--color-brand-primary);text-decoration:none}.cmp-hdr{margin-bottom:var(--space-xl)}.cmp-title{margin:0 0 var(--space-sm);font-size:clamp(1.75rem,3vw,2.5rem);color:var(--color-text-primary)}.cmp-desc{margin:0 0 var(--space-md);color:var(--color-text-secondary);font-size:1.05rem;line-height:1.6}.cmp-ent{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}.cmp-ea,.cmp-eb{font-size:.9rem;font-weight:600;color:var(--color-text-primary);background:var(--color-bg-tertiary);padding:.3rem .7rem;border-radius:var(--radius-md)}.cmp-vs{font-size:.8rem;font-weight:700;color:var(--color-brand-primary)}.cmp-qa{margin-bottom:var(--space-xl);padding:var(--space-lg);border:1px solid var(--color-brand-primary);border-radius:var(--radius-lg);background:var(--color-bg-secondary)}.cmp-qa h2{margin:0 0 var(--space-sm);font-size:1.1rem;color:var(--color-text-primary)}.cmp-qa p{margin:0;color:var(--color-text-secondary);line-height:1.6}.cmp-content{margin-top:var(--space-xl)}.cmp-ftr{margin-top:var(--space-2xl);padding-top:var(--space-xl);border-top:1px solid var(--color-border)}.cmp-ftr h3{margin:0 0 var(--space-sm);font-size:1rem;color:var(--color-text-primary)}.cmp-ftr ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.5rem}.cmp-ftr li a{display:inline-block;padding:.2rem .6rem;border:1px solid var(--color-border);border-radius:var(--radius-full);font-size:.8rem;color:var(--color-text-secondary);text-decoration:none}.cmp-ftr li a:hover{border-color:var(--color-brand-primary);color:var(--color-brand-primary)}</style>
