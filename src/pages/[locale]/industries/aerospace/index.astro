---

export async function getStaticPaths(){return ["en","de","ja","fr","es","pt","it","ko","nl","pl","ru","ar","pt-br","tr","cs","sv"].map(function(l){return{params:{locale:l},props:{locale:l}}})}
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Hero from "../../../../components/hero/Hero.astro";
import CTA from "../../../../components/CTA.astro";
import { resolveRoute } from "../../../../i18n/routes";
import { siteConfig } from "../../../../config/site.config";
import type { Locale } from "../../../../lib/site-config";
import JsonLd from "../../../../components/seo/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildCollectionPageSchema,
} from "../../../../lib/schema";

const locale = (Astro.props.locale || "en") as Locale;

const listUrl = siteConfig.url + resolveRoute(locale, "/industries/aerospace/");

const spokePages = [
  {
    title: "Custom Machined Components",
    description:
      "Precision 5-axis machined titanium parts for airframes, engines, and landing gear systems.",
    href: "/services/aerospace-titanium-components/",
    cta: "View Aerospace Machining Service →",
  },
  {
    title: "Part Applications & Materials",
    description:
      "Detailed guide to titanium grades, applications, and specifications for common aerospace components.",
    href: "/industries/aerospace-titanium-parts/",
    cta: "Read Aerospace Parts Guide →",
  },
  {
    title: "Quality & Compliance",
    description:
      "AS9100D, NADCAP, ITAR compliant manufacturing with full material traceability and NDT capabilities.",
    href: "/standards/",
    cta: "View Certifications →",
  },
];

const breadcrumbSchema = buildBreadcrumbSchema([
  { label: "Home", href: siteConfig.url + "/" },
  {
    label: "Industries",
    href: siteConfig.url + "/industries/",
  },
  {
    label: "Aerospace",
    href: listUrl,
  },
]);

const collectionSchema = buildCollectionPageSchema({
  name: "Aerospace Titanium Manufacturing",
  description:
    "End-to-end titanium manufacturing solutions for aerospace. Precision machining, material expertise, and quality systems for flight-critical components.",
  url: listUrl,
  numberOfItems: spokePages.length,
});
---

<BaseLayout
  title="Aerospace Titanium Manufacturing & Machining Services"
  description="AS9100D certified titanium machining for aerospace. 5-axis CNC milling and turning of flight-critical components with full traceability and NADCAP accredited processes."
  locale={locale}
  path={"/industries/aerospace"}
>
  <JsonLd schema={[breadcrumbSchema, collectionSchema]} />
  <!-- Hero -->
  <Hero
    variant="centered"
    size="md"
    eyebrow="Aerospace Manufacturing"
    headline="Aerospace Titanium Manufacturing &amp; Machining"
    subheadline="Titanium is the material of choice for flight-critical aerospace components, where strength, weight, and corrosion resistance directly impact safety and performance. We provide end-to-end titanium manufacturing solutions for commercial aviation, defense, and space applications."
    primaryCta={{ label: "Browse Titanium Grades", href: "/grades/" }}
    secondaryCta={{ label: "View Aerospace Parts →", href: "/industries/aerospace-titanium-parts/" }}
    locale={locale}
  />

  <!-- Hub Cards: Solutions -->
  <section class="hub-cards container">
    <header class="section-head">
      <p class="section-head__eyebrow">Our Solutions for Aerospace</p>
      <h2 class="section-head__title">Complete Aerospace Titanium Capabilities</h2>
    </header>
    <div class="hub-cards__grid">
      {
        spokePages.map((page) => (
          <a href={resolveRoute(locale, page.href)} class="hub-card">
            <h3 class="hub-card__title">{page.title}</h3>
            <p class="hub-card__description">{page.description}</p>
            <span class="hub-card__cta">{page.cta}</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Industry Expertise -->
  <section class="expertise-section container">
    <header class="section-head">
      <p class="section-head__eyebrow">Aerospace Expertise</p>
      <h2 class="section-head__title">Trusted by Aerospace OEMs &amp; Tier 1 Suppliers</h2>
    </header>
    <div class="expertise-grid">
      <div class="expertise-item">
        <span class="expertise-icon">&#x1F4C8;</span>
        <h3>15+ Years Experience</h3>
        <p>Machining titanium for commercial, military, and space programs</p>
      </div>
      <div class="expertise-item">
        <span class="expertise-icon">&#x1F527;</span>
        <h3>Prototype to Production</h3>
        <p>Support from prototype through LRIP to full-rate production</p>
      </div>
      <div class="expertise-item">
        <span class="expertise-icon">&#x1F4CA;</span>
        <h3>Supply Chain Integration</h3>
        <p>Single-point management for machining, heat treat, finishing, NDT</p>
      </div>
      <div class="expertise-item">
        <span class="expertise-icon">&#x2699;&#xFE0F;</span>
        <h3>DFM Feedback</h3>
        <p>Free Design for Manufacturing review to reduce cost and improve quality</p>
      </div>
    </div>
  </section>

  <!-- Materials Table -->
  <section class="materials-section container">
    <header class="section-head">
      <p class="section-head__eyebrow">Aerospace Titanium Grades</p>
      <h2 class="section-head__title">Common Aerospace Titanium Alloys</h2>
    </header>
    <div class="materials-table-wrap">
      <table class="materials-table">
        <thead>
          <tr>
            <th>Alloy</th>
            <th>Applications</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Ti-6Al-4V (Grade 5)</td>
            <td>Most common aerospace grade — airframe structures, engine components, fasteners.</td>
          </tr>
          <tr>
            <td>Ti-5Al-5Mo-5V-3Cr (Ti-5553)</td>
            <td>High-strength structural components, landing gear beams, forged fittings.</td>
          </tr>
          <tr>
            <td>Ti-6Al-2Sn-4Zr-2Mo (Ti-6242)</td>
            <td>High-temperature engine components, compressor discs up to 540°C.</td>
          </tr>
          <tr>
            <td>Ti-3Al-2.5V (Grade 9)</td>
            <td>Hydraulic tubing, ducting, and fasteners for aircraft.</td>
          </tr>
          <tr>
            <td>Ti-10V-2Fe-3Al (Ti-10-2-3)</td>
            <td>High-strength forgings for landing gear and structural fittings.</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="materials-link">
      → <a href={resolveRoute(locale, "/grades/")}>Complete guide to all titanium materials</a>
    </p>
  </section>

  <!-- Certifications Badge Row -->
  <section class="certs-section container">
    <header class="section-head">
      <p class="section-head__eyebrow">Quality Systems</p>
      <h2 class="section-head__title">Certifications &amp; Compliance</h2>
    </header>
    <div class="certs-row">
      <span class="cert-badge">AS9100D</span>
      <span class="cert-badge">NADCAP</span>
      <span class="cert-badge">ITAR</span>
      <span class="cert-badge">DFARS</span>
      <span class="cert-badge">AS9102 FAI</span>
      <span class="cert-badge">NDT</span>
      <span class="cert-badge">CMM</span>
    </div>
  </section>

  <!-- Bottom CTA -->
  <CTA
  eyebrow="Neutral engineering reference"
  title="Explore Titanium Engineering Knowledge"
  content="Neutral, vendor-independent technical guidance on titanium applications, grades, and standards to support your engineering decisions."
  ctaText="Browse Titanium Grades"
  ctaHref="/grades/"
  secondaryText="Compare Materials"
  secondaryHref="/compare/"
  locale={locale}
/>
</BaseLayout>



<style>
  .hub-cards { padding-block: var(--space-xl) var(--space-3xl); }
  .hub-cards__grid {
    display: grid; gap: var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    margin-top: var(--space-xl);
  }
  .hub-card {
    display: block; padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-primary);
    text-decoration: none; transition: all 0.2s ease;
  }
  .hub-card:hover {
    border-color: var(--color-brand-primary);
    transform: translateY(-2px);
  }
  .hub-card__title { margin: 0 0 var(--space-sm); font-size: 1.15rem; color: var(--color-text-primary); }
  .hub-card__description { margin: 0; color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.6; }
  .hub-card__cta { display: inline-block; margin-top: var(--space-md); color: var(--color-brand-primary); font-weight: 600; }

  .expertise-section { padding-block: var(--space-xl) var(--space-3xl); }
  .expertise-grid {
    display: grid; gap: var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    margin-top: var(--space-xl);
  }
  .expertise-item { padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-secondary); }
  .expertise-icon { font-size: 1.75rem; display: block; margin-bottom: var(--space-sm); }
  .expertise-item h3 { margin: 0 0 var(--space-xs); font-size: 1rem; color: var(--color-text-primary); }
  .expertise-item p { margin: 0; color: var(--color-text-secondary); font-size: 0.875rem; line-height: 1.6; }

  .materials-section { padding-block: var(--space-xl) var(--space-3xl); }
  .materials-table-wrap { overflow-x: auto; margin-top: var(--space-xl); }
  .materials-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .materials-table th { text-align: left; padding: var(--space-sm) var(--space-md); border-bottom: 2px solid var(--color-border); color: var(--color-text-primary); font-weight: 600; }
  .materials-table td { padding: var(--space-sm) var(--space-md); border-bottom: 1px solid var(--color-border); color: var(--color-text-secondary); line-height: 1.5; }
  .materials-table td:first-child { font-weight: 600; color: var(--color-text-primary); white-space: nowrap; }
  .materials-link { margin-top: var(--space-md); text-align: center; color: var(--color-text-secondary); }
  .materials-link a { color: var(--color-brand-primary); font-weight: 600; }

  .certs-section { padding-block: var(--space-xl) var(--space-3xl); }
  .certs-row { display: flex; flex-wrap: wrap; gap: var(--space-md); justify-content: center; margin-top: var(--space-xl); }
  .cert-badge { display: inline-flex; align-items: center; padding: 0.5rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-full); background: var(--color-bg-primary); font-weight: 600; font-size: 0.85rem; color: var(--color-text-primary); }

  .section-head { text-align: center; }
  .section-head__eyebrow {
    display: inline-flex; align-items: center; margin: 0 auto var(--space-sm);
    padding: 0.35rem 0.9rem; border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--primary) 15%, transparent);
    background: color-mix(in srgb, var(--primary) 6%, transparent);
    text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.75rem;
    color: var(--primary); font-weight: 700; width: fit-content;
  }
  .section-head__title { margin: 0; font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text-primary); max-width: 36rem; margin-inline: auto; }
</style>


