---
import { buildLocalePaths } from "../../../../i18n/availability";
export async function getStaticPaths() {
  return buildLocalePaths("industries/semiconductor").map((l) => ({ params: { locale: l }, props: { locale: l } }));
}
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Hero from "../../../../components/hero/Hero.astro";
import CTA from "../../../../components/CTA.astro";
import { resolveRoute } from "../../../../i18n/routes";
import { siteConfig } from "../../../../config/site.config";
import type { Locale } from "../../../../lib/site-config";
import JsonLd from "../../../../components/seo/JsonLd.astro";
import { buildBreadcrumbSchema, buildCollectionPageSchema } from "../../../../lib/schema";
const locale = (Astro.props.locale || "en") as Locale;
const lu = siteConfig.url + resolveRoute(locale, "/industries/semiconductor/");
const sp = [{t:"Custom Semiconductor Titanium Parts",d:"Ultra-pure titanium components for semiconductor equipment.",h:"/services/semiconductor-titanium-parts/",c:"View Service →"},{t:"Semiconductor Applications",d:"Guide to titanium in semiconductor fabrication.",h:"/industries/semiconductor-manufacturing/",c:"Read Guide →"},{t:"Quality & Standards",d:"ISO 9001, ASTM B265, B348 compliant.",h:"/standards/",c:"View Standards →"}];
const bc = buildBreadcrumbSchema([{label:"Home",href:siteConfig.url+"/"},{label:"Industries",href:siteConfig.url+"/industries/"},{label:"Semiconductor",href:lu}]);
const cs = buildCollectionPageSchema({name:"Semiconductor Titanium Manufacturing",description:"Ultra-pure titanium components for semiconductor.",url:lu,numberOfItems:sp.length});
---
<BaseLayout title="Semiconductor Titanium Components & Manufacturing" description="Precision titanium machining for semiconductor equipment." locale={locale} path={"/industries/semiconductor"}>
<JsonLd schema={[bc, cs]} />
<Hero variant="centered" size="md" eyebrow="Semiconductor Equipment" headline="Titanium Manufacturing for Semiconductor" subheadline="Titanium is essential for UHV compatibility in semiconductor fabrication." primaryCta={{ label: "Browse Titanium Grades", href: "/grades/" }} secondaryCta={{label:"View Guide →",href:"/industries/semiconductor-manufacturing/"}} locale={locale} />
<section class="hub-cards container"><header class="section-head"><p class="section-head__eyebrow">Our Solutions</p><h2 class="section-head__title">Semiconductor Titanium Capabilities</h2></header><div class="hub-cards__grid">{sp.map((p)=>(<a href={resolveRoute(locale,p.h)} class="hub-card"><h3 class="hub-card__title">{p.t}</h3><p class="hub-card__description">{p.d}</p><span class="hub-card__cta">{p.c}</span></a>))}</div></section>
<section class="expertise-section container"><header class="section-head"><p class="section-head__eyebrow">Expertise</p><h2 class="section-head__title">Ultra-Pure Components</h2></header><div class="expertise-grid"><div class="expertise-item"><span class="expertise-icon">&#x1F300;</span><h3>UHV Compatibility</h3><p>Minimal outgassing</p></div><div class="expertise-item"><span class="expertise-icon">&#x2728;</span><h3>Ultra-Pure</h3><p>Cleanroom manufacturing</p></div><div class="expertise-item"><span class="expertise-icon">&#x1F4CD;</span><h3>Precision</h3><p>Tight tolerances</p></div><div class="expertise-item"><span class="expertise-icon">&#x1F3C6;</span><h3>Surface Finish</h3><p>Particle-free</p></div></div></section>
<section class="certs-section container"><header class="section-head"><p class="section-head__eyebrow">Quality</p><h2 class="section-head__title">Certifications</h2></header><div class="certs-row"><span class="cert-badge">ISO 9001</span><span class="cert-badge">ASTM B265</span><span class="cert-badge">UHV</span><span class="cert-badge">CMM</span></div></section>
<CTA
  eyebrow="Neutral engineering reference"
  title="Explore Titanium Engineering Knowledge"
  content="Neutral, vendor-independent technical guidance on titanium applications, grades, and standards to support your engineering decisions."
  ctaText="Browse Titanium Grades"
  ctaHref="/grades/"
  secondaryText="Compare Materials"
  secondaryHref="/compare/"
  locale={locale}
/>
</BaseLayout>
<style>
.hub-cards { padding-block: var(--space-xl) var(--space-3xl); }
.hub-cards__grid { display: grid; gap: var(--space-lg); grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); margin-top: var(--space-xl); }
.hub-card { display: block; padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-primary); text-decoration: none; }
.hub-card:hover { border-color: var(--color-brand-primary); transform: translateY(-2px); }
.hub-card__title { margin: 0 0 var(--space-sm); font-size: 1.15rem; color: var(--color-text-primary); }
.hub-card__description { margin: 0; color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.6; }
.hub-card__cta { display: inline-block; margin-top: var(--space-md); color: var(--color-brand-primary); font-weight: 600; }
.expertise-section { padding-block: var(--space-xl) var(--space-3xl); }
.expertise-grid { display: grid; gap: var(--space-lg); grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); margin-top: var(--space-xl); }
.expertise-item { padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-secondary); }
.expertise-icon { font-size: 1.75rem; display: block; margin-bottom: var(--space-sm); }
.expertise-item h3 { margin: 0 0 var(--space-xs); font-size: 1rem; color: var(--color-text-primary); }
.expertise-item p { margin: 0; color: var(--color-text-secondary); font-size: 0.875rem; line-height: 1.6; }
.certs-section { padding-block: var(--space-xl) var(--space-3xl); }
.certs-row { display: flex; flex-wrap: wrap; gap: var(--space-md); justify-content: center; margin-top: var(--space-xl); }
.cert-badge { display: inline-flex; padding: 0.5rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-full); background: var(--color-bg-primary); font-weight: 600; font-size: 0.85rem; color: var(--color-text-primary); }
.section-head { text-align: center; }
.section-head__eyebrow { display: inline-flex; padding: 0.35rem 0.9rem; border-radius: var(--radius-full); border: 1px solid color-mix(in srgb, var(--primary) 15%, transparent); background: color-mix(in srgb, var(--primary) 6%, transparent); font-size: 0.75rem; color: var(--primary); font-weight: 700; }
.section-head__title { margin: 0; font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text-primary); max-width: 36rem; margin-inline: auto; }
</style>

