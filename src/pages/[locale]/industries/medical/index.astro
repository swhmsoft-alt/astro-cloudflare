---
import { buildLocalePaths } from "../../../../i18n/availability";
export async function getStaticPaths() {
  return buildLocalePaths("industries/medical").map((l) => ({ params: { locale: l }, props: { locale: l } }));
}
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Hero from "../../../../components/hero/Hero.astro";
import CTA from "../../../../components/CTA.astro";
import { resolveRoute } from "../../../../i18n/routes";
import { siteConfig } from "../../../../config/site.config";
import type { Locale } from "../../../../lib/site-config";
import JsonLd from "../../../../components/seo/JsonLd.astro";
import { buildBreadcrumbSchema, buildCollectionPageSchema } from "../../../../lib/schema";

const locale = (Astro.props.locale || "en") as Locale;
const listUrl = siteConfig.url + resolveRoute(locale, "/industries/medical/");
const spokePages = [
  { title: "Custom Medical Titanium Components", description: "ISO 13485 certified CNC machining of titanium medical components.", href: "/services/medical-titanium-components/", cta: "View Medical Machining Service →" },
  { title: "Medical Device Applications & Materials", description: "Detailed guide to titanium grades for medical device manufacturing.", href: "/industries/medical-device/", cta: "Read Medical Device Guide →" },
  { title: "Quality & Regulatory Compliance", description: "ISO 13485, FDA QSR, EU MDR compliant manufacturing with traceability.", href: "/standards/iso-13485/", cta: "View Medical Certifications →" },
];
const bc = buildBreadcrumbSchema([{ label: "Home", href: siteConfig.url + "/" }, { label: "Industries", href: siteConfig.url + "/industries/" }, { label: "Medical", href: listUrl }]);
const cs = buildCollectionPageSchema({ name: "Medical Device Titanium Manufacturing", description: "ISO 13485 certified titanium manufacturing for medical devices.", url: listUrl, numberOfItems: spokePages.length });
---
<BaseLayout title="Medical Device Titanium Manufacturing & Machining Services" description="ISO 13485 certified titanium machining for medical devices." locale={locale} path={"/industries/medical"}>
<JsonLd schema={[bc, cs]} />
<Hero variant="centered" size="md" eyebrow="Medical Device Manufacturing" headline="Medical Titanium Manufacturing &amp; Machining" subheadline="Titanium is the preferred material for implantable medical devices. We provide ISO 13485 certified manufacturing." primaryCta={{ label: "Browse Titanium Grades", href: "/grades/" }} secondaryCta={{ label: "View Applications →", href: "/industries/medical-device/" }} locale={locale} />
<section class="hub-cards container"><header class="section-head"><p class="section-head__eyebrow">Our Solutions for Medical Device</p><h2 class="section-head__title">Complete Medical Titanium Capabilities</h2></header><div class="hub-cards__grid">{spokePages.map((p) => (<a href={resolveRoute(locale, p.href)} class="hub-card"><h3 class="hub-card__title">{p.title}</h3><p class="hub-card__description">{p.description}</p><span class="hub-card__cta">{p.cta}</span></a>))}</div></section>
<section class="expertise-section container"><header class="section-head"><p class="section-head__eyebrow">Medical Expertise</p><h2 class="section-head__title">Trusted by Medical Device OEMs</h2></header><div class="expertise-grid"><div class="expertise-item"><span class="expertise-icon">&#x1F489;</span><h3>ISO 13485 Certified</h3><p>QMS for medical device manufacturing</p></div><div class="expertise-item"><span class="expertise-icon">&#x1F3ED;</span><h3>Cleanroom Manufacturing</h3><p>Controlled environment for implantable devices</p></div><div class="expertise-item"><span class="expertise-icon">&#x1F4CB;</span><h3>Full Traceability</h3><p>MTRs, process records, inspection reports</p></div><div class="expertise-item"><span class="expertise-icon">&#x2699;&#xFE0F;</span><h3>DFM for Medical</h3><p>Design feedback for regulatory requirements</p></div></div></section>
<section class="materials-section container"><header class="section-head"><p class="section-head__eyebrow">Medical Titanium Grades</p><h2 class="section-head__title">Medical-Approved Alloys</h2></header><div class="materials-table-wrap"><table class="materials-table"><thead><tr><th>Alloy</th><th>Standards</th><th>Applications</th></tr></thead><tbody>
<tr><td>Ti-6Al-4V ELI (G23)</td><td>ASTM F136</td><td>Orthopedic implants</td></tr>
<tr><td>Ti-6Al-4V (G5)</td><td>ASTM F1472</td><td>Surgical instruments</td></tr>
<tr><td>CP-Ti Grade 4</td><td>ASTM F67</td><td>Dental implants</td></tr>
<tr><td>CP-Ti Grade 2</td><td>ASTM F67</td><td>Instrument trays</td></tr>
<tr><td>CP-Ti Grade 1</td><td>ASTM F67</td><td>Patient-specific implants</td></tr>
</tbody></table></div><p class="materials-link">→ <a href={resolveRoute(locale, "/grades/")}>Complete materials guide</a></p></section>
<section class="certs-section container"><header class="section-head"><p class="section-head__eyebrow">Quality Systems</p><h2 class="section-head__title">Certifications</h2></header><div class="certs-row"><span class="cert-badge">ISO 13485</span><span class="cert-badge">FDA QSR</span><span class="cert-badge">EU MDR</span><span class="cert-badge">ASTM F136</span><span class="cert-badge">CMM</span></div></section>
<CTA
  eyebrow="Neutral engineering reference"
  title="Explore Titanium Engineering Knowledge"
  content="Neutral, vendor-independent technical guidance on titanium applications, grades, and standards to support your engineering decisions."
  ctaText="Browse Titanium Grades"
  ctaHref="/grades/"
  secondaryText="Compare Materials"
  secondaryHref="/compare/"
  locale={locale}
/>
</BaseLayout>
<style>
.hub-cards { padding-block: var(--space-xl) var(--space-3xl); }
.hub-cards__grid { display: grid; gap: var(--space-lg); grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); margin-top: var(--space-xl); }
.hub-card { display: block; padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-primary); text-decoration: none; }
.hub-card:hover { border-color: var(--color-brand-primary); transform: translateY(-2px); }
.hub-card__title { margin: 0 0 var(--space-sm); font-size: 1.15rem; color: var(--color-text-primary); }
.hub-card__description { margin: 0; color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.6; }
.hub-card__cta { display: inline-block; margin-top: var(--space-md); color: var(--color-brand-primary); font-weight: 600; }
.expertise-section { padding-block: var(--space-xl) var(--space-3xl); }
.expertise-grid { display: grid; gap: var(--space-lg); grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); margin-top: var(--space-xl); }
.expertise-item { padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-secondary); }
.expertise-icon { font-size: 1.75rem; display: block; margin-bottom: var(--space-sm); }
.expertise-item h3 { margin: 0 0 var(--space-xs); font-size: 1rem; color: var(--color-text-primary); }
.expertise-item p { margin: 0; color: var(--color-text-secondary); font-size: 0.875rem; line-height: 1.6; }
.materials-section { padding-block: var(--space-xl) var(--space-3xl); }
.materials-table-wrap { overflow-x: auto; margin-top: var(--space-xl); }
.materials-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
.materials-table th { text-align: left; padding: var(--space-sm) var(--space-md); border-bottom: 2px solid var(--color-border); color: var(--color-text-primary); font-weight: 600; }
.materials-table td { padding: var(--space-sm) var(--space-md); border-bottom: 1px solid var(--color-border); color: var(--color-text-secondary); }
.materials-table td:first-child { font-weight: 600; color: var(--color-text-primary); white-space: nowrap; }
.materials-link { margin-top: var(--space-md); text-align: center; color: var(--color-text-secondary); }
.materials-link a { color: var(--color-brand-primary); font-weight: 600; }
.certs-section { padding-block: var(--space-xl) var(--space-3xl); }
.certs-row { display: flex; flex-wrap: wrap; gap: var(--space-md); justify-content: center; margin-top: var(--space-xl); }
.cert-badge { display: inline-flex; padding: 0.5rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-full); background: var(--color-bg-primary); font-weight: 600; font-size: 0.85rem; color: var(--color-text-primary); }
.section-head { text-align: center; }
.section-head__eyebrow { display: inline-flex; padding: 0.35rem 0.9rem; border-radius: var(--radius-full); border: 1px solid color-mix(in srgb, var(--primary) 15%, transparent); background: color-mix(in srgb, var(--primary) 6%, transparent); font-size: 0.75rem; color: var(--primary); font-weight: 700; }
.section-head__title { margin: 0; font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-text-primary); max-width: 36rem; margin-inline: auto; }
</style>


