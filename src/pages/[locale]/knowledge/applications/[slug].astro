---
import { getCollection, render } from "astro:content";
import MarketingLayout from "../../../../layouts/MarketingLayout.astro";
import { resolveRoute } from "../../../../i18n/routes";
import { siteConfig } from "../../../../config/site.config";
import { buildTechArticleSchema } from "../../../../lib/schema";

export async function getStaticPaths() {
  const entries = await getCollection("applications");
  return entries
    .filter((e: any) => e.data.locale === "en")
    .map((e: any) => ({
      params: { slug: e.id, locale: e.data.locale },
      props: { entry: e, locale: "en" as const },
    }));
}

const { entry, locale } = Astro.props as { entry: any; locale: "en" };
const data = entry.data;
const pageUrl = siteConfig.url + resolveRoute(locale, `/knowledge/applications/${entry.id}/`);
const ts = buildTechArticleSchema({
  headline: data.title,
  description: data.description,
  datePublished: new Date().toISOString(),
  keywords: ["titanium", "applications", data.industry, ...(data.title?.toLowerCase().split(" ") || [])],
  url: pageUrl,
  inLanguage: locale,
});
const { Content } = await render(entry);
---

<MarketingLayout title={data.title} description={data.description} locale={locale} path={`/knowledge/applications/${entry.id}/`} jsonLd={ts}>
  <article class="container py-16 entity-article">
    <header class="entity-header">
      {data.industry && <span class="entity-badge">{data.industry}</span>}
      <h1 class="entity-title">{data.title}</h1>
      <p class="entity-description">{data.description}</p>
    </header>
    <div class="entity-content prose prose-gray dark:prose-invert max-w-none">
      <Content />
    </div>
  </article>
</MarketingLayout>
