---
import EntityDetail from "../../../knowledge/_EntityDetail.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("materials");
  return entries
    .map((e: any) => ({
      params: { slug: e.id, locale: e.data.locale },
      props: { entry: e, locale: e.data.locale },
    }));
}

const { entry, locale } = Astro.props as { entry: any; locale: string };
const { Content } = await render(entry);
---

<EntityDetail collectionName="materials" slug={entry.id}>
  <div class="prose prose-gray dark:prose-invert max-w-none">
    <Content />
  </div>
</EntityDetail>
