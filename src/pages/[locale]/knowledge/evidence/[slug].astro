---
import MarketingLayout from "../../../../layouts/MarketingLayout.astro";
import { getCollection, render } from "astro:content";
import { resolveRoute } from "../../../../i18n/routes";
import { siteConfig } from "../../../../config/site.config";
import { buildTechArticleSchema } from "../../../../lib/schema";

export async function getStaticPaths() {
  const entries = await getCollection("evidence");
  return entries.filter((e: { data: { locale: string } }) => e.data.locale).map((e: any) => ({
    params: { slug: e.id.replace(/\.md$/, "") },
    props: { entry: e, locale: e.data.locale },
  }));
}

const { entry, locale } = Astro.props as { entry: any; locale: "en" };
const data = entry.data;
const pageUrl = siteConfig.url + resolveRoute(locale, `/knowledge/evidence/${entry.id}/`);
const catLabels: Record<string, string> = {
  "material-properties": "Material Properties",
  "cutting-parameters": "Cutting Parameters",
  "surface-roughness": "Surface Roughness",
  "tolerances": "Tolerances & Precision",
  "process-capabilities": "Process Capabilities",
};
const ts = buildTechArticleSchema({
  headline: data.title, description: data.description,
  datePublished: new Date().toISOString(),
  keywords: [catLabels[data.evidenceCategory] || data.evidenceCategory],
  url: pageUrl, inLanguage: locale,
});
const { Content } = await render(entry);
---

<MarketingLayout title={data.title} description={data.description} locale={locale} path={`/knowledge/evidence/${entry.id}/`} jsonLd={ts}>
<article class="evidence-detail container py-16">
<header class="ev-hdr">
<span class="ev-badge">{catLabels[data.evidenceCategory]||data.evidenceCategory}</span>
<h1 class="ev-title">{data.title}</h1>
<p class="ev-desc">{data.description}</p>
{data.source && <p class="ev-src">Source: {data.sourceUrl ? <a href={data.sourceUrl} target="_blank" rel="noopener">{data.source}</a> : data.source}</p>}
</header>
{data.dataPoints?.length > 0 && <section class="ev-tbl"><h2>Technical Data</h2><div class="tw"><table class="ev-table"><thead><tr><th>Property</th><th>Value</th><th>Unit</th><th>Notes</th></tr></thead><tbody>{data.dataPoints.map((dp: any) => (<tr><td><strong>{dp.property}</strong></td><td class="vv">{dp.value}</td><td>{dp.unit||"-"}</td><td class="nn">{dp.notes||"-"}</td></tr>))}</tbody></table></div></section>}
<div class="ev-content prose prose-gray dark:prose-invert max-w-none"><Content /></div>
<footer class="ev-ftr">
{data.relatedStandards?.length>0 && <div class="ev-rel"><h3>Standards</h3><ul>{data.relatedStandards.map((s: string) => (<li><a href={resolveRoute(locale,"/knowledge/standards/"+s+"/")}>{s.replace(/-/g," ").toUpperCase()}</a></li>))}</ul></div>}
{data.relatedMaterials?.length>0 && <div class="ev-rel"><h3>Materials</h3><ul>{data.relatedMaterials.map((m:string)=>(<li><a href={resolveRoute(locale,"/knowledge/materials/"+m+"/")}>{m.replace(/-/g," ").replace(/\b\w/g,(c:string)=>c.toUpperCase())}</a></li>))}</ul></div>}
</footer>
</article></MarketingLayout>
<style>.ev-badge{display:inline-block;font-size:.75rem;padding:.25rem .75rem;border-radius:var(--radius-full);background:var(--color-bg-tertiary);color:var(--color-text-secondary);font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:var(--space-md)}.ev-title{margin:0 0 var(--space-sm);font-size:clamp(1.75rem,3vw,2.5rem);color:var(--color-text-primary)}.ev-desc{margin:0 0 var(--space-sm);color:var(--color-text-secondary);font-size:1.05rem;line-height:1.6}.ev-src{margin:0;font-size:.85rem;color:var(--color-text-secondary);font-style:italic}.ev-src a{color:var(--color-brand-primary)}.ev-tbl{margin-top:var(--space-xl)}.ev-tbl h2{font-size:1.25rem;margin-bottom:var(--space-md);color:var(--color-text-primary)}.tw{overflow-x:auto}.ev-table{width:100%;border-collapse:collapse;font-size:.9rem}.ev-table th,.ev-table td{padding:.6rem .8rem;text-align:left;border-bottom:1px solid var(--color-border)}.ev-table th{background:var(--color-bg-secondary);font-weight:600;color:var(--color-text-primary)}.vv{font-weight:700;color:var(--color-text-primary);font-family:var(--font-mono)}.nn{color:var(--color-text-secondary);font-size:.85rem}.ev-content{margin-top:var(--space-xl)}.ev-ftr{margin-top:var(--space-2xl);padding-top:var(--space-xl);border-top:1px solid var(--color-border)}.ev-rel{margin-bottom:var(--space-lg)}.ev-rel h3{margin:0 0 var(--space-sm);font-size:1rem;color:var(--color-text-primary)}.ev-rel ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.5rem}.ev-rel li a{display:inline-block;padding:.2rem .6rem;border:1px solid var(--color-border);border-radius:var(--radius-full);font-size:.8rem;color:var(--color-text-secondary);text-decoration:none}.ev-rel li a:hover{border-color:var(--color-brand-primary);color:var(--color-brand-primary)}</style>
