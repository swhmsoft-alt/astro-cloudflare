---

export async function getStaticPaths(){return ["en","de","ja","fr","es","pt","it","ko","nl","pl","ru","ar","pt-br","tr","cs","sv"].map(function(l){return{params:{locale:l},props:{locale:l}}})}
import M from"../../layouts/MarketingLayout.astro";
import H from"../../components/Hero.astro";
import Q from"../../components/FAQ.astro";

import{t}from"../../i18n/ui";
import{resolveRoute}from"../../i18n/routes";
import{siteConfig as s}from"../../config/site.config";
import type{Locale as L}from"../../lib/site-config";
import J from"../../components/seo/JsonLd.astro";
import{buildWebSiteSchema as ws,buildOrganizationSchema as o,buildBreadcrumbSchema as b,buildFAQSchema as q}from"../../lib/schema";
const lc=(Astro.props.locale||'en')as L;
const k=[{t:'Materials',d:'Complete specs for all grades.',h:'/grades/',c:'6+'},{t:'Processes',d:'CNC, 5-axis, turning, EDM, additive.',h:'/processes/',c:'7'},{t:'Industries',d:'Aerospace, medical, semi, energy.',h:'/industries/',c:'5'},{t:'Standards',d:'ASTM, AS9100D, NADCAP, ISO.',h:'/standards/',c:'6'},{t:'Finishes',d:'Anodizing, passivation, polishing.',h:'/finishes/',c:'4'},{t:'Material Selection',d:'Application-based grade comparison and selection guides.',h:'/select/',c:'0'},{t:'Failure Analysis',d:'Hydrogen embrittlement, SCC, deformation, defect prevention.',h:'/failures/',c:'0'},{t:'Heat Treatment',d:'Annealing, solution treatment, aging, microstructure control.',h:'/heat-treatment/',c:'1'},{t:'Corrosion Resistance',d:'Titanium in seawater, acid, chloride, high-temp environments.',h:'/corrosion/',c:'0'}];
const qq=[{q:'What titanium grades are most common?',a:'Grade 2 (commercially pure), Grade 5 (Ti-6Al-4V), and Grade 23 (Ti-6Al-4V ELI) are the most widely used, covering industrial, aerospace, and medical applications.'},{q:'How do I select the right grade?',a:'Consider tensile strength, corrosion resistance, formability, and operating temperature. Compare mechanical properties across grades using the Materials section.'},{q:'What heat treatments apply to titanium?',a:'Stress relief, annealing, solution treatment, and aging. Unlike steel, titanium has no eutectoid transformation; heat treatment controls alpha-beta phase proportions.'},{q:'Is titanium resistant to corrosion?',a:'Yes. Titanium forms a stable passive oxide layer, offering excellent resistance in seawater, chlorides, oxidizing acids, and up to 400C in air.'},{q:'What causes titanium failure?',a:'Common failure modes include hydrogen embrittlement, stress corrosion cracking, fatigue, and creep. Each is influenced by alloy composition, processing, and service environment.'}];
const formattedQq=qq.map(i=>({question:i.q,answer:i.a}));
const br=[{label:'Home',href:s.url+'/'}];
const w=ws(s);const or=o(s);const fq=q(formattedQq);const bc=b(br);
---
<M title={t(lc,"hero.title")} description={s.description} locale={lc} path="/">
<J schema={[w,or,fq,bc]}/>
<H variant="centered" eyebrow="Titanium Engineering Knowledge Hub" headline={t(lc,"hero.title")} subheadline={t(lc,"hero.subtitle")} primaryCta={{label:"Explore Knowledge Base",href:"/knowledge/"}} locale={lc}/>

<section class="c py-16"><header class="section-head"><p class="section-head__eyebrow">Knowledge Base</p><h2 class="section-head__title">Your Complete Titanium Engineering Reference</h2><p class="section-head__lead">Neutral, authoritative technical resources covering the full titanium supply chain from alloy composition to final application.</p></header><div class="hg">{k.map(i=><a href={resolveRoute(lc,i.h)} class="hc"><div class="hch"><h3 class="hct">{i.t}</h3><span class="hcc">{i.c}</span></div><p class="hcd">{i.d}</p><span class="hcta">Browse &rarr;</span></a>)}</div></section>
<section class="c py-16"><header class="section-head"><p class="section-head__eyebrow">Industries</p><h2 class="section-head__title">Titanium Applications Across Critical Industries</h2></header><div class="ig"><div class="ic"><h3>Aerospace</h3><p>Airframe, engine, landing gear</p></div><div class="ic"><h3>Medical</h3><p>Implants, instruments</p></div><div class="ic"><h3>Semiconductor</h3><p>Vacuum chambers, wafer handling</p></div><div class="ic"><h3>Energy</h3><p>Oil & gas, renewable</p></div><div class="ic"><h3>Chemical</h3><p>Processing, marine</p></div></div></section>
<Q title="Titanium Engineering FAQ" items={formattedQq}/>
</M>
<style>.hg{display:grid;gap:var(--space-lg);grid-template-columns:repeat(auto-fill,minmax(320px,1fr));margin-top:var(--space-xl)}.hc{display:block;padding:var(--space-lg);border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-bg-primary);text-decoration:none;transition:all .2s ease}.hc:hover{border-color:var(--color-brand-primary);transform:translateY(-2px)}.hch{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-sm)}.hct{margin:0 0 var(--space-sm);font-size:1.15rem;color:var(--color-text-primary)}.hcc{font-size:.75rem;padding:.2rem .6rem;border-radius:var(--radius-full);background:var(--color-bg-tertiary);color:var(--color-text-secondary);font-weight:600}.hcd{margin:0;color:var(--color-text-secondary);font-size:.9rem;line-height:1.6}.hcta{display:inline-block;margin-top:var(--space-md);color:var(--color-brand-primary);font-weight:600}.ig{display:flex;flex-wrap:wrap;gap:var(--space-lg);margin-top:var(--space-xl)}.ic{flex:1;min-width:160px;padding:var(--space-lg);border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-bg-primary)}.ic h3{margin:0 0 var(--space-xs);font-size:1rem;color:var(--color-text-primary)}.ic p{margin:0;font-size:.85rem;color:var(--color-text-secondary);line-height:1.5}.cta-light{padding:var(--space-2xl);text-align:center;border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-bg-secondary)}.cta-light__eyebrow{font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;color:var(--color-text-secondary);margin:0 0 var(--space-sm)}.cta-light__title{margin:0 0 var(--space-sm);font-size:1.5rem;color:var(--color-text-primary)}.cta-light__text{margin:0 0 var(--space-md);color:var(--color-text-secondary)}.cta-light__link{display:inline-block;padding:var(--space-sm) var(--space-lg);border:1px solid var(--color-brand-primary);border-radius:var(--radius-md);color:var(--color-brand-primary);font-weight:600;text-decoration:none}.cta-light__link:hover{background:var(--color-brand-primary);color:#fff}</style>