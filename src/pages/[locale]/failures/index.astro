---
import { getCollection } from "astro:content";
import { buildCollectionPageSchema, buildItemListSchema } from "../../../lib/schema";
import { resolveRoute } from "../../../i18n/routes";
import { siteConfig } from "../../../config/site.config";
import type { Locale } from "../../../config/site.config";
import EntityPillar from "../../../pages/_shared/_EntityPillar.astro";
import { buildLocalePaths } from "../../../i18n/availability";
export async function getStaticPaths() {
  return buildLocalePaths("failures/index").map((l) => ({ params: { locale: l }, props: { locale: l } }));
}
const locale = (Astro.props.locale || "en") as Locale;

const entries = (await getCollection("failureAnalysis"))
  .filter((e: any) => e.data.locale === locale)
  .sort((a: any, b: any) => a.data.order - b.data.order);

const listUrl = siteConfig.url + resolveRoute(locale, "/failures/");
const collectionSchema = buildCollectionPageSchema({
  name: "Titanium Failure Analysis",
  description: "Technical guides on titanium failure modes: hydrogen embrittlement, stress corrosion cracking, fatigue, and prevention.",
  url: listUrl,
  numberOfItems: entries.length,
});
const itemListSchema = entries.length > 0 ? buildItemListSchema({
  itemType: "TechArticle",
  numberOfItems: entries.length,
  url: listUrl,
  itemListElement: entries.map((e: any) => ({
    name: e.data.title,
    description: e.data.description,
    url: siteConfig.url + resolveRoute(locale, "/failures/" + e.id + "/"),
  })),
}) : null;
const schemas = [collectionSchema, itemListSchema].filter(
  (s): s is NonNullable<typeof s> => s !== null,
);
---
<EntityPillar
  collectionName="failureAnalysis"
  pageTitleKey="failures.pageTitle"
  pageDescriptionKey="failures.pageDescription"
  locale={locale}
  path="/failures/"
  jsonLd={schemas}
/>
