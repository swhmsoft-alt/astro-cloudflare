---
import { getCollection, type CollectionEntry } from "astro:content";
import { buildCollectionPageSchema, buildItemListSchema } from "../../../lib/schema";
import { resolveRoute } from "../../../i18n/routes";
import { siteConfig } from "../../../config/site.config";
import type { Locale } from "../../../lib/site-config";
import EntityPillar from "../../../pages/_shared/_EntityPillar.astro";
import { buildLocalePaths } from "../../../i18n/availability";
export async function getStaticPaths() {
  return buildLocalePaths("selection/index").map((l) => ({ params: { locale: l }, props: { locale: l } }));
}
const locale = (Astro.props.locale || "en") as Locale;

const entries = (await getCollection("materialSelection"))
  .filter((e: CollectionEntry<"materialSelection">) => e.data.locale === locale)
  .sort((a: CollectionEntry<"materialSelection">, b: CollectionEntry<"materialSelection">) => a.data.order - b.data.order);

const listUrl = siteConfig.url + resolveRoute(locale, "/selection/");
const collectionSchema = buildCollectionPageSchema({
  name: "Titanium Material Selection Guides",
  description: "Expert guides for selecting the right titanium grade for your application. Compare properties across grades.",
  url: listUrl,
  numberOfItems: entries.length,
});
const itemListSchema = entries.length > 0 ? buildItemListSchema({
  itemType: "TechArticle",
  numberOfItems: entries.length,
  url: listUrl,
  itemListElement: entries.map((e: CollectionEntry<"materialSelection">) => ({
    name: e.data.title,
    description: e.data.description,
    url: siteConfig.url + resolveRoute(locale, "/selection/" + e.id + "/"),
  })),
}) : null;
const schemas = [collectionSchema, itemListSchema].filter(
  (s): s is NonNullable<typeof s> => s !== null,
);
---
<EntityPillar
  collectionName="materialSelection"
  pageTitle="Titanium Material Selection Guides"
  pageDescription="Expert guides for selecting the right titanium grade for your application. Compare properties across grades."
  locale={locale}
  path="/selection/"
  jsonLd={schemas}
/>
