---
import { getCollection, render } from "astro:content";
import EntityDetail from "../../../pages/_shared/_EntityDetail.astro";

export async function getStaticPaths() {
  const entries = await getCollection("surfaceFinishes");
  return entries
    .filter((e: any) => e.data.locale === "en")
    .map((e: any) => ({
      params: { slug: e.id, locale: e.data.locale },
      props: { entry: e, locale: "en" as const },
    }));
}

const { entry } = Astro.props as { entry: any; locale: "en" };
const { Content } = await render(entry);
---

<EntityDetail collectionName="surfaceFinishes" slug={entry.id}>
  <div class="prose prose-gray dark:prose-invert max-w-none">
    <Content />
  </div>
</EntityDetail>
