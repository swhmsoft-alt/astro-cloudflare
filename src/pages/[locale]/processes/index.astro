---
import { getCollection } from "astro:content";
import { buildCollectionPageSchema, buildItemListSchema } from "../../../lib/schema";
import { resolveRoute } from "../../../i18n/routes";
import { siteConfig } from "../../../config/site.config";
import type { Locale } from "../../../lib/site-config";
import EntityPillar from "../../../pages/_shared/_EntityPillar.astro";
export async function getStaticPaths(){return ["de","ja","fr","es","pt","it","ko","nl","pl","ru","ar","pt-br","tr","cs","sv"].map(function(l){return{params:{locale:l},props:{locale:l}}})}
const locale = (Astro.props.locale || "en") as Locale;

const entries = (await getCollection("processes"))
  .filter((e: any) => e.data.locale === locale)
  .sort((a: any, b: any) => a.data.order - b.data.order);

const listUrl = siteConfig.url + resolveRoute(locale, "/processes/");
const collectionSchema = buildCollectionPageSchema({
  name: "Titanium Manufacturing Processes",
  description: "Comprehensive technical guides for all titanium manufacturing processes. Compare capabilities, tolerances, surface finishes, and applications.",
  url: listUrl,
  numberOfItems: entries.length,
});
const itemListSchema = entries.length > 0 ? buildItemListSchema({
  itemType: "TechArticle",
  numberOfItems: entries.length,
  url: listUrl,
  itemListElement: entries.map((e: any) => ({
    name: e.data.title,
    description: e.data.description,
    url: siteConfig.url + resolveRoute(locale, "/processes/" + e.id + "/"),
  })),
}) : null;
const schemas = [collectionSchema, itemListSchema].filter(
  (s): s is NonNullable<typeof s> => s !== null,
);
---
<EntityPillar
  collectionName="processes"
  pageTitle="Titanium Manufacturing Processes"
  pageDescription="Comprehensive technical guides for all titanium manufacturing processes. Compare capabilities, tolerances, surface finishes, and applications."
  locale={locale}
  path="/processes/"
  jsonLd={schemas}
/>
