---
import MarketingLayout from "../../../layouts/MarketingLayout.astro";
import { resolveRoute } from "../../../i18n/routes";
import { siteConfig } from "../../../config/site.config";
import type { Locale } from "../../../lib/site-config";
import { buildBreadcrumbSchema, buildTechArticleSchema } from "../../../lib/schema";

export async function getStaticPaths() {
  return ["en","de","ja","fr","es","pt","it","ko","nl","pl","ru","ar","pt-br","tr","cs","sv"].map(function(l) {
    return { params: { locale: l, slug: "hardness-converter" }, props: { locale: l } };
  });
}
const locale = (Astro.props.locale || "en") as Locale;
const pageTitle = "Titanium Hardness Unit Converter";
const pageDesc = "Convert between HRC, HB, ksi, and MPa for titanium alloys.";
const pageUrl = siteConfig.url + resolveRoute(locale, "/tools/hardness-converter/");
const bc = buildBreadcrumbSchema([{label:"Home",href:siteConfig.url+"/"},{label:"Tools",href:siteConfig.url+"/tools/"},{label:pageTitle,href:pageUrl}]);
const ta = buildTechArticleSchema({headline:pageTitle,description:pageDesc,url:pageUrl,datePublished:"2026-01-15",dateModified:"2026-07-26",keywords:["hardness converter","HRC to HB","ksi to MPa","titanium hardness"]});
---

<MarketingLayout title={pageTitle} description={pageDesc} locale={locale} path="/tools/hardness-converter/" jsonLd={[bc,ta]}>
  <article class="container py-16">
    <h1 class="text-3xl font-bold mb-2">{pageTitle}</h1>
    <p class="text-secondary mb-8">{pageDesc}</p>
    <section class="overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead><tr class="bg-secondary/10">
          <th class="p-3 text-left border">HRC</th><th class="p-3 text-right border">HB</th>
          <th class="p-3 text-right border">UTS (ksi)</th><th class="p-3 text-right border">UTS (MPa)</th>
        </tr></thead>
        <tbody>
          <tr class="hover:bg-secondary/5"><td class="p-3 border font-medium">20</td><td class="p-3 border text-right">225</td><td class="p-3 border text-right">95</td><td class="p-3 border text-right">655</td></tr>
          <tr class="hover:bg-secondary/5"><td class="p-3 border font-medium">30</td><td class="p-3 border text-right">295</td><td class="p-3 border text-right">120</td><td class="p-3 border text-right">827</td></tr>
          <tr class="hover:bg-secondary/5"><td class="p-3 border font-medium">36</td><td class="p-3 border text-right">341</td><td class="p-3 border text-right">135</td><td class="p-3 border text-right">931</td></tr>
          <tr class="hover:bg-secondary/5"><td class="p-3 border font-medium">40</td><td class="p-3 border text-right">374</td><td class="p-3 border text-right">145</td><td class="p-3 border text-right">1000</td></tr>
          <tr class="hover:bg-secondary/5"><td class="p-3 border font-medium">44</td><td class="p-3 border text-right">408</td><td class="p-3 border text-right">155</td><td class="p-3 border text-right">1069</td></tr>
        </tbody>
      </table>
    </section>
    <section class="mt-12 p-6 bg-secondary/5 rounded-lg border">
      <p class="text-sm text-secondary">Per ASTM A370 / SAE J417 correlation. ±10% accuracy. Verify with certificate.</p>
    </section>
  </article>
</MarketingLayout>
