---
import MarketingLayout from "../../../layouts/MarketingLayout.astro";
import { t } from "../../../i18n/ui";
import { resolveRoute } from "../../../i18n/routes";
import type { Locale } from "../../../lib/site-config";

export async function getStaticPaths() {
  return ["en", "de", "ja", "fr", "es", "pt", "it", "ko", "nl", "pl", "ru", "ar", "pt-br", "tr", "cs", "sv"].map(function(l) {
    return { params: { locale: l }, props: { locale: l } };
  });
}
const locale = (Astro.props.locale || "en") as Locale;

const tools = [
  { title: "Titanium Grade Comparison Tool", desc: "Compare mechanical properties, corrosion resistance, and applications across all titanium grades side by side.", href: "/tools/grade-comparison/", icon: "📊" },
  { title: "Hardness Unit Converter", desc: "Convert between HRC, HB, ksi, and MPa hardness and tensile strength values for titanium alloys.", href: "/tools/hardness-converter/", icon: "🔄" },
];
---

<MarketingLayout title="Titanium Engineering Tools" description="Interactive reference tools for titanium engineers." locale={locale} path="/tools/">
  <section class="container py-16">
    <header class="section-head">
      <p class="section-head__eyebrow">Tools</p>
      <h1 class="section-head__title">Titanium Engineering Tools</h1>
      <p class="section-head__lead">Interactive reference tools for material selection, property comparison, and engineering calculations.</p>
    </header>
    <div class="tools-grid">
      {tools.map(t => (
        <a href={resolveRoute(locale, t.href)} class="tool-card">
          <span class="tool-card__icon">{t.icon}</span>
          <h2 class="tool-card__title">{t.title}</h2>
          <p class="tool-card__desc">{t.desc}</p>
          <span class="tool-card__cta">Open Tool &rarr;</span>
        </a>
      ))}
    </div>
  </section>
</MarketingLayout>

<style>
  .tools-grid { display: grid; gap: var(--space-lg); grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); margin-top: var(--space-xl); }
  .tool-card { display: block; padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-primary); text-decoration: none; transition: all 0.2s ease; }
  .tool-card:hover { border-color: var(--color-brand-primary); transform: translateY(-2px); }
  .tool-card__icon { font-size: 2rem; display: block; margin-bottom: var(--space-sm); }
  .tool-card__title { margin: 0 0 var(--space-sm); font-size: 1.15rem; color: var(--color-text-primary); }
  .tool-card__desc { margin: 0; color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.6; }
  .tool-card__cta { display: inline-block; margin-top: var(--space-md); color: var(--color-brand-primary); font-weight: 600; }
</style>
