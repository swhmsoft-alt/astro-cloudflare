---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { t } from "../../../i18n/ui";
import Hero from "../../../components/Hero.astro";
import CTA from "../../../components/CTA.astro";

export async function getStaticPaths() {
  const allPages: CollectionEntry<"pages">[] = await getCollection("pages");
  const supportedLocales = ["en", "de", "ja", "fr", "es", "pt", "it", "ko", "nl", "pl", "ru", "ar", "pt-br", "tr", "cs", "sv"];
  const paths = [];
  for (const locale of supportedLocales) {
    const solutionsForLocale = allPages.filter(
      (p) => p.data.slug.startsWith("solutions/") && p.data.locale === locale,
    );
    for (const solution of solutionsForLocale) {
      const slugPart = solution.data.slug.replace("solutions/", "");
      paths.push({
        params: { locale, slug: slugPart },
        props: { entry: solution, locale: solution.data.locale },
      });
    }
  }
  // Fallback to English if no locale-specific content
  if (paths.length === 0) {
    const englishSolutions = allPages.filter(
      (p) => p.data.slug.startsWith("solutions/") && p.data.locale === "en",
    );
    for (const solution of englishSolutions) {
      const slugPart = solution.data.slug.replace("solutions/", "");
      paths.push({
        params: { locale: "en", slug: slugPart },
        props: { entry: solution, locale: "en" as const },
      });
    }
  }
  return paths;
}

const { entry, locale } = Astro.props as {
  entry: CollectionEntry<"pages">;
  locale: "en";
};
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  path={`/solutions/${entry.data.slug.replace("solutions/", "")}`}
>
  <Hero
    variant="centered"
    size="md"
    eyebrow="Solutions"
    title={entry.data.title}
    content={entry.data.description}
    locale={locale}
  />

  <section class="c py-16">
    <div class="prose-wrapper">
      <Content />
    </div>
  </section>

  <CTA
    title="Start Your Titanium Project Today"
    content="Upload your drawing or describe your requirements. Our engineering team will provide DFM feedback and a competitive quote within 24 hours."
    ctaText="Upload Drawing →"
    ctaHref="/rfq/upload-drawing/"
    secondaryText="Request a Quote"
    secondaryHref="/rfq/request-quote/"
    locale={locale}
  />
</BaseLayout>

<style>
  .prose-wrapper {
    max-width: 48rem;
    margin-inline: auto;
  }
  .prose-wrapper :global(h2) {
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }
  .prose-wrapper :global(h3) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .prose-wrapper :global(p) {
    margin-bottom: var(--space-md);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }
  .prose-wrapper :global(ul) {
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
    list-style: disc;
  }
  .prose-wrapper :global(li) {
    margin-bottom: var(--space-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .prose-wrapper :global(strong) {
    color: var(--color-text-primary);
    font-weight: 600;
  }
</style>
