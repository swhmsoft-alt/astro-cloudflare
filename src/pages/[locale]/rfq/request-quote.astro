---

export async function getStaticPaths(){return ["en","de","ja","fr","es","pt","it","ko","nl","pl","ru","ar","pt-br","tr","cs","sv"].map(function(l){return{params:{locale:l},props:{locale:l}}})}
import MarketingLayout from "../../../layouts/MarketingLayout.astro";
import Hero from "../../../components/Hero.astro";
import CapabilityShowcase from "../../../components/CapabilityShowcase.astro";
import CTA from "../../../components/CTA.astro";
import { Grid, Section } from "../../../components/ui/layout";
import { Card } from "../../../components/ui/data-display";
import { Prose } from "../../../components/ui/content";
import type { Locale } from "../../../lib/site-config";

const locale = (Astro.props.locale || "en") as Locale;
---

<MarketingLayout
  title="Request a Quote — Titanium Manufacturing"
  description="Request a competitive quote for your titanium component manufacturing. CNC machining, 5-axis milling, turning, wire EDM, and additive manufacturing."
  locale={locale}
  path="/rfq/request-quote/"
>
  <Hero
    variant="centered"
    size="md"
    eyebrow="Request a Quote"
    title="Get a Competitive Quote for Your Titanium Parts"
    content="Tell us about your project and receive a detailed quote within 24 hours."
    locale={locale}
  />

  <Section spacing="xl">
    <div class="container">
      <Prose as="div">
        <h2>Information to Include in Your Quote Request</h2>
      </Prose>
      <Grid cols={2} gap="md">
        <Card>
          <h3>Part Description</h3>
          <p>Describe the part function, critical features, and any special requirements.</p>
        </Card>
        <Card>
          <h3>Material</h3>
          <p>Grade 1, 2, 5 (Ti-6Al-4V), 23 (Ti-6Al-4V ELI), or custom specification.</p>
        </Card>
        <Card>
          <h3>Quantity</h3>
          <p>Prototype (1-10), low-volume (11-100), medium (101-1000), or production (1000+).</p>
        </Card>
        <Card>
          <h3>Tolerances</h3>
          <p>Standard (±0.1mm), Precision (±0.05mm), High Precision (±0.01mm).</p>
        </Card>
        <Card>
          <h3>Surface Finish</h3>
          <p>Machined, anodized, passivated, polished, bead blasted, or custom.</p>
        </Card>
        <Card>
          <h3>Timeline</h3>
          <p>Standard (2-4 weeks), Rush (1-2 weeks), Emergency (5-7 days).</p>
        </Card>
      </Grid>
    </div>
  </Section>

  <CapabilityShowcase />

  <Section spacing="xl">
    <div class="container">
      <div class="contact-card">
        <Prose as="div">
          <h2>Email Your Quote Request</h2>
          <p>Send your requirements to <strong>hello@titanium.blog</strong> and we'll respond with a detailed quote within 24 hours.</p>
        </Prose>
      </div>
    </div>
  </Section>

  <CTA
    eyebrow="Have a drawing?"
    title="Upload Your Drawing Instead"
    content="Faster quotes with a complete drawing or 3D model."
    ctaText="Upload Drawing →"
    ctaHref="/rfq/upload-drawing/"
    locale={locale}
  />
</MarketingLayout>

<style>
  .contact-card {
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-xl);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
  }
</style>