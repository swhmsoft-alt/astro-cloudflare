---

export async function getStaticPaths(){return ["en","de","ja","fr","es","pt","it","ko","nl","pl","ru","ar","pt-br","tr","cs","sv"].map(function(l){return{params:{locale:l},props:{locale:l}}})}
import MarketingLayout from "../../../layouts/MarketingLayout.astro";
import Hero from "../../../components/Hero.astro";
import CapabilityShowcase from "../../../components/CapabilityShowcase.astro";
import CTA from "../../../components/CTA.astro";
import { Grid, Section } from "../../../components/ui/layout";
import { Card } from "../../../components/ui/data-display";
import { Prose } from "../../../components/ui/content";
import type { Locale } from "../../../lib/site-config";

const locale = (Astro.props.locale || "en") as Locale;
---

<MarketingLayout
  title="Upload Drawing — Titanium CNC Machining RFQ"
  description="Upload your titanium part drawing or 3D model. We accept STEP, IGES, STL, DXF, and PDF. Get a quote within 24 hours."
  locale={locale}
  path="/rfq/upload-drawing/"
>
  <Hero
    variant="centered"
    size="md"
    eyebrow="Upload Drawing"
    title="Submit Your Design for Review"
    content="Upload your part drawing or 3D model and our engineering team will provide DFM feedback and a competitive quote within 24 hours."
    locale={locale}
  />

  <Section spacing="xl">
    <div class="container">
      <Prose as="div">
        <h2>Accepted File Formats</h2>
      </Prose>
      <Grid cols={3} gap="md">
        <Card>
          <div class="format-icon" aria-hidden="true">🔷</div>
          <h3>STEP (.stp, .step)</h3>
          <p>Preferred for 3D models. Supports solids and assemblies.</p>
        </Card>
        <Card>
          <div class="format-icon" aria-hidden="true">🔶</div>
          <h3>IGES (.igs, .iges)</h3>
          <p>Legacy 3D format. Acceptable for most CAD systems.</p>
        </Card>
        <Card>
          <div class="format-icon" aria-hidden="true">⬡</div>
          <h3>STL (.stl)</h3>
          <p>Mesh format suitable for additive manufacturing and simple geometries.</p>
        </Card>
        <Card>
          <div class="format-icon" aria-hidden="true">📐</div>
          <h3>DXF (.dxf)</h3>
          <p>2D format for turned parts, profiles, and flat patterns.</p>
        </Card>
        <Card>
          <div class="format-icon" aria-hidden="true">📄</div>
          <h3>PDF (.pdf)</h3>
          <p>2D drawings with dimensions, tolerances, and notes.</p>
        </Card>
      </Grid>
    </div>
  </Section>

  <Section spacing="xl">
    <div class="container">
      <div class="contact-card">
        <Prose as="div">
          <h2>Prefer to email your files?</h2>
          <p>Send your drawings to <strong>hello@titanium.blog</strong> with your project requirements and we'll respond within 24 hours.</p>
        </Prose>
      </div>
    </div>
  </Section>

  <CapabilityShowcase />

  <CTA
    eyebrow="Next Step"
    title="Ready to discuss your project?"
    content="Contact us directly with your requirements."
    ctaText="Contact Us"
    ctaHref="/contact/"
    locale={locale}
  />
</MarketingLayout>

<style>
  .format-icon {
    font-size: 1.75rem;
    margin-bottom: var(--space-sm);
  }
  .contact-card {
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-xl);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
  }
</style>