---

export async function getStaticPaths(){return ["en","de","ja","fr","es","pt","it","ko","nl","pl","ru","ar","pt-br","tr","cs","sv"].map(function(l){return{params:{locale:l},props:{locale:l}}})}
import MarketingLayout from "../../../layouts/MarketingLayout.astro";
import Hero from "../../../components/Hero.astro";
import CapabilityShowcase from "../../../components/CapabilityShowcase.astro";
import CTA from "../../../components/CTA.astro";
import { Grid, Section } from "../../../components/ui/layout";
import { Card } from "../../../components/ui/data-display";
import { Prose } from "../../../components/ui/content";
import type { Locale } from "../../../lib/site-config";

const locale = (Astro.props.locale || "en") as Locale;
---

<MarketingLayout
  title="Titanium Prototype Request — Rapid Prototyping"
  description="Request rapid prototypes for titanium components. CNC machining, 5-axis milling, and additive manufacturing. As fast as 5 business days."
  locale={locale}
  path="/rfq/prototype-request/"
>
  <Hero
    variant="centered"
    size="md"
    eyebrow="Prototype Request"
    title="Rapid Prototyping for Titanium Parts"
    content="Get functional prototypes in as fast as 5 business days. CNC machining, 5-axis milling, turning, and additive manufacturing."
    locale={locale}
  />

  <Section spacing="xl">
    <div class="container">
      <Prose as="div">
        <h2>Prototype Options</h2>
      </Prose>
      <Grid cols={3} gap="md">
        <Card>
          <h3>CNC Machined Prototypes</h3>
          <p>Best for functional testing and fit checks. Same material and properties as production parts. Lead time: 5-10 business days.</p>
        </Card>
        <Card>
          <h3>5-Axis Machined Prototypes</h3>
          <p>Ideal for complex geometries requiring multiple axes. Single setup for complex parts. Lead time: 7-12 business days.</p>
        </Card>
        <Card>
          <h3>Additive Manufacturing (3D Printing)</h3>
          <p>Rapid prototypes using SLM/DMLS. No tooling required. Ideal for iterative design. Lead time: 5-10 business days.</p>
        </Card>
      </Grid>
    </div>
  </Section>

  <Section spacing="xl">
    <div class="container">
      <Prose as="div">
        <h2>Prototype Quantities</h2>
      </Prose>
      <Grid cols={3} gap="md">
        <div class="qty-card">
          <span class="qty-value">1-5</span>
          <span class="qty-label">Concept Validation</span>
        </div>
        <div class="qty-card">
          <span class="qty-value">6-20</span>
          <span class="qty-label">Functional Testing</span>
        </div>
        <div class="qty-card">
          <span class="qty-value">21-50</span>
          <span class="qty-label">Pre-Production</span>
        </div>
      </Grid>
    </div>
  </Section>

  <Section spacing="xl">
    <div class="container">
      <div class="contact-card">
        <Prose as="div">
          <h2>Start Your Prototype Today</h2>
          <p>Email your 3D model or drawing to <strong>hello@titanium.blog</strong> with "Prototype Request" in the subject line.</p>
        </Prose>
      </div>
    </div>
  </Section>

  <CapabilityShowcase />

  <CTA
    eyebrow="From Prototype to Production"
    title="Need Production Volumes?"
    content="We seamlessly transition from prototype to production quantities."
    ctaText="Request Production Quote →"
    ctaHref="/rfq/request-quote/"
    locale={locale}
  />
</MarketingLayout>

<style>
  .qty-card {
    text-align: center;
    padding: var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
  }
  .qty-value {
    display: block;
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
    font-family: var(--font-heading);
  }
  .qty-label {
    display: block;
    margin-top: var(--space-xs);
    color: var(--muted-foreground);
    font-size: var(--text-sm);
  }
  .contact-card {
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-xl);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
  }
</style>