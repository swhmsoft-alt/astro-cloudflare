---
import EntityPillar from "../_shared/_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildPillarGraph } from "../../lib/schema";
import { resolveRoute } from "../../i18n/routes";
import { siteConfig } from "../../config/site.config";
import type { Locale } from "../../config/site.config";
const locale = (Astro.currentLocale || "en") as Locale;

const entries = (await getCollection("processes"))
  .filter((e: any) => e.data.locale === locale)
  .sort((a: any, b: any) => a.data.order - b.data.order);

const listUrl = siteConfig.url + resolveRoute(locale, "/processes/");
const pageGraph = buildPillarGraph({
  name: "Titanium Manufacturing Processes",
  description: "Comprehensive technical guides for all titanium manufacturing processes. Compare capabilities, tolerances, surface finishes, and applications.",
  url: listUrl,
  collectionKey: "processes",
  locale,
  items: entries.map((e: any) => ({
    name: e.data.title,
    description: e.data.description,
    url: siteConfig.url + resolveRoute(locale, "/processes/" + e.id + "/"),
  })),
}, siteConfig);
---
<EntityPillar
  collectionName="processes"
  pageTitle="Titanium Manufacturing Processes"
  pageDescription="Comprehensive technical guides for all titanium manufacturing processes. Compare capabilities, tolerances, surface finishes, and applications."
  locale={locale}
  path="/processes/"
  pageGraph={pageGraph}
/>
