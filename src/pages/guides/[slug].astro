---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { getCollection, render } from "astro:content";
import { siteConfig } from "../../config/site.config";
import { buildTechArticleSchema } from "../../lib/schema";

export async function getStaticPaths() {
  const entries = await getCollection("guides");
  return entries.filter((e: any) => e.data.locale === "en").map((e: any) => ({
    params: { slug: e.id },
    props: { entry: e, locale: "en" as const },
  }));
}

const { entry, locale } = Astro.props as { entry: any; locale: "en" };
const data = entry.data;
const pageUrl = siteConfig.url + `/guides/${entry.id}/`;
const ts = buildTechArticleSchema({
  headline: data.title, description: data.description,
  datePublished: new Date().toISOString(),
  keywords: [data.guideType, "titanium guide"],
  url: pageUrl, inLanguage: locale,
});
const { Content } = await render(entry);
---
<MarketingLayout title={data.title} description={data.description} locale={locale} path={`/guides/${entry.id}/`} jsonLd={ts}>
<article class="guide-detail container py-16">
<header class="gd-hdr">
<span class="gd-badge">{data.guideType}</span>
<h1 class="gd-title">{data.title}</h1>
<p class="gd-desc">{data.description}</p>
</header>
<div class="gd-content prose prose-gray dark:prose-invert max-w-none"><Content /></div>
</article></MarketingLayout>
<style>
.gd-badge{display:inline-block;font-size:.75rem;padding:.25rem .75rem;border-radius:var(--radius-full);background:var(--color-bg-tertiary);color:var(--color-text-secondary);font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:var(--space-md)}
.gd-title{margin:0 0 var(--space-sm);font-size:clamp(1.75rem,3vw,2.5rem);color:var(--color-text-primary)}
.gd-desc{margin:0 0 var(--space-sm);color:var(--color-text-secondary);font-size:1.05rem;line-height:1.6}
.gd-content{margin-top:var(--space-xl)}
</style>
