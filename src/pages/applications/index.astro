---
import EntityPillar from "../_shared/_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildCollectionPageSchema, buildItemListSchema } from "../../lib/schema";
import { resolveRoute } from "../../i18n/routes";
import { siteConfig } from "../../config/site.config";
import type { Locale } from "../../lib/site-config";
const locale = (Astro.currentLocale || "en") as Locale;
const entries = (await getCollection("applications")).filter((e: any) => e.data.locale === locale).sort((a: any, b: any) => (a.data.order || 0) - (b.data.order || 0));
const listUrl = siteConfig.url + resolveRoute(locale, "/applications/");
const collectionSchema = buildCollectionPageSchema({ name: "Titanium Applications", description: "Titanium applications and use cases across aerospace, medical, semiconductor, and industrial components.", url: listUrl, numberOfItems: entries.length });
const itemListSchema = entries.length > 0 ? buildItemListSchema({ itemType: "DefinedTerm", numberOfItems: entries.length, url: listUrl, itemListElement: entries.map((e: any) => ({ name: e.data.title, description: e.data.description, url: siteConfig.url + resolveRoute(locale, "/applications/" + e.id + "/") })) }) : null;
const schemas = [collectionSchema, itemListSchema].filter((s): s is NonNullable<typeof s> => s !== null);
---
<EntityPillar collectionName="applications" pageTitle="Titanium Applications" pageDescription="Titanium applications and use cases across aerospace, medical, semiconductor, and industrial components." locale={locale} path="/applications/" jsonLd={schemas} />
