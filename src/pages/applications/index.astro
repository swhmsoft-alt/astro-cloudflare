---
import EntityPillar from "../_shared/_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildPillarGraph } from "../../lib/schema";
import { resolveRoute } from "../../i18n/routes";
import { siteConfig } from "../../config/site.config";
import type { Locale } from "../../config/site.config";
const locale = (Astro.currentLocale || "en") as Locale;
const entries = (await getCollection("applications")).filter((e: any) => e.data.locale === locale).sort((a: any, b: any) => (a.data.order || 0) - (b.data.order || 0));
const listUrl = siteConfig.url + resolveRoute(locale, "/applications/");
const pageGraph = buildPillarGraph({
  name: "Titanium Applications",
  description: "Titanium applications and use cases across aerospace, medical, semiconductor, and industrial components.",
  url: listUrl,
  collectionKey: "applications",
  locale,
  items: entries.map((e: any) => ({
    name: e.data.title,
    description: e.data.description,
    url: siteConfig.url + resolveRoute(locale, "/applications/" + e.id + "/"),
  })),
}, siteConfig);
---
<EntityPillar collectionName="applications" pageTitle="Titanium Applications" pageDescription="Titanium applications and use cases across aerospace, medical, semiconductor, and industrial components." locale={locale} path="/applications/" pageGraph={pageGraph} />
