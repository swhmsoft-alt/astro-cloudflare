---
import EntityPillar from "../_shared/_EntityPillar.astro";
import { getCollection } from "astro:content";
import { buildCollectionPageSchema, buildItemListSchema } from "../../lib/schema";
import { siteConfig } from "../../config/site.config";

const locale = "en";
const entries = (await getCollection("equipment"))
  .filter((e: any) => e.data.locale === locale)
  .sort((a: any, b: any) => a.data.order - b.data.order);

const listUrl = siteConfig.url + "/equipment/";

const collectionSchema = buildCollectionPageSchema({
  name: "Titanium Manufacturing Machines & Equipment",
  description:
    "Comprehensive equipment specification sheets for CNC machining, additive manufacturing, metrology, heat treatment, and surface finishing.",
  url: listUrl,
  numberOfItems: entries.length,
});

const itemListSchema =
  entries.length > 0
    ? buildItemListSchema({
        itemType: "TechArticle",
        numberOfItems: entries.length,
        url: listUrl,
        itemListElement: entries.map((e: any) => ({
          name: e.data.title,
          description: e.data.description,
          url: siteConfig.url + `/equipment/${e.id}/`,
        })),
      })
    : null;

const schemas = [collectionSchema, itemListSchema].filter(
  (s): s is NonNullable<typeof s> => s !== null,
);
---

<EntityPillar
  collectionName="equipment"
  pageTitle="Titanium Manufacturing Machines & Equipment"
  pageDescription="Comprehensive equipment specification sheets for CNC machining, additive manufacturing, metrology, heat treatment, and surface finishing."
  locale={locale}
  path="/equipment/"
  jsonLd={schemas}
>
  <nav slot="hubIntro" class="hub-featured" aria-label="Featured equipment references">
    <h2>Featured Equipment References</h2>
    <ul>
      <li><a href="/equipment/laser-tracker/">Laser Tracker</a> — portable coordinate-measurement system (Leica AT401) for large aerospace assembly verification, with ±15 µm + 10 µm/m accuracy over 60–80 m radius.</li>
      <li><a href="/equipment/mitsubishi-ev3000/">Mitsubishi EV3000 Wire EDM</a> — 5-axis simultaneous wire EDM for thin-wall titanium aerospace and medical-implant features with ±2 µm positioning tolerance.</li>
    </ul>
  </nav>
</EntityPillar>