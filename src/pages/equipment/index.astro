---import EntityPillar from "../_shared/_EntityPillar.astro";import { getCollection } from "astro:content";import { buildCollectionPageSchema, buildItemListSchema } from "../../lib/schema";import { resolveRoute } from "../../i18n/routes";import { siteConfig } from "../../config/site.config";import type { Locale } from "../../lib/site-config";const locale = (Astro.currentLocale || "en") as Locale;const entries = (await getCollection("equipment"))  .filter((e: any) => e.data.locale === locale)  .sort((a: any, b: any) => a.data.order - b.data.order);const listUrl = siteConfig.url + resolveRoute(locale, "/equipment/");const collectionSchema = buildCollectionPageSchema({  name: "Titanium Manufacturing Machines & Equipment",  description: "Comprehensive equipment specification sheets for CNC machining, additive manufacturing, metrology, heat treatment, and surface finishing.",  url: listUrl,  numberOfItems: entries.length,});const itemListSchema = entries.length > 0 ? buildItemListSchema({  itemType: "TechArticle",  numberOfItems: entries.length,  url: listUrl,  itemListElement: entries.map((e: any) => ({    name: e.data.title,    description: e.data.description,    url: siteConfig.url + resolveRoute(locale, "/equipment/" + e.id + "/"),  })),}) : null;const schemas = [collectionSchema, itemListSchema].filter(  (s): s is NonNullable<typeof s> => s !== null,);---<EntityPillar  collectionName="equipment"  pageTitle="Titanium Manufacturing Machines & Equipment"  pageDescription="Comprehensive equipment specification sheets for CNC machining, additive manufacturing, metrology, heat treatment, and surface finishing."  locale={locale}  path="/equipment/"  jsonLd={schemas}/>