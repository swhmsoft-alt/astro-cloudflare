---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { getCollection, render } from "astro:content";
import { siteConfig } from "../../config/site.config";
import { buildKnowledgeArticleGraph } from "../../lib/schema";
import RelatedContent from "../../components/sections/RelatedContent.astro";

export interface Props { slug: string; }
const { slug } = Astro.props as Props;
// EN-only project (2026-08-23): locale is pinned at the boundary.
const locale = "en";
const all = await getCollection("procurement");
const entry = all.find((e: any) => e.id === slug && e.data.locale === locale);
if (!entry) return Astro.redirect("/404");
const data = entry.data as any;
const pageUrl = siteConfig.url + `/procurement/${slug}/`;
const breadcrumbs = [
  { label: "Home", href: siteConfig.url + "/" },
  { label: "Procurement", href: siteConfig.url + "/procurement/" },
  { label: data.title, href: pageUrl },
];

// Build mention URLs for related standards.
const mentionSet = new Set<string>();
(data.relatedStandards ?? []).forEach((s: string) => {
  mentionSet.add(siteConfig.url + `/standards/${s}/`);
});

// Unified `@graph` document for procurement pages.
const pageGraph = buildKnowledgeArticleGraph(
  {
    name: data.title,
    description: data.description,
    url: pageUrl,
    collectionKey: "procurement",
    locale,
    datePublished: entry.data.datePublished ?? undefined,
    dateModified: entry.data.dateModified ?? undefined,
    keywords: [data.procurementCategory, "titanium procurement"].filter(Boolean) as string[],
    breadcrumb: breadcrumbs,
    faqs: Array.isArray(data.faqs) && data.faqs.length > 0 ? data.faqs : undefined,
    mentions: mentionSet.size > 0 ? Array.from(mentionSet) : undefined,
  },
  siteConfig,
);

const { Content } = await render(entry);
---
<MarketingLayout title={data.title} description={data.description} locale={locale} path={`/procurement/${slug}/`} pageGraph={pageGraph} ogType="article">
  <article class="proc-detail container py-16">
    <nav class="proc-bc"><a href="/">Home</a> / <a href="/procurement/">Procurement</a> / <span>{data.title}</span></nav>
    <header class="proc-hdr">
      {data.procurementCategory && <span class="proc-badge">{data.procurementCategory.replace(/-/g, " ")}</span>}
      <h1 class="proc-title">{data.title}</h1>
      <p class="proc-desc">{data.description}</p>
      {data.quickAnswer && (
        <div class="proc-qa"><h2>Quick Answer</h2><p>{data.quickAnswer}</p></div>
      )}
    </header>

    {Array.isArray(data.checklist) && data.checklist.length > 0 && (
      <section class="proc-sec"><h2>Checklist</h2><ul class="proc-list">{data.checklist.map((c: string) => <li>{c}</li>)}</ul></section>
    )}

    {Array.isArray(data.typicalValues) && data.typicalValues.length > 0 && (
      <section class="proc-sec"><h2>Typical Values</h2>
        <table class="proc-table"><thead><tr><th>Item</th><th>Value</th><th>Notes</th></tr></thead>
          <tbody>{data.typicalValues.map((v: any) => (
            <tr><td>{v.label || ""}</td><td>{v.value ?? ""}</td><td>{v.notes || ""}</td></tr>
          ))}</tbody>
        </table>
      </section>
    )}

    <div class="proc-content prose prose-gray dark:prose-invert max-w-none"><Content /></div>

    <footer class="proc-ftr">
      {(Array.isArray(data.relatedServices) && data.relatedServices.length > 0) && (
        <div><h3>Related Services</h3><ul>{data.relatedServices.map((s: string) => <li>{s}</li>)}</ul></div>
      )}
      {(Array.isArray(data.relatedStandards) && data.relatedStandards.length > 0) && (
        <div><h3>Related Standards</h3><ul>{data.relatedStandards.map((s: string) => (
          <li><a href={`/standards/${s}/`}>{s.replace(/-/g, " ").toUpperCase()}</a></li>
        ))}</ul></div>
      )}
    </footer>
    <RelatedContent collectionName="procurement" currentSlug={slug} standards={data.relatedStandards || []} locale={locale} />
  </article>
</MarketingLayout>

<style>
  .proc-bc { font-size: .85rem; color: var(--color-text-secondary); margin-bottom: var(--space-md); } .proc-bc a { color: var(--color-brand-primary); text-decoration: none; }
  .proc-hdr { margin-bottom: var(--space-xl); } .proc-badge { display: inline-block; font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; padding: .2rem .6rem; border-radius: var(--radius-full); background: var(--color-bg-tertiary); color: var(--color-text-secondary); margin-bottom: var(--space-sm); }
  .proc-title { margin: 0 0 var(--space-sm); font-size: clamp(1.75rem, 3vw, 2.5rem); color: var(--color-text-primary); } .proc-desc { margin: 0 0 var(--space-md); color: var(--color-text-secondary); font-size: 1.05rem; line-height: 1.6; }
  .proc-qa { margin-bottom: var(--space-xl); padding: var(--space-lg); border: 1px solid var(--color-brand-primary); border-radius: var(--radius-lg); background: var(--color-bg-secondary); } .proc-qa h2 { margin: 0 0 var(--space-sm); font-size: 1.1rem; color: var(--color-text-primary); } .proc-qa p { margin: 0; color: var(--color-text-secondary); line-height: 1.6; }
  .proc-sec { margin-bottom: var(--space-xl); } .proc-sec h2 { font-size: 1.2rem; color: var(--color-text-primary); margin: 0 0 var(--space-sm); } .proc-list { margin: 0; padding-left: 1.25rem; color: var(--color-text-secondary); line-height: 1.6; }
  .proc-table { width: 100%; border-collapse: collapse; } .proc-table th, .proc-table td { border: 1px solid var(--color-border); padding: .5rem .75rem; font-size: .9rem; text-align: left; } .proc-table th { background: var(--color-bg-tertiary); color: var(--color-text-secondary); }
  .proc-ftr { margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--color-border); } .proc-ftr h3 { margin: 0 0 var(--space-xs); font-size: 1rem; color: var(--color-text-primary); } .proc-ftr ul { list-style: none; margin: 0 0 var(--space-md); padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; } .proc-ftr li a { display: inline-block; padding: .2rem .6rem; border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: .8rem; color: var(--color-text-secondary); text-decoration: none; } .proc-ftr li a:hover { border-color: var(--color-brand-primary); color: var(--color-brand-primary); }
</style>
