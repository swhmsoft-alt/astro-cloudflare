---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../../config/site.config";
import {
  buildEvidenceGraph,
  buildKnowledgeArticleGraph,
  type CollectionSetKey,
} from "../../lib/schema";
import RelatedContent from "../../components/sections/RelatedContent.astro";
import { t } from "../../i18n/ui";

export interface Props {
  collectionName: "materials" | "processes" | "industries" | "standards" | "surfaceFinishes" | "equipment" | "materialSelection" | "failureAnalysis" | "heatTreatment" | "corrosion" | "evidence" | "applications";
  slug: string;
}

const { collectionName, slug } = Astro.props as Props;
// EN-only project (see system/globals/en-only-constraint.md): locale is pinned to "en".
const locale = "en" as const;

const allEntries = await getCollection(collectionName);
const entry = allEntries.find((e: any) => e.id === slug && e.data.locale === locale);

if (!entry) return Astro.redirect("/404");

const data = entry.data as any;
const pillarPath = `/${collectionName === "materials" ? "grades" : collectionName === "surfaceFinishes" ? "finishes" : collectionName === "materialSelection" ? "selection" : collectionName === "failureAnalysis" ? "failures" : collectionName === "heatTreatment" ? "heat-treatment" : collectionName === "corrosion" ? "corrosion" : collectionName}/`;
const pageUrl = siteConfig.url + `${pillarPath}${slug}/`;
// Evidence source model: resolve internal /evidence/* stubs and never emit them.
function resolveEvidenceSource(d: any) {
  const src = (d.source || "").trim();
  const rawUrl = (d.sourceUrl || "").trim();
  if (rawUrl.startsWith("http")) return { text: src, url: rawUrl, type: "EXTERNAL", status: "External source" };
  if (rawUrl.startsWith("/")) return { text: src, url: "", type: "INTERNAL_REFERENCE", status: "Internal reference - external citation pending" };
  if (src) return { text: src, url: "", type: "STANDARD_OR_DOC", status: "Cited (no URL)" };
  return { text: "", url: "", type: "UNKNOWN", status: "Source not stated" };
}
const evSource = collectionName === "evidence" ? resolveEvidenceSource(data) : null;

const breadcrumbCrumbs = [
  { label: "Home", href: siteConfig.url + "/" },
  { label: "Knowledge", href: siteConfig.url + pillarPath },
  { label: data.title, href: pageUrl },
];
// Map collectionName → CollectionSetKey for the DefinedTermSet anchor.
const collectionKey = collectionName as CollectionSetKey;

// Build `mentions` URLs for related entities (internal links become absolute).
const mentionSet = new Set<string>();
function pushMention(relSlug: string | undefined, pillar: string) {
  if (!relSlug) return;
  const slugified = relSlug.toLowerCase().replace(/\s+/g, "-");
  mentionSet.add(siteConfig.url + `/${pillar}/${slugified}/`);
}
if (Array.isArray(data.relatedMaterials)) data.relatedMaterials.forEach((m: string) => pushMention(m, "grades"));
if (Array.isArray(data.relatedProcesses)) data.relatedProcesses.forEach((p: string) => pushMention(p, "processes"));
if (Array.isArray(data.relatedStandards)) data.relatedStandards.forEach((s: string) => pushMention(s, "standards"));
if (Array.isArray(data.relatedIndustries) || Array.isArray(data.industries)) {
  (data.relatedIndustries ?? data.industries ?? []).forEach((i: string) => pushMention(i, "industries"));
}

// JSON-LD strategy (post-refactor):
//   Every knowledge page emits ONE unified `@graph` document via
//   `buildKnowledgeArticleGraph` (or `buildEvidenceGraph` for evidence
//   entries). The graph is self-contained: WebSite + Organization + WebPage
//   + TechArticle + DefinedTerm + DefinedTermSet + BreadcrumbList + (optional)
//   Dataset / FAQPage / CreativeWork all share stable @ids, so Google + AI
//   engines dedupe across the site into one Knowledge Graph node per entity.
//
//   This single graph is passed to MarketingLayout as `pageGraph`, which
//   causes SEO.astro to SKIP emitting its own Organization/WebSite defaults
//   (preventing the duplicate-node issue that affected ~30 pages pre-refactor).
const pageGraph = (() => {
  if (collectionName === "evidence") {
    return buildEvidenceGraph({
      name: data.title,
      description: data.description,
      url: pageUrl,
      collectionSetName: collectionName,
      source: evSource?.text || undefined,
      sourceUrl: evSource?.type === "EXTERNAL" ? evSource.url : undefined,
      dataPoints: Array.isArray(data.dataPoints) ? data.dataPoints : undefined,
      relatedStandards: Array.isArray(data.relatedStandards) ? data.relatedStandards : undefined,
      breadcrumb: breadcrumbCrumbs,
      faqs: Array.isArray(data.faqs) && data.faqs.length > 0 ? data.faqs : undefined,
      locale,
    });
  }

  return buildKnowledgeArticleGraph(
    {
      name: data.title,
      description: data.description,
      url: pageUrl,
      collectionKey,
      locale,
      datePublished: data.datePublished ?? undefined,
      dateModified: data.dateModified ?? undefined,
      authorName: data.authorName ?? undefined,
      keywords: Array.isArray(data.keywords) ? data.keywords : undefined,
      breadcrumb: breadcrumbCrumbs,
      faqs: Array.isArray(data.faqs) && data.faqs.length > 0 ? data.faqs : undefined,
      mentions: mentionSet.size > 0 ? Array.from(mentionSet) : undefined,
    },
    siteConfig,
  );
})();
---
<MarketingLayout title={data.title} description={data.description} locale={locale} path={`${pillarPath}${slug}/`} hreflangLocales={(collectionName === "evidence" || collectionName === "applications") ? ["en"] : undefined} pageGraph={pageGraph} ogType="article">

  <article class="container py-16 entity-article">
    <header class="entity-header">
      <h1 class="entity-title">{data.title}</h1>
      <p class="entity-description">{data.description}</p>
      <div class="entity-meta">
        {'grade' in data && <span class="entity-badge">{data.grade}</span>}
        {'alloy' in data && data.alloy && <span class="entity-badge alloy">{data.alloy}</span>}
        {'processType' in data && <span class="entity-badge">{data.processType}</span>}
        {'standardType' in data && <span class="entity-badge">{data.standardType}</span>}
        {'issuingBody' in data && <span class="entity-badge">{data.issuingBody}</span>}
        {'tolerances' in data && <span class="entity-badge">{data.tolerances}</span>}
        {'evidenceCategory' in data && <span class="entity-badge">{data.evidenceCategory.replace(/-/g, " ")}</span>}
        {'industry' in data && <span class="entity-badge">{data.industry}</span>}
      </div>

      {'properties' in data && data.properties && (
        <table class="props-table">
          <thead><tr><th>Property</th><th>Value</th></tr></thead>
          <tbody>{Object.entries(data.properties).map(([key, val]) => (<tr><td>{key.replace(/([A-Z])/g, ' $1').replace(/^./, s => s.toUpperCase())}</td><td>{val as string}</td></tr>))}</tbody>
        </table>
      )}

      {collectionName === "evidence" && evSource && (
        <div class="ev-source">
          <div class="ev-source__status">{evSource.status}</div>
          {evSource.text && <div class="ev-source__text"><strong>Source:</strong> {evSource.text}</div>}
          {evSource.url && <a class="ev-source__url" href={evSource.url} rel="noopener noreferrer">View source</a>}
        </div>
      )}

      {collectionName === "evidence" && Array.isArray(data.dataPoints) && data.dataPoints.length > 0 && (
        <table class="props-table ev-data">
          <thead><tr><th>Property</th><th>Value</th><th>Unit</th><th>Notes</th></tr></thead>
          <tbody>{data.dataPoints.map((p: any) => (
            <tr><td>{p.property || ""}</td><td>{p.value ?? ""}</td><td>{p.unit || ""}</td><td>{p.notes || ""}</td></tr>
          ))}</tbody>
        </table>
      )}
    </header>

    <div class="entity-content"><slot /></div>
    <div class="entity-related">
      <h2>{t(locale, "knowledge.related")}</h2>
      <div class="related-grid">
        {'standards' in data && data.standards && data.standards.length > 0 && (
          <div class="related-section">
            <h3>Standards</h3>
            <ul>{data.standards.map((s: string) => (
              <li><a href={`/standards/${s.toLowerCase().replace(/\s+/g, "-")}/`}>{s}</a></li>
            ))}</ul>
          </div>
        )}
        {'industries' in data && data.industries && data.industries.length > 0 && (
          <div class="related-section">
            <h3>Industries</h3>
            <ul>{data.industries.map((i: string) => (
              <li><a href={`/industries/${i.toLowerCase().replace(/\s+/g, "-")}/`}>{i}</a></li>
            ))}</ul>
          </div>
        )}
        {collectionName === "evidence" && Array.isArray(data.relatedMaterials) && data.relatedMaterials.length > 0 && (
          <div class="related-section">
            <h3>Related Materials</h3>
            <ul>{data.relatedMaterials.map((m: string) => (
              <li><a href={`/grades/${m}/`}>{m.replace(/-/g, " ")}</a></li>
            ))}</ul>
          </div>
        )}
        {collectionName === "evidence" && Array.isArray(data.relatedProcesses) && data.relatedProcesses.length > 0 && (
          <div class="related-section">
            <h3>Related Processes</h3>
            <ul>{data.relatedProcesses.map((p: string) => (
              <li><a href={`/processes/${p}/`}>{p.replace(/-/g, " ")}</a></li>
            ))}</ul>
          </div>
        )}
        {collectionName === "evidence" && Array.isArray(data.relatedStandards) && data.relatedStandards.length > 0 && (
          <div class="related-section">
            <h3>Related Standards</h3>
            <ul>{data.relatedStandards.map((s: string) => (
              <li><a href={`/standards/${s}/`}>{s.replace(/-/g, " ").toUpperCase()}</a></li>
            ))}</ul>
          </div>
        )}
      </div>
    </div>
    {collectionName === "evidence" && Array.isArray(data.relatedDecisions) && data.relatedDecisions.length > 0 && (
      <div class="related-section">
        <h3>Related Decisions</h3>
        <ul>{data.relatedDecisions.map((d: string) => (
          <li><a href={d}>{d.replace(/^\/|\/$/g, "").split("/").filter(Boolean).pop()!.replace(/-/g, " ")}</a></li>
        ))}</ul>
      </div>
    )}
        <RelatedContent
      collectionName={collectionName}
      currentSlug={slug}
      relatedMaterials={data.materials || data.relatedMaterials || []}
      relatedProcesses={data.processType ? [data.processType] : data.relatedProcesses || []}
      relatedFailures={data.failureType ? [data.failureType] : []}
      standards={data.standards || data.relatedStandards || []}
      applications={data.industries || []}
      locale={locale}
    />
  </article>
</MarketingLayout>

<style>
  .ev-source { margin: var(--space-md) 0; padding: var(--space-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-tertiary); }
  .ev-source__status { display: inline-block; font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; padding: .15rem .5rem; border-radius: var(--radius-full); background: var(--color-bg-primary); color: var(--color-text-secondary); margin-bottom: var(--space-xs); }
  .ev-source__text { font-size: .9rem; color: var(--color-text-secondary); line-height: 1.5; }
  .ev-source__url { display: inline-block; margin-top: var(--space-xs); color: var(--color-brand-primary); font-weight: 600; font-size: .85rem; }
  .ev-data { margin-top: var(--space-md); }
</style>
