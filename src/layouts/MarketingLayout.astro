---
import { ogImagePath } from "../lib/og";
import BaseLayout from "./BaseLayout.astro";
import SEO from "../components/seo/SEO.astro";
import { type Locale } from "../config/site.config";
import { AVAILABILITY } from "../i18n/availability";

export interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  /**
   * Page-specific JSON-LD entries merged alongside site-wide defaults.
   * Typed as `unknown` to accept both schema-dts `WithContext<T>` payloads
   * (which lack a string index signature) and hand-rolled objects. See
   * `JsonLd.astro` for the same rationale.
   */
  jsonLd?: unknown | unknown[];
  /**
   * Page-specific `@graph` JSON-LD document. When provided, this single
   * document REPLACES the site-wide defaults (Organization + WebSite) and
   * should itself contain the necessary site identity nodes so the page
   * does not produce duplicate `@type: Organization` entries.
   *
   * Use `buildKnowledgeArticleGraph` / `buildPillarGraph` from `lib/schema.ts`.
   */
  pageGraph?: Record<string, unknown> & { "@graph": unknown[] };
  /** Open Graph object type ("article" for knowledge articles). */
  ogType?: "website" | "article" | "profile";
  hreflangLocales?: string[];
}

const { title, description, locale, path, jsonLd, pageGraph, ogType } =
  Astro.props as Props;
let { hreflangLocales } = Astro.props as Props;

// ── Derive hreflangLocales from path if not explicitly provided ──
if (!hreflangLocales) {
  const pageId = path.replace(/^\/+|\/+$/g, "") || "index";
  // Try direct lookup, then with "/index" suffix (for /corrosion/ → "corrosion/index")
  hreflangLocales = AVAILABILITY[pageId] || AVAILABILITY[pageId + "/index"] || ["en"];
}
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  path={path}
  showThemeToggle={true}
>
  <SEO
    slot="seo"
    title={title}
    description={description}
    locale={locale}
    path={path}
    ogImage={ogImagePath(path === "/" ? "home" : "page", locale, path === "/" ? "" : path)}
    hreflangLocales={hreflangLocales}
    ogType={ogType}
    pageGraph={pageGraph}
    jsonLd={jsonLd}
  />
  <slot />
</BaseLayout>
