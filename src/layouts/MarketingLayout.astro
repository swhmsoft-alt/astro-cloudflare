---
import BaseLayout from "./BaseLayout.astro";
import SEO from "../components/seo/SEO.astro";
import { type Locale } from "../lib/site-config";

export interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  /** Page-specific JSON-LD entries merged alongside site-wide defaults. */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title, description, locale, path, jsonLd } = Astro.props as Props;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  path={path}
  showThemeToggle={true}
>
  <SEO
    slot="seo"
    title={title}
    description={description}
    locale={locale}
    path={path}
    ogImage={path === "/" ? `/og/home/${locale}` : `/og/page/${locale}${path}`}
    jsonLd={jsonLd}
  />
  <slot />
</BaseLayout>
