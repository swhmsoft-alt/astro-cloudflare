---
import { ogImagePath } from "../lib/og";
import BaseLayout from "./BaseLayout.astro";
import SEO from "../components/seo/SEO.astro";
import { type Locale } from "../lib/site-config";

export interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
}

const {
  title,
  description,
  locale,
  path,
} = Astro.props as Props;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  path={path}
  showThemeToggle={true}
>
  <SEO
    slot="seo"
    title={title}
    description={description}
    locale={locale}
    path={path}
    ogImage={ogImagePath("page", locale, path)}
  />

  <article class="page-layout container py-12">
    <header class="page-layout__hero">
      <h1>{title}</h1>
      <p>{description}</p>
    </header>

    <div class="page-layout__content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .page-layout__hero {
    max-width: 48rem;
    margin-bottom: var(--space-2xl);
  }

  .page-layout__hero h1 {
    margin: 0 0 var(--space-sm);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    line-height: 1.1;
  }

  .page-layout__hero p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 1.125rem;
    line-height: 1.7;
  }
</style>
