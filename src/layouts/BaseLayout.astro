---
import { ogImagePath } from "../lib/og";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Breadcrumb from "../components/layout/Breadcrumb.astro";
import SearchModal from "../components/layout/SearchModal.astro";
import SEO from "../components/seo/SEO.astro";
import Analytics from "../components/layout/Analytics.astro";
import { SITE_CONFIG, type Locale } from "../config/site.config";
import { t } from "../i18n/ui";
import { AVAILABILITY } from "../i18n/availability";
import "../styles/global.css";
// Preload the Latin subset of the heading + body variable fonts so the real
// fonts are ready before first paint — eliminates the swap reflow (CLS).
import outfitLatin from "@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url";
import manropeLatin from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";

export interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  path?: string;
  ogImage?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  showThemeToggle?: boolean;
  /** Page-specific `@graph` JSON-LD document. */
  pageGraph?: Record<string, unknown> & { "@graph": unknown[] };
  /** Open Graph object type ("article" for knowledge articles). */
  ogType?: "website" | "article" | "profile";
  /**
   * Legacy per-node JSON-LD blobs. Typed as `unknown` to accept both
   * schema-dts `WithContext<T>` payloads (which lack a string index
   * signature) and hand-rolled objects. See `JsonLd.astro` for the same
   * rationale.
   */
  jsonLd?: unknown | unknown[];
  /** Disable the inline BreadcrumbList JSON-LD (when the page already emits it inside its `@graph`). */
  emitBreadcrumbJsonLd?: boolean;
}

// For i18n routing, prefer path from Astro.currentRoute
const { currentLocale, ...restProps } = Astro.props as Props & {
  currentLocale?: Locale;
};

const {
  title,
  description = SITE_CONFIG.description,
  locale = currentLocale || SITE_CONFIG.defaultLocale,
  path = "/",
  ogImage,
  showHeader = true,
  showFooter = true,
  showThemeToggle = true,
  pageGraph,
  ogType,
  jsonLd,
  emitBreadcrumbJsonLd,
} = restProps;

function defaultOgImage(routePath: string) {
  if (routePath === "/") return ogImagePath("home", locale, "/");
  if (routePath === "/blog") return ogImagePath("blog-list", locale, "/blog");
  if (routePath.startsWith("/blog/"))
    return ogImagePath("blog", locale, "/" + routePath.slice("/blog/".length));
  if (routePath === "/services") return ogImagePath("services-list", locale, "/services");
  if (routePath.startsWith("/services/"))
    return ogImagePath("service", locale, "/" + routePath.slice("/services/".length));
  return ogImagePath("page", locale, routePath);
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload primary fonts (Latin) to prevent layout shift from font swap -->
    <link
      rel="preload"
      href={outfitLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={manropeLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Dark mode bootstrap (prevents FOUC) -->
    <script is:inline>
      function applyTheme() {
        try {
          // Honor the main-site key first, then Starlight's key (so a choice made
          // in the /docs section carries over), then the OS preference.
          const stored =
            localStorage.getItem("theme") ||
            localStorage.getItem("starlight-theme");
          if (stored === "dark") {
            document.documentElement.classList.add("dark");
            return;
          }
          if (
            (!stored || stored === "auto") &&
            window.matchMedia("(prefers-color-scheme: dark)").matches
          ) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {
          console.warn("dark mode:", e);
        }
      }
      applyTheme();
    </script>

    {
      Astro.slots.has("seo") ? (
        <slot name="seo" />
      ) : (
        <SEO
          title={title}
          description={description}
          locale={locale}
          path={path}
          ogImage={ogImage ?? defaultOgImage(path)}
          hreflangLocales={
            AVAILABILITY[path.replace(/^\/+|\/+$/g, "") || "index"] ||
            AVAILABILITY[(path.replace(/^\/+|\/+$/g, "") || "index") + "/index"] ||
            ["en"]
          }
          ogType={ogType}
          pageGraph={pageGraph}
          jsonLd={jsonLd}
        />
      )
    }

    <!-- Security headers stub — enforced at edge / server level -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main-content" class="skip-link">
      {t(locale, "aria.skipToContent")}
    </a>

    {
      showHeader && (
        <Header
          currentLocale={locale}
          currentPath={path}
          showThemeToggle={showThemeToggle}
        />
      )
    }

    <SearchModal locale={locale} />

    <Breadcrumb emitJsonLd={emitBreadcrumbJsonLd !== false ? (pageGraph ? false : true) : false} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    {Astro.slots.has("analytics") ? <slot name="analytics" /> : <Analytics />}

    {showFooter && <Footer currentLocale={locale} />}
  </body>
</html>
