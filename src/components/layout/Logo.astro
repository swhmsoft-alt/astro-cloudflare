---
import { siteConfig } from "../../config/site.config";
export interface Props {
  href?: string;
}

const { href = "/" } = Astro.props as Props;
---

<a href={href} class="logo" aria-label={siteConfig.name}>
  <img
    class="logo__img logo__img--light"
    src={siteConfig.branding.logo.light}
    alt={siteConfig.name}
    width="180"
    height="45"
    loading="eager"
    decoding="async"
  />
  <img
    class="logo__img logo__img--dark"
    src={siteConfig.branding.logo.dark}
    alt={siteConfig.name}
    width="180"
    height="45"
    loading="eager"
    decoding="async"
  />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  .logo:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .logo__img {
    display: block;
    height: 2.25rem;
    width: auto;
  }

  .logo__img--dark {
    display: none;
  }

  :global(.dark) .logo__img--light {
    display: none;
  }

  :global(.dark) .logo__img--dark {
    display: block;
  }

  @media (max-width: 26rem) {
    .logo__img {
      height: 1.75rem;
    }
  }
</style>
