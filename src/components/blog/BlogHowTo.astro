---
import JsonLd from "../seo/JsonLd.astro";
import { t } from "../../i18n/ui";
import type { Locale } from "../../lib/site-config";

export interface Props {
  steps: Array<{
    name: string;
    text: string;
    image?: string;
    url?: string;
  }>;
  title?: string;
  locale?: Locale;
}

const { steps, title, locale = "en" } = Astro.props as Props;
const heading = title ?? t(locale, "blog.howTo");

const schema = steps.length
  ? {
      "@context": "https://schema.org",
      "@type": "HowTo",
      name: heading,
      step: steps.map((step, i) => ({
        "@type": "HowToStep",
        position: i + 1,
        name: step.name,
        text: step.text,
      })),
    }
  : null;
---

{ schema && <JsonLd schema={schema} /> }

<section class="blog-howto">
  <h2 class="blog-howto__title">{heading}</h2>

  <ol class="blog-howto__list">
    {steps.map((step, i) => (
      <li class="blog-howto__step">
        <div class="blog-howto__step-header">
          <span class="blog-howto__step-number">{t(locale, "blog.step")} {i + 1}</span>
          <h3 class="blog-howto__step-name">{step.name}</h3>
        </div>
        <p class="blog-howto__step-text">{step.text}</p>
        {
          step.url && (
            <a
              href={step.url}
              class="blog-howto__step-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t(locale, "blog.learnMore")}
            </a>
          )
        }
      </li>
    ))}
  </ol>
</section>

<style>
  .blog-howto {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .blog-howto__title {
    margin: 0 0 var(--space-lg);
    font-size: clamp(1.5rem, 2.5vw, 1.875rem);
    letter-spacing: -0.01em;
  }

  .blog-howto__list {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: howto-step;
  }

  .blog-howto__step {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    padding: var(--space-lg);
  }

  .blog-howto__step-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .blog-howto__step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    background: var(--color-text-primary);
    color: var(--color-bg-primary);
    font-size: 0.8125rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .blog-howto__step-name {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .blog-howto__step-text {
    margin: 0 0 0 calc(2rem + var(--space-sm));
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .blog-howto__step-link {
    display: inline-block;
    margin-top: var(--space-sm);
    margin-left: calc(2rem + var(--space-sm));
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-brand-primary);
    text-decoration: none;
  }

  .blog-howto__step-link:hover {
    text-decoration: underline;
  }
</style>