---
import { type SiteConfig } from "../../config/site.config";
import {
  canonicalUrl,
  ogMeta,
} from "../../lib/seo";
import { siteConfig } from "../../config/site.config";
import JsonLd from "./JsonLd.astro";
import {
  buildWebSiteSchema,
  buildOrganizationSchema,
  graphContainsSiteWide,
} from "../../lib/schema";

export interface SEOArticle {
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
}

export interface Props {
  title: string;
  description?: string;
  /**
   * @deprecated EN-only project (2026-08-23). `locale` is accepted for
   *   back-compat but no longer affects output. `og:locale` is always `en`.
   */
  locale?: string;
  path: string;
  ogImage?: string;
  canonical?: string;
  /**
   * @deprecated EN-only project (2026-08-23). Previously controlled which
   *   `<link rel="alternate" hreflang="...">` entries to emit. No longer
   *   rendered; ignored.
   */
  hreflangLocales?: string[];
  article?: SEOArticle;
  /**
   * Open Graph object type. Defaults to "website". Pass "article" for
   * knowledge articles (TechArticle / DefinedTerm pages) so social cards
   * reflect the correct schema.
   */
  ogType?: "website" | "article" | "profile";
  /**
   * Page-specific `@graph` JSON-LD document. When provided, this single
   * document REPLACES the site-wide defaults (Organization + WebSite) and
   * should itself contain the necessary site identity nodes so the page
   * does not produce duplicate `@type: Organization` entries.
   *
   * Use {@link import("../../lib/schema").buildKnowledgeArticleGraph} or
   * {@link import("../../lib/schema").buildPillarGraph} to construct it.
   */
  pageGraph?: Record<string, unknown> & { "@graph": unknown[] };
  /**
   * @deprecated Prefer `pageGraph` (a single `@graph` document). Legacy
   * per-node JSON-LD blobs passed here are still emitted as separate
   * `<script>` tags alongside site-wide defaults for backwards
   * compatibility, but pages that supply a `pageGraph` should drop this.
   *
   * Typed as `unknown` to accept schema-dts `WithContext<T>` payloads (which
   * lack a string index signature) and hand-rolled objects. The component
   * only serialises the value via `JSON.stringify`, so `unknown` is safe.
   */
  jsonLd?: unknown | unknown[];
}

const {
  title,
  description = siteConfig.description,
  path,
  ogImage,
  canonical,
  article,
  ogType,
  pageGraph,
  jsonLd,
} = Astro.props as Props;

const effectiveLocale = "en"; // EN-only pin

const fullTitle = title.includes(siteConfig.name)
  ? title
  : `${title} | ${siteConfig.name}`;
const canonicalHref = canonical ?? canonicalUrl(effectiveLocale, path);
const og = ogMeta({
  title: fullTitle,
  description,
  path,
  image: ogImage,
  ogType,
});
const verification = siteConfig.verification;

// ── JSON-LD: unified `@graph` document ──
// If the page supplied a `pageGraph`, emit ONLY that graph (no site-wide
// defaults). Otherwise fall back to the legacy behavior (Organization +
// WebSite + any per-node `jsonLd` blobs).
let emitPageGraph: Record<string, unknown> | null = null;
let emitLegacySchemas: unknown[] = [];
if (pageGraph) {
  emitPageGraph = pageGraph;
} else {
  // For legacy callers, check whether the supplied `jsonLd` blob already
  // contains site-wide identity nodes (rare, but supported) so we can
  // dedupe them.
  const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
  const { hasOrg, hasWebSite } = graphContainsSiteWide(
    { "@graph": jsonLdArray } as Record<string, unknown>,
    siteConfig as unknown as SiteConfig,
  );
  // Legacy path: emit Organization + WebSite, plus page-specific entries.
  emitLegacySchemas = [
    ...(hasOrg ? [] : [buildOrganizationSchema(siteConfig as unknown as SiteConfig, effectiveLocale)]),
    ...(hasWebSite ? [] : [buildWebSiteSchema(siteConfig as unknown as SiteConfig, effectiveLocale)]),
  ];
  if (jsonLd) {
    emitLegacySchemas.push(...jsonLdArray);
  }
}
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalHref} />

{
  verification.google && (
    <meta name="google-site-verification" content={verification.google} />
  )
}
{verification.bing && <meta name="msvalidate.01" content={verification.bing} />}

{
  Object.entries(og).map(([property, content]) => (
    <meta property={property} content={content} />
  ))
}

{
  article?.publishedTime && (
    <meta property="article:published_time" content={article.publishedTime} />
  )
}
{
  article?.modifiedTime && (
    <meta property="article:modified_time" content={article.modifiedTime} />
  )
}
{article?.author && <meta property="article:author" content={article.author} />}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

{emitPageGraph && <JsonLd schema={emitPageGraph} />}
{emitLegacySchemas.map((entry) => <JsonLd schema={entry} />)}
